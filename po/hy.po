#: src/optima_air/codec.py
#, python-brace-format
msgid "a 28-bit sum takes 4 bytes, got {got}"
msgstr "28-բիթանոց գումարը զբաղեցնում է 4 բայթ, ստացվել է {got}"

#: src/optima_air/codec.py
#, python-brace-format
