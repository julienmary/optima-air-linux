msgstr "শেষ ব্লক: ফ্ল্যাগ, যোগফল ও কাউন্টারের বাইরে বাড়তি বাইট"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unreadable end sum: {error}"
msgstr "শেষ যোগফল পড়া যাচ্ছে না: {error}"

#: src/optima_air/messages_reception.py
