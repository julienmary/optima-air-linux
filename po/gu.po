msgid "unreadable slot info: {error}"
msgstr "સ્લોટની માહિતી વાંચી શકાતી નથી: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "the pedal announces slot {slot}"
msgstr "પેડલ સ્લોટ {slot} જાહેર કરે છે"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected answer for table {table}: {error}"
msgstr "ટેબલ {table} માટે અણધાર્યો જવાબ: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "table {table}: value {value} above 100"
msgstr "ટેબલ {table}: મૂલ્ય {value} 100 થી વધુ છે"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected state answer: {error}"
msgstr "સ્થિતિનો અણધાર્યો જવાબ: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "read header: command {found} instead of {expected}"
msgstr "વાંચન હેડર: {expected} ને બદલે આદેશ {found}"

#: src/optima_air/messages_reception.py
msgid "read header carries the end flag"
msgstr "વાંચન હેડરમાં અંતનો ફ્લેગ છે"

#: src/optima_air/messages_reception.py
msgid "non-zero read header, never seen in this form"
msgstr "બિન-શૂન્ય વાંચન હેડર, આ સ્વરૂપમાં ક્યારેય જોવા મળ્યું નથી"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: command {found} instead of {expected}"
msgstr "બ્લૉક {block}: {expected} ને બદલે આદેશ {found}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: non-zero flag {flag}"
msgstr "બ્લૉક {block}: બિન-શૂન્ય ફ્લેગ {flag}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: address {found} instead of {expected}"
msgstr "બ્લૉક {block}: {expected} ને બદલે સરનામું {found}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: counter {found} instead of {expected}"
msgstr "બ્લૉક {block}: {expected} ને બદલે કાઉન્ટર {found}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block} unreadable: {error}"
msgstr "બ્લૉક {block} વાંચી શકાતો નથી: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: command {found} instead of {expected}"
msgstr "અંતિમ બ્લૉક: {expected} ને બદલે આદેશ {found}"

#: src/optima_air/messages_reception.py
msgid "end block without flag"
msgstr "અંતિમ બ્લૉકમાં ફ્લેગ નથી"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: counter {found} instead of {expected}"
msgstr "અંતિમ બ્લૉક: {expected} ને બદલે કાઉન્ટર {found}"

#: src/optima_air/messages_reception.py
msgid "end block: stray byte outside the flag, the sum and the counter"
msgstr "અંતિમ બ્લૉક: ફ્લેગ, સરવાળા અને કાઉન્ટરની બહાર વધારાનો બાઇટ"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unreadable end sum: {error}"
msgstr "અંતિમ સરવાળો વાંચી શકાતો નથી: {error}"

#: src/optima_air/messages_reception.py
msgid "wrong end-of-read sum"
msgstr "વાંચનના અંતનો સરવાળો ખોટો"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "footer: command {found} instead of {expected}"
msgstr "ફૂટર: {expected} ને બદલે આદેશ {found}"

#: src/optima_air/messages_reception.py
msgid "footer without flag"
msgstr "ફૂટરમાં ફ્લેગ નથી"

#: src/optima_air/messages_reception.py
msgid "footer: stray byte after the flag"
msgstr "ફૂટર: ફ્લેગ પછી વધારાનો બાઇટ"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "{count} messages received instead of {expected}"
msgstr "{expected} ને બદલે {count} સંદેશ મળ્યા"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "message {number} foreign to an IR read: {error}"
msgstr "સંદેશ {number} IR વાંચન સાથે અસંબંધિત છે: {error}"

#: src/optima_air/preferences.py
msgid "colour {colour!r}: lowercase “#rrggbb” expected"
msgstr "રંગ {colour!r}: નાના અક્ષરોમાં “#rrggbb” અપેક્ષિત"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unknown function “{name}”. Known: {known}."
msgstr "અજ્ઞાત ફંક્શન “{name}”. જાણીતા: {known}."

#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "જાણીતા ફંક્શનની ક્રમબદ્ધ યાદી, પુનરાવર્તન વિના, અપેક્ષિત"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "પ્રાયોગિક રજિસ્ટર વાંચી શકાતું નથી: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "પ્રાયોગિક રજિસ્ટર બીજી પ્રક્રિયા દ્વારા લૉક કરાયેલું છે ({file}): બીજો આદેશ પૂરો થાય ત્યારે ફરી પ્રયાસ કરો."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "{file} લૉક કરી શકાતી નથી: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "પેડલ મળ્યું નથી: કોઈ “NAI5” સાઉન્ડ કાર્ડ નથી. USB કેબલ તપાસો."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR સેટ નથી: લૉક લઈ શકાતો નથી."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "લૉક {file} લઈ શકાતો નથી: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "પેડલનો ઉપયોગ પહેલેથી optima-air નો બીજો ઇન્સ્ટન્સ કરી રહ્યો છે."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "લૉક પહેલેથી છોડી દેવાયો છે: હવે તે કોઈ પોર્ટને આપી શકાતો નથી."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "આ લૉક પહેલેથી એક પોર્ટનો છે: તે બીજા પોર્ટને આપી શકાતો નથી."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "લૉક છોડી શકાતો નથી: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "પેડલ હવે જવાબ આપતું નથી: પ્લગ નીકળી ગયું છે અથવા અટકી ગયું છે."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "પોર્ટ {port} કન્ફિગર કરી શકાતો નથી: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "પોર્ટ {port} નું ઇનપુટ સક્રિય કરી શકાતું નથી: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "પોર્ટ {port} અસ્તિત્વમાં નથી."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port} ની ઍક્સેસ નામંજૂર. તપાસો કે તમે “audio” ગ્રુપમાં છો (આદેશ: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "પોર્ટ {port} નો ઉપયોગ પહેલેથી બીજો પ્રોગ્રામ કરી રહ્યો છે."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "પોર્ટ {port} હવે ઉપલબ્ધ નથી."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "પોર્ટ {port} ખોલી શકાતો નથી: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "લખી શકાતું નથી: પોર્ટ બંધ છે."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "પોર્ટ {port} પર લખવાનું નિષ્ફળ ગયું: કોઈ બાઇટ સ્વીકારાયો નથી."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "પોર્ટ {port} પર લખવાનું નિષ્ફળ ગયું: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "પોર્ટ {port} ને ડ્રેઇન કરવાનું સતત {count} વાર અટક્યું: સંદેશ કર્નલને સોંપી દેવાયો છે, પરંતુ તેના રવાના થવાની રાહ જોઈ શકાઈ નથી."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "રાહ મર્યાદાની બહાર: {wait} સેકન્ડ (વધુમાં વધુ {max} સેકન્ડ)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "વાંચી શકાતું નથી: પોર્ટ બંધ છે."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "પોર્ટ {port} પરથી વાંચવાનું નિષ્ફળ ગયું: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "પોર્ટ {port} તેના ઇનપુટની સ્થિતિ જણાવતો નથી ({error}): બાઇટ ગુમાવવાનું શોધી શકાતું નથી, અહીં જ અટકીએ છીએ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "પોર્ટ {port} ની સ્થિતિ વાંચવાનું નિષ્ફળ ગયું: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "પોર્ટ {port} બંધ કરવાનું નિષ્ફળ ગયું: {error}"
