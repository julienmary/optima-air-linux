#: src/optima_air/device.py
#, python-brace-format
msgid "Unknown firmware {found} (protocol verified on {verified}): only reads are allowed."
msgstr "Անհայտ որոնիչ {found} (արձանագրությունը հաստատված է {verified}-ի վրա): թույլատրվում են միայն ընթերցումները։"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}” is a trial function (“{function}”), not yet validated on the pedal."
msgstr "«{message}»-ը փորձնական գործառույթ է («{function}»), պեդալի վրա դեռ չհաստատված։"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: only a read can be sent again."
