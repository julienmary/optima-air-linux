#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "పోర్ట్ {port}కు వ్రాయడం విఫలమైంది: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "పోర్ట్ {port}ను డ్రెయిన్ చేయడం వరుసగా {count} సార్లు అంతరాయం పొందింది: సందేశం కెర్నల్‌కు అప్పగించబడింది, కానీ దాని నిష్క్రమణ కోసం వేచి ఉండడం సాధ్యం కాలేదు."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
