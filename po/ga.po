#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Níl an calafort {port} ann."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Rochtain diúltaithe do {port}. Seiceáil go bhfuil tú sa ghrúpa “audio” (ordú: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Tá an calafort {port} in úsáid cheana ag clár eile."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Níl an calafort {port} ar fáil a thuilleadh."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Ní féidir an calafort {port} a oscailt: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Ní féidir scríobh: tá an calafort dúnta."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Theip ar scríobh chuig calafort {port}: níor glacadh le beart ar bith."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Theip ar scríobh chuig calafort {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Cuireadh isteach ar fholmhú an chalafoirt {port} {count} uair as a chéile: tá an teachtaireacht tugtha don eithne, ach níorbh fhéidir fanacht lena himeacht."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Fanacht lasmuigh den raon: {wait} s (uasmhéid {max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Ní féidir léamh: tá an calafort dúnta."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Theip ar léamh ó chalafort {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Ní thuairiscíonn an calafort {port} staid a ionchuir ({error}): ní féidir cailliúint bearta a bhrath, stopann sé anseo."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Theip ar staid an chalafoirt {port} a léamh: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Theip ar an gcalafort {port} a dhúnadh: {error}"
