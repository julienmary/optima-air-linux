#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "పోర్ట్ {port} ఇన్‌పుట్‌ను సిద్ధం చేయడం సాధ్యం కాదు: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "పోర్ట్ {port} లేదు."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port}కు ప్రాప్యత నిరాకరించబడింది. మీరు “audio” గ్రూప్‌లో ఉన్నారో తనిఖీ చేయండి (కమాండ్: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
