msgstr "මුලින් නිවේදනය යවන්න (පරීක්ෂණාත්මක)"

#: src/optima_air/cli.py
msgid "write a WAV into a slot"
msgstr "ස්ලොට් එකකට WAV ලියන්න"

#: src/optima_air/cli.py
msgid "WAV file"
msgstr "WAV ගොනුව"

#: src/optima_air/cli.py
msgid "name of the slot (default: the name of the file)"
msgstr "ස්ලොට් එකේ නම (පෙරනිමිය: ගොනුවේ නම)"

#: src/optima_air/cli.py
msgid "export a slot as WAV"
msgstr "ස්ලොට් එකක් WAV ලෙස අපනයනය කරන්න"

#: src/optima_air/cli.py
msgid "WAV file to write"
msgstr "ලිවිය යුතු WAV ගොනුව"

#: src/optima_air/cli.py
msgid "rewrite a slot, or all of them, from a backup"
msgstr "උපස්ථයකින් ස්ලොට් එකක් හෝ සියල්ල නැවත ලියන්න"

#: src/optima_air/cli.py
msgid "backup folder"
msgstr "උපස්ථ ෆෝල්ඩරය"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count} (default: all)"
msgstr "ස්ලොට් අංකය, 1 සිට {count} දක්වා (පෙරනිමිය: සියල්ල)"

#: src/optima_air/cli.py
msgid "replace the backed up name"
msgstr "උපස්ථ කළ නම ප්‍රතිස්ථාපනය කරන්න"

#: src/optima_air/cli.py
msgid "back up the 23 slots"
msgstr "ස්ලොට් 23 ම උපස්ථ කරන්න"

#: src/optima_air/cli.py
msgid "list the backups"
msgstr "උපස්ථ ලැයිස්තුගත කරන්න"

#: src/optima_air/cli.py
msgid "check an interrupted write"
msgstr "බාධා වූ ලිවීමක් පරීක්ෂා කරන්න"

#: src/optima_air/cli.py
msgid "register of the trial functions"
msgstr "පරීක්ෂණාත්මක ශ්‍රිතවල ලේඛනය"

#: src/optima_air/cli.py
#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "ස්ලොට් {slot} වෙත ලිවීම අසම්පූර්ණව ඉතිරි විය. පෙඩලය ටික වේලාවක් තනිව තබනු ලැබේ; පසුව ධාවනය කරන්න: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "දෝෂය: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "බාධා විය."

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "බයිට {byte} බිට් 7 න් පිටත"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "7-බිට් බයිට {count} ක් පුරවුම් බිට් {bits} ක් ඉතිරි කරයි, enc7 කිසිවිටෙක 6 ට වඩා නිපදවන්නේ නැත"

#: src/optima_air/codec.py
msgid "non-zero padding bits at the end of a 7-bit stream"
msgstr "7-බිට් ප්‍රවාහයක අවසානයේ ශුන්‍ය නොවන පුරවුම් බිට්"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "බ්ලොක් එකක් බයිට {expected} කි, {got} ලැබුණා"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "බ්ලොක් එකතුව {sum} ({hex}) සම්ප්‍රේෂණය කරන බිට් 14 ඉක්මවයි (උපරිම {max}): පෙඩලයේ කිසිවිටෙක දැක නැත, සත්‍යාපනය කරන තුරු ප්‍රතික්ෂේප කෙරේ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "කේතනය කළ බ්ලොක් එකක් බයිට {expected} කි, {got} ලැබුණා"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "කේතනය කළ බ්ලොක් එකක බිට් 7 න් පිටත බයිටයක්"

#: src/optima_air/codec.py
msgid "wrong block checksum"
msgstr "වැරදි බ්ලොක් චෙක්සම්"

#: src/optima_air/codec.py
msgid "the end-of-transfer sum covers at least one block"
msgstr "සම්ප්‍රේෂණ අවසන් එකතුව අවම වශයෙන් එක් බ්ලොක් එකක් ආවරණය කරයි"

#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
msgstr "දිග {length} යනු {block} හි ගුණාකාරයක් නොවේ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "value {value} outside 28 bits"
msgstr "අගය {value} බිට් 28 න් පිටත"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a 28-bit sum takes 4 bytes, got {got}"
msgstr "බිට් 28 ක එකතුවක් බයිට 4 ක් ගනී, {got} ලැබුණා"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits in a 28-bit sum"
msgstr "බිට් 28 ක එකතුවක බිට් 7 න් පිටත බයිට {byte}"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write was interrupted: the pedal is left alone for another {seconds} s."
msgstr "ලිවීමක් බාධා විය: පෙඩලය තවත් තත්පර {seconds} ක් තනිව තබනු ලැබේ."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: a write message can only be sent by a complete slot write (backup, journal, read back)."
msgstr "“{message}”: ලිවීමේ පණිවිඩයක් යැවිය හැක්කේ සම්පූර්ණ ස්ලොට් ලිවීමකට (උපස්ථය, ජර්නලය, නැවත කියවීම) පමණි."

#: src/optima_air/device.py
msgid "The firmware version has not been read yet: only reads are allowed."
msgstr "ෆර්ම්වෙයාර් අනුවාදය තවම කියවා නැත: කියවීම් පමණක් අවසර ඇත."

#: src/optima_air/device.py
#, python-brace-format
msgid "Unknown firmware {found} (protocol verified on {verified}): only reads are allowed."
msgstr "නොදන්නා ෆර්ම්වෙයාර් {found} (ප්‍රොටෝකෝලය {verified} හි සත්‍යාපනය කර ඇත): කියවීම් පමණක් අවසර ඇත."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}” is a trial function (“{function}”), not yet validated on the pedal."
msgstr "“{message}” යනු පරීක්ෂණාත්මක ශ්‍රිතයකි (“{function}”), පෙඩලය මත තවම වලංගු කර නැත."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: only a read can be sent again."
msgstr "“{message}”: නැවත යැවිය හැක්කේ කියවීමක් පමණි."

#: src/optima_air/device.py
#, python-brace-format
msgid "No answer from the pedal to “{message}” after {count} attempts."
msgstr "“{message}” සඳහා උත්සාහ {count} කට පසුවත් පෙඩලයෙන් පිළිතුරක් නැත."

#: src/optima_air/device.py
msgid "The pedal keeps sending SysEx without a break."
msgstr "පෙඩලය විරාමයකින් තොරව SysEx යවමින් සිටී."

#: src/optima_air/device.py
#, python-brace-format
msgid "Cannot read slot {slot}: {error}"
msgstr "ස්ලොට් {slot} කියවිය නොහැක: {error}"

#: src/optima_air/device.py
#, python-brace-format
msgid "Two reads of slot {slot} give different data."
msgstr "ස්ලොට් {slot} හි කියවීම් දෙකක් වෙනස් දත්ත ලබා දෙයි."

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: wait another {seconds} s before sending anything."
msgstr "ස්ලොට් {slot} වෙත ලිවීම බාධා විය: කිසිවක් යැවීමට පෙර තවත් තත්පර {seconds} ක් රැඳී සිටින්න."

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: until that slot is put right, it is the only one that can be written."
msgstr "ස්ලොට් {slot} වෙත ලිවීම බාධා විය: එම ස්ලොට් එක නිවැරදි කරන තුරු, ලිවිය හැකි එකම ස්ලොට් එක එයයි."

#: src/optima_air/device.py
msgid "Write refused: the firmware has not been read, or is not the one the protocol was verified on."
msgstr "ලිවීම ප්‍රතික්ෂේප කරන ලදී: ෆර්ම්වෙයාර් කියවා නැත, නැතහොත් ප්‍රොටෝකෝලය සත්‍යාපනය කළ ෆර්ම්වෙයාර් එක නොවේ."

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, slot {slot} does not hold what was sent."
msgstr "ලිවීමෙන් පසු, ස්ලොට් {slot} යැවූ දේ නොදරයි."

#: src/optima_air/device.py
msgid "The pedal reports an error while writing the IR."
msgstr "IR ලිවීමේදී පෙඩලය දෝෂයක් වාර්තා කරයි."

#: src/optima_air/device.py
#, python-brace-format
msgid "Unexpected block acknowledgement: {status}."
msgstr "බලාපොරොත්තු නොවූ බ්ලොක් පිළිගැනීම: {status}."

#: src/optima_air/device.py
#, python-brace-format
msgid "{count} block acknowledgement received instead of {expected}."
msgid_plural "{count} block acknowledgements received instead of {expected}."
msgstr[0] "{expected} වෙනුවට බ්ලොක් පිළිගැනීම් {count} ක් ලැබුණා."
msgstr[1] "{expected} වෙනුවට බ්ලොක් පිළිගැනීම් {count} ක් ලැබුණා."

#: src/optima_air/device.py
msgid "Header and footer acknowledgements missing or unexpected."
msgstr "ශීර්ෂ සහ පාදක පිළිගැනීම් නැත, නැතහොත් බලාපොරොත්තු නොවූ ඒවා වේ."

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, the name echo came {count} time instead of once."
msgid_plural "After the write, the name echo came {count} times instead of once."
msgstr[0] "ලිවීමෙන් පසු, නමේ ප්‍රතිරාවය එක් වරක් වෙනුවට {count} වරක් පැමිණියේය."
msgstr[1] "ලිවීමෙන් පසු, නමේ ප්‍රතිරාවය එක් වරක් වෙනුවට {count} වරක් පැමිණියේය."

#: src/optima_air/device.py
msgid "After the write, the name echo does not match what was sent."
msgstr "ලිවීමෙන් පසු, නමේ ප්‍රතිරාවය යැවූ දේ සමඟ නොගැලපේ."

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, the slot info came {count} time instead of once."
msgid_plural "After the write, the slot info came {count} times instead of once."
msgstr[0] "ලිවීමෙන් පසු, ස්ලොට් තොරතුරු එක් වරක් වෙනුවට {count} වරක් පැමිණියේය."
