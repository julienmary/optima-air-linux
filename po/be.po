msgid "block {block}: non-zero flag {flag}"
msgstr "блок {block}: ненулявы сцяг {flag}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: address {found} instead of {expected}"
msgstr "блок {block}: адрас {found} замест {expected}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: counter {found} instead of {expected}"
msgstr "блок {block}: лічыльнік {found} замест {expected}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block} unreadable: {error}"
msgstr "блок {block} нечытэльны: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: command {found} instead of {expected}"
msgstr "завяршальны блок: каманда {found} замест {expected}"

#: src/optima_air/messages_reception.py
msgid "end block without flag"
msgstr "завяршальны блок без сцяга"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: counter {found} instead of {expected}"
msgstr "завяршальны блок: лічыльнік {found} замест {expected}"

#: src/optima_air/messages_reception.py
msgid "end block: stray byte outside the flag, the sum and the counter"
msgstr "завяршальны блок: лішні байт па-за сцягам, сумай і лічыльнікам"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unreadable end sum: {error}"
msgstr "нечытэльная канцавая сума: {error}"

#: src/optima_air/messages_reception.py
msgid "wrong end-of-read sum"
msgstr "няправільная сума канца чытання"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "footer: command {found} instead of {expected}"
msgstr "завяршэнне: каманда {found} замест {expected}"

#: src/optima_air/messages_reception.py
msgid "footer without flag"
msgstr "завяршэнне без сцяга"

#: src/optima_air/messages_reception.py
msgid "footer: stray byte after the flag"
msgstr "завяршэнне: лішні байт пасля сцяга"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "{count} messages received instead of {expected}"
msgstr "атрымана {count} паведамленняў замест {expected}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "message {number} foreign to an IR read: {error}"
msgstr "паведамленне {number} не мае дачынення да чытання IR: {error}"

#: src/optima_air/preferences.py
msgid "colour {colour!r}: lowercase “#rrggbb” expected"
msgstr "колер {colour!r}: чакаецца «#rrggbb» малымі літарамі"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unknown function “{name}”. Known: {known}."
msgstr "Невядомая функцыя «{name}». Вядомыя: {known}."

#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "чакаецца адсартаваны спіс вядомых функцый без паўтораў"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "Нечытэльны рэестр выпрабаванняў: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "Рэестр выпрабаванняў заблакіраваны іншым працэсам ({file}): паспрабуйце яшчэ раз, калі іншая каманда завершыцца."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "Не ўдалося заблакіраваць {file}: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "Педаль не знойдзена: няма гукавой карты «NAI5». Праверце кабель USB."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR не ўстаноўлена: немагчыма атрымаць блакіроўку."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "Не ўдалося атрымаць блакіроўку {file}: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "Педаль ужо выкарыстоўваецца іншым экзэмплярам optima-air."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "Блакіроўка ўжо вызваленая: яе больш нельга перадаць порту."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Гэтая блакіроўка ўжо належыць порту: яе нельга перадаць другому."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Не ўдалося вызваліць блакіроўку: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Педаль больш не адказвае: адключана або завісла."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "Не ўдалося наладзіць порт {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "Не ўдалося актываваць уваход порта {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Порт {port} не існуе."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Доступ да {port} забаронены. Праверце, ці ўваходзіце вы ў групу «audio» (каманда: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Порт {port} ужо выкарыстоўваецца іншай праграмай."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Порт {port} больш недаступны."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Не ўдалося адкрыць порт {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Немагчыма запісаць: порт закрыты."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Запіс у порт {port} не ўдаўся: ніводнага байта не прынята."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Запіс у порт {port} не ўдаўся: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Апаражненне порта {port} было перапынена {count} разоў запар: паведамленне перададзена ядру, але яго адпраўку дачакацца не ўдалося."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Чаканне па-за дыяпазонам: {wait} с (не больш за {max} с)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Немагчыма прачытаць: порт закрыты."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Чытанне з порта {port} не ўдалося: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Порт {port} не паведамляе стан свайго ўваходу ({error}): страту байтаў выявіць немагчыма, спыняемся."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Чытанне стану порта {port} не ўдалося: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Закрыццё порта {port} не ўдалося: {error}"
