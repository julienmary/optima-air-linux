msgid "date {date!r} without time zone"
msgstr "កាលបរិច្ឆេទ {date!r} គ្មានល្វែងម៉ោង"

#: src/optima_air/archives.py
msgid "non-canonical date {date!r}"
msgstr "កាលបរិច្ឆេទ {date!r} មិនមានទម្រង់ស្តង់ដារ"

