msgid "Cannot arm the input of port {port}: {error}"
msgstr "Methu paratoi mewnbwn y porth {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Nid yw’r porth {port} yn bodoli."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Gwrthodwyd mynediad i {port}. Gwiriwch eich bod yn y grŵp “audio” (gorchymyn: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Mae’r porth {port} eisoes yn cael ei ddefnyddio gan raglen arall."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Nid yw’r porth {port} ar gael mwyach."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Methu agor y porth {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Methu ysgrifennu: mae’r porth ar gau."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Methodd ysgrifennu i borth {port}: ni dderbyniwyd yr un beit."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Methodd ysgrifennu i borth {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Torrwyd ar draws gwagio’r porth {port} {count} gwaith yn olynol: mae’r neges wedi’i throsglwyddo i’r cnewyllyn, ond ni ellid aros iddi adael."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Arhosiad y tu allan i’r ystod: {wait} s (uchafswm {max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Methu darllen: mae’r porth ar gau."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Methodd darllen o’r porth {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Nid yw’r porth {port} yn adrodd cyflwr ei fewnbwn ({error}): ni ellir canfod colli beitiau, stopio yma."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Methodd darllen cyflwr y porth {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Methodd cau’r porth {port}: {error}"
