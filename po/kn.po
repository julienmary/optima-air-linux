msgstr "ಸ್ಲಾಟ್ ವ್ಯಾಪ್ತಿಯ ಹೊರಗಿದೆ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone expected"
msgstr "{field}: ಸಮಯ ವಲಯದೊಂದಿಗೆ ISO ದಿನಾಂಕ ನಿರೀಕ್ಷಿಸಲಾಗಿತ್ತು"

#: src/optima_air/journal.py
#, python-brace-format
