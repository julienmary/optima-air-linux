#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Restore finished. Slots rewritten and read back identical: {rewritten}. Settings only: {settings}. Already identical to the backup: {unchanged}."
msgstr "སླར་གསོ་མཇུག་འགྲིལ། ཡང་བསྐྱར་བྲིས་ཏེ་ཀློག་པས་གཅིག་མཚུངས་ཡིན་པ་རྙེད་པའི་ slot: {rewritten}། སྒྲིག་འགོད་ཁོ་ན་: {settings}། གྲབས་ཉར་དང་གཅིག་མཚུངས་ཡིན་ཟིན་པ་: {unchanged}།"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it still holds what it held before. Nothing to do."
msgstr "slot {slot}: བར་ཆད་ཆགས་པའི་འབྲི་བའི་རྗེས་ལའང་དེའི་ནང་དོན་སྔར་བཞིན་ཡིན། བྱ་རྒྱུ་མེད།"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it holds neither the old nor the new content. Until it is put right, it is the only slot that can be written."
msgstr "slot {slot}: བར་ཆད་ཆགས་པའི་འབྲི་བའི་རྗེས་ལ་དེའི་ནང་དོན་ནི་རྙིང་པ་དང་གསར་པ་གང་ཡང་མིན། ཡང་དག་མ་བཟོས་གོང་ལ་ slot དེ་ཁོ་ན་འབྲི་ཐུབ།"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: {name}"
msgstr "slot {slot}: {name}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical. Previous content backed up in {backup}"
msgstr "slot {slot}: “{name}” བྲིས་ཏེ་ཡང་བསྐྱར་ཀློག་པས་གཅིག་མཚུངས་ཡིན་པ་རྙེད་སོང་། སྔར་གྱི་ནང་དོན་ {backup} ནང་གྲབས་ཉར་བྱས་སོང་།"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot}…"
msgstr "slot {slot} ལ་འབྲི་བཞིན་པ…"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot} failed: {reason} The pedal is left alone for {seconds} s, then the state of the slot will be checked."
msgstr "slot {slot} ལ་འབྲི་བ་ཕམ་སོང་། {reason} རྐང་མནན་ལ་སྐར་ཆ་ {seconds} ཡིན་གྱི་བར་ལག་འཇུག་མི་བྱེད། དེ་རྗེས་ slot གི་གནས་སྟངས་ཞིབ་བཤེར་བྱེད།"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The backup failed: {reason}"
msgstr "གྲབས་ཉར་ཕམ་སོང་། {reason}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The restore stopped: {reason} The slots already handled are in order; the state of the pedal will be read again."
msgstr "སླར་གསོ་བཞག་སོང་། {reason} ཐག་གཅོད་ཟིན་པའི་ slot རྣམས་ཡང་དག་ཡིན་ཞིང་། རྐང་མནན་གྱི་གནས་སྟངས་ཡང་བསྐྱར་ཀློག་གི།"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Connected, firmware {version}"
msgstr "སྦྲེལ་ཟིན། firmware {version}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Disconnected: {reason}"
msgstr "སྦྲེལ་མཐུད་ཆད་སོང་། {reason}"

#: src/optima_air/gui/fenetre.py
msgid "Warning: the identifier announced by the pedal does not match the data read."
msgstr "ཉེན་བརྡ། རྐང་མནན་གྱིས་གསལ་བསྒྲགས་བྱས་པའི་ངོས་འཛིན་ཨང་དང་ཀློག་པའི་གནས་ཚུལ་མི་མཐུན།"

#: src/optima_air/gui/travail.py
msgid "Stop requested."
msgstr "མཚམས་འཇོག་རེ་བ་བྱས་སོང་།"

#: src/optima_air/gui/travail.py
msgid "Backup"
msgstr "གྲབས་ཉར།"

#: src/optima_air/ir.py
msgid "invalid frequency range or number of points"
msgstr "ཐེངས་གྲངས་ཀྱི་ཁྱབ་ཁོངས་སམ་ས་ཚིགས་ཀྱི་གྲངས་ནོར་བ།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Unreadable audio file: {file} ({error})"
msgstr "སྒྲ་ཡིག་ཆ་ཀློག་མི་ཐུབ། {file} ({error})"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file has {count} channels: only the first one is kept."
msgstr "ཡིག་ཆའི་ནང་བགྲོད་ལམ་ {count} ཡོད། དང་པོ་ཁོ་ན་ཉར།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Empty audio file: {file}"
msgstr "སྒྲ་ཡིག་ཆ་སྟོང་པ། {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file contains non-finite samples: {file}"
msgstr "ཡིག་ཆའི་ནང་མཐའ་ཚད་ཡོད་པའི་དཔེ་ཚད་མིན་པ་ཡོད། {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Sample rate of {rate} Hz: the file was resampled to {target} kHz."
msgstr "དཔེ་ཚད་ཀྱི་མྱུར་ཚད་ {rate} Hz། ཡིག་ཆ་དེ་ {target} kHz ལ་བསྐྱར་དཔེ་ཚད་བྱས་སོང་།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file lasts {duration} ms: only the first {count} samples ({limit} ms) are kept."
msgstr "ཡིག་ཆའི་རིང་ཚད་ {duration} ms ཡིན། དང་པོའི་དཔེ་ཚད་ {count} ({limit} ms) ཁོ་ན་ཉར།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The pedal only plays the first {count} samples ({limit} ms): the rest of this IR will be stored but not heard."
msgstr "རྐང་མནན་གྱིས་དང་པོའི་དཔེ་ཚད་ {count} ({limit} ms) ཁོ་ན་གཏོང་། IR འདིའི་ལྷག་མ་ཉར་ཡང་མི་ཉན།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Cannot normalise {file}: no signal between 400 Hz and 3 kHz."
msgstr "{file} ཚད་སྙོམས་བྱེད་མི་ཐུབ། 400 Hz དང་ 3 kHz གི་བར་ལ་བརྡ་རྟགས་མེད།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Normalising {file} exceeds the range of floating-point numbers."
msgstr "{file} ཚད་སྙོམས་བྱས་ན་ཚེག་གྲངས་འཁོར་བའི་ཁྱབ་ཁོངས་ལས་ཐལ་འདས།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "After normalisation, the IR peaks at {peak} (usual IRs stay below 10): the file has a very deep dip between 400 Hz and 3 kHz, and the output level may be very high."
msgstr "ཚད་སྙོམས་བྱས་རྗེས་ IR གི་རྩེ་མོ་ {peak} ཡིན། (རྒྱུན་ལྡན་གྱི་ IR རྣམས་ 10 ལས་དམའ།) ཡིག་ཆའི་ 400 Hz དང་ 3 kHz གི་བར་ལ་གཟིགས་ཆེན་ཟབ་མོ་ཡོད་པས་ཕྱིར་འདྲེན་གྱི་ཆུ་ཚད་ཧ་ཅང་མཐོ་སྲིད།"

#: src/optima_air/journal.py
