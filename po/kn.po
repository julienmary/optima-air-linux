#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: a write message can only be sent by a complete slot write (backup, journal, read back)."
msgstr "“{message}”: ಬರೆಯುವ ಸಂದೇಶವನ್ನು ಸಂಪೂರ್ಣ ಸ್ಲಾಟ್ ಬರವಣಿಗೆಯ (ಬ್ಯಾಕಪ್, ಜರ್ನಲ್, ಮತ್ತೆ ಓದುವುದು) ಮೂಲಕ ಮಾತ್ರ ಕಳುಹಿಸಬಹುದು."

#: src/optima_air/device.py
msgid "The firmware version has not been read yet: only reads are allowed."
msgstr "ಫರ್ಮ್‌ವೇರ್ ಆವೃತ್ತಿಯನ್ನು ಇನ್ನೂ ಓದಿಲ್ಲ: ಓದುವುದು ಮಾತ್ರ ಅನುಮತಿಸಲಾಗಿದೆ."

#: src/optima_air/device.py
#, python-brace-format
msgid "Unknown firmware {found} (protocol verified on {verified}): only reads are allowed."
msgstr "ಅಜ್ಞಾತ ಫರ್ಮ್‌ವೇರ್ {found} (ಪ್ರೋಟೋಕಾಲ್ ಅನ್ನು {verified} ನಲ್ಲಿ ಪರಿಶೀಲಿಸಲಾಗಿದೆ): ಓದುವುದು ಮಾತ್ರ ಅನುಮತಿಸಲಾಗಿದೆ."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}” is a trial function (“{function}”), not yet validated on the pedal."
msgstr "“{message}” ಒಂದು ಪ್ರಾಯೋಗಿಕ ಕಾರ್ಯ (“{function}”), ಪೆಡಲ್‌ನಲ್ಲಿ ಇನ್ನೂ ಮಾನ್ಯೀಕರಿಸಲಾಗಿಲ್ಲ."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: only a read can be sent again."
msgstr "“{message}”: ಓದುವುದನ್ನು ಮಾತ್ರ ಮತ್ತೆ ಕಳುಹಿಸಬಹುದು."

#: src/optima_air/device.py
#, python-brace-format
msgid "No answer from the pedal to “{message}” after {count} attempts."
msgstr "“{message}” ಗೆ {count} ಪ್ರಯತ್ನಗಳ ನಂತರವೂ ಪೆಡಲ್‌ನಿಂದ ಉತ್ತರವಿಲ್ಲ."

