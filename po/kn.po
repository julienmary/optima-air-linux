msgstr "{field}: ಸಮಯ ವಲಯದೊಂದಿಗೆ ISO ದಿನಾಂಕ, ಅಥವಾ null, ನಿರೀಕ್ಷಿಸಲಾಗಿತ್ತು"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: backup folder name expected"
msgstr "{field}: ಬ್ಯಾಕಪ್ ಫೋಲ್ಡರ್ ಹೆಸರು ನಿರೀಕ್ಷಿಸಲಾಗಿತ್ತು"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 64 hexadecimal digits expected"
msgstr "{field}: 64 ಹೆಕ್ಸಾಡೆಸಿಮಲ್ ಅಂಕೆಗಳು ನಿರೀಕ್ಷಿಸಲಾಗಿತ್ತು"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 32 bytes in hexadecimal expected"
msgstr "{field}: ಹೆಕ್ಸಾಡೆಸಿಮಲ್‌ನಲ್ಲಿ 32 ಬೈಟ್‌ಗಳು ನಿರೀಕ್ಷಿಸಲಾಗಿತ್ತು"

#: src/optima_air/journal.py
msgid "identifier out of range"
msgstr "ಗುರುತು ವ್ಯಾಪ್ತಿಯ ಹೊರಗಿದೆ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: boolean expected"
msgstr "{field}: ಬೂಲಿಯನ್ ನಿರೀಕ್ಷಿಸಲಾಗಿತ್ತು"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Unreadable write journal: {file} ({error})"
msgstr "ಓದಲಾಗದ ಬರವಣಿಗೆ ಜರ್ನಲ್: {file} ({error})"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Cannot remove the journal {file}: {error}"
msgstr "ಜರ್ನಲ್ {file} ಅನ್ನು ತೆಗೆದುಹಾಕಲು ಸಾಧ್ಯವಿಲ್ಲ: {error}"

#: src/optima_air/messages_emission.py
