msgstr "རྒྱབ་ཉར་འབད་མི་མིང་ཚབ་བཙུགས།"

#: src/optima_air/cli.py
msgid "back up the 23 slots"
msgstr "སློཊ་ 23 རྒྱབ་ཉར་འབད།"

#: src/optima_air/cli.py
msgid "list the backups"
msgstr "རྒྱབ་ཉར་ཚུ་ཐོ་བཀོད།"

#: src/optima_air/cli.py
msgid "check an interrupted write"
msgstr "བར་ཆད་ཐོན་པའི་འབྲི་ནི་ལྟ་ཞིབ་འབད།"

#: src/optima_air/cli.py
msgid "register of the trial functions"
msgstr "ཚོད་ལྟའི་ལས་འགན་ཚུའི་དེབ་ཐོ།"

#: src/optima_air/cli.py
#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "སློཊ་ {slot} ལུ་ འབྲི་ནི་ཚར་མ་སོངས་པར་ལུས་ཡོད། པེ་ཌལ་འདི་ དུས་ཡུན་ཚད་ཅིག་ རྐྱངམ་ཅིག་བཞག་འོང་། དེ་ལས་ གཡོག་བཀོལ་: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "ནོར་འཁྲུལ་: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "བར་ཆད་ཐོན་ཅི།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "བཱའིཊ་ {byte} འདི་ བིཊ་ 7 གི་ཕྱི་ཁར་ཨིན།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "བིཊ་ 7 གི་བཱའིཊ་ {count} གིས་ བིཊ་བཀང་ {bits} ལུས་སྡོད་དོ། enc7 གིས་ 6 ལས་ལྷག་པ་ཅིག་ ནམ་ཡང་མི་བཟོ།"

#: src/optima_air/codec.py
msgid "non-zero padding bits at the end of a 7-bit stream"
msgstr "བིཊ་ 7 གི་རྒྱུན་རིམ་གྱི་མཇུག་ལུ་ ཀླད་ཀོར་མེན་པའི་བིཊ་བཀང་།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "སྡེབ་ཚན་ཅིག་ནི་ བཱའིཊ་ {expected} ཨིན་པ་ད་ {got} ཐོབ་ཅི།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "སྡེབ་ཚན་བསོམས་ {sum} ({hex}) འདི་ བརྒྱུད་སྐུར་འབད་མི་བིཊ་ 14 ལས་བརྒལ་ཡོད (ཆེ་ཤོས་ {max}): པེ་ཌལ་གུ་ ནམ་ཡང་མ་མཐོང་། བདེན་དཔྱད་མ་འབད་ཚུན་ བཀག་ཡོད།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "ཨིན་ཀོཌ་འབད་མི་སྡེབ་ཚན་ཅིག་ནི་ བཱའིཊ་ {expected} ཨིན་པ་ད་ {got} ཐོབ་ཅི།"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "ཨིན་ཀོཌ་འབད་མི་སྡེབ་ཚན་ནང་ བིཊ་ 7 གི་ཕྱི་ཁའི་བཱའིཊ།"

#: src/optima_air/codec.py
msgid "wrong block checksum"
msgstr "སྡེབ་ཚན་གྱི་ཞིབ་དཔྱད་བསོམས་ནོར་ཡོད།"

#: src/optima_air/codec.py
msgid "the end-of-transfer sum covers at least one block"
msgstr "སྤོ་བཤུད་མཇུག་གི་བསོམས་འདི་ སྡེབ་ཚན་གཅིག་ཉུང་མཐའ་ ཚུད་དོ།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
msgstr "ཚད་ {length} འདི་ {block} གི་འགྱུར་གྲངས་མེན།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "value {value} outside 28 bits"
msgstr "གྲངས་ཐང་ {value} འདི་ བིཊ་ 28 གི་ཕྱི་ཁར་ཨིན།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a 28-bit sum takes 4 bytes, got {got}"
msgstr "བིཊ་ 28 གི་བསོམས་ཅིག་གིས་ བཱའིཊ་ 4 ལེན་པ་ད་ {got} ཐོབ་ཅི།"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits in a 28-bit sum"
msgstr "བིཊ་ 28 གི་བསོམས་ནང་ བཱའིཊ་ {byte} འདི་ བིཊ་ 7 གི་ཕྱི་ཁར་ཨིན།"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write was interrupted: the pedal is left alone for another {seconds} s."
msgstr "འབྲི་ནི་ཅིག་ལུ་ བར་ཆད་ཐོན་ཅི། པེ་ཌལ་འདི་ སྐར་ཆ་ {seconds} ལྷག་དོན་ལུ་ རྐྱངམ་ཅིག་བཞག་འོང་།"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: a write message can only be sent by a complete slot write (backup, journal, read back)."
msgstr "“{message}”: འབྲི་ནིའི་འཕྲིན་དོན་འདི་ སློཊ་འབྲི་ནི་ཆ་ཚང་ (རྒྱབ་ཉར་ ཉིན་ཐོ་ ལོག་ཀློག) གིས་རྐྱངམ་ཅིག་ བཏང་ཚུགས།"

#: src/optima_air/device.py
msgid "The firmware version has not been read yet: only reads are allowed."
msgstr "ཕཱམ་ཝེར་ཐོན་རིམ་འདི་ ད་ལྟོ་ཚུན་ མ་ཀློག་པས། ཀློག་ནི་རྐྱངམ་ཅིག་ ཆོག་ཐམ་ཡོད།"

#: src/optima_air/device.py
#, python-brace-format
msgid "Unknown firmware {found} (protocol verified on {verified}): only reads are allowed."
msgstr "ཕཱམ་ཝེར་ {found} ངོ་མ་ཤེསཔ (ཐབས་ལམ་འདི་ {verified} གུ་ བདེན་དཔྱད་འབད་ཡི): ཀློག་ནི་རྐྱངམ་ཅིག་ ཆོག་ཐམ་ཡོད།"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}” is a trial function (“{function}”), not yet validated on the pedal."
msgstr "“{message}” འདི་ ཚོད་ལྟའི་ལས་འགན་ (“{function}”) ཨིན། པེ་ཌལ་གུ་ ད་ལྟོ་ཚུན་ བདེན་དཔྱད་མ་འབད་བས།"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: only a read can be sent again."
msgstr "“{message}”: ཀློག་ནི་རྐྱངམ་ཅིག་ ལོག་བཏང་ཚུགས།"

#: src/optima_air/device.py
#, python-brace-format
msgid "No answer from the pedal to “{message}” after {count} attempts."
msgstr "“{message}” གི་དོན་ལུ་ འབད་རྩོལ་ {count} འབད་ཞིནམ་ལས་ཡང་ པེ་ཌལ་ལས་ ལན་མེདཔ།"

#: src/optima_air/device.py
msgid "The pedal keeps sending SysEx without a break."
msgstr "པེ་ཌལ་གྱིས་ བར་མེད་པར་ SysEx གཏང་སྡོད་དོ།"

#: src/optima_air/device.py
#, python-brace-format
msgid "Cannot read slot {slot}: {error}"
msgstr "སློཊ་ {slot} ཀློག་མ་ཚུགས: {error}"

#: src/optima_air/device.py
#, python-brace-format
msgid "Two reads of slot {slot} give different data."
msgstr "སློཊ་ {slot} གི་ཀློག་ནི་གཉིས་ཀྱིས་ གཞི་གྲངས་མ་འདྲཝ་སྤྲོད་དོ།"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: wait another {seconds} s before sending anything."
msgstr "སློཊ་ {slot} ལུ་ འབྲི་ནི་ བར་ཆད་ཐོན་ཅི། ག་ཅི་བཏང་ནི་གི་ཧེ་མར་ སྐར་ཆ་ {seconds} ལྷག་དོན་ལུ་ སྒུག།"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: until that slot is put right, it is the only one that can be written."
msgstr "སློཊ་ {slot} ལུ་ འབྲི་ནི་ བར་ཆད་ཐོན་ཅི། སློཊ་དེ་ ཐབས་ཚུལ་མ་བསྒྲིགས་ཚུན་ འབྲི་ཚུགས་མི་འདི་ ཁོ་རྐྱངམ་ཅིག་ཨིན།"

#: src/optima_air/device.py
msgid "Write refused: the firmware has not been read, or is not the one the protocol was verified on."
msgstr "འབྲི་ནི་བཀག་ཅི། ཕཱམ་ཝེར་ མ་ཀློག་པ་ ཡང་ན་ ཐབས་ལམ་བདེན་དཔྱད་འབད་མི་ཕཱམ་ཝེར་མེན།"

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, slot {slot} does not hold what was sent."
msgstr "འབྲི་ཚར་བའི་ཤུལ་ལུ་ སློཊ་ {slot} ནང་ བཏང་མི་ཚུ་མེདཔ།"

#: src/optima_air/device.py
msgid "The pedal reports an error while writing the IR."
msgstr "IR འབྲི་བའི་སྐབས་ པེ་ཌལ་གྱིས་ ནོར་འཁྲུལ་ཅིག་སྙན་ཞུ་འབདཝ་ཨིན།"

#: src/optima_air/device.py
#, python-brace-format
msgid "Unexpected block acknowledgement: {status}."
msgstr "རེ་མཚམས་མེད་པའི་སྡེབ་ཚན་ངོས་ལེན་: {status}།"

#: src/optima_air/device.py
#, python-brace-format
msgid "{count} block acknowledgement received instead of {expected}."
msgid_plural "{count} block acknowledgements received instead of {expected}."
msgstr[0] "{expected} གི་ཚབ་ལུ་ སྡེབ་ཚན་ངོས་ལེན་ {count} ཐོབ་ཅི།"

#: src/optima_air/device.py
msgid "Header and footer acknowledgements missing or unexpected."
msgstr "མགོ་ཡིག་དང་ མཇུག་ཡིག་གི་ངོས་ལེན་ཚུ་ མེདཔ་ ཡང་ན་ རེ་མཚམས་མེདཔ།"

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, the name echo came {count} time instead of once."
msgid_plural "After the write, the name echo came {count} times instead of once."
msgstr[0] "འབྲི་ཚར་བའི་ཤུལ་ལུ་ མིང་གི་སྒྲ་ག་ཡོ་འདི་ ཚར་གཅིག་གི་ཚབ་ལུ་ ཚར་ {count} འབྱུང་ཅི།"

#: src/optima_air/device.py
msgid "After the write, the name echo does not match what was sent."
msgstr "འབྲི་ཚར་བའི་ཤུལ་ལུ་ མིང་གི་སྒྲ་ག་ཡོ་འདི་ བཏང་མི་དང་ མི་མཐུན།"

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, the slot info came {count} time instead of once."
msgid_plural "After the write, the slot info came {count} times instead of once."
msgstr[0] "འབྲི་ཚར་བའི་ཤུལ་ལུ་ སློཊ་གྱི་ཆ་འཕྲིན་འདི་ ཚར་གཅིག་གི་ཚབ་ལུ་ ཚར་ {count} འབྱུང་ཅི།"

#: src/optima_air/device.py
msgid "After the write, the slot info does not match what was sent."
msgstr "འབྲི་ཚར་བའི་ཤུལ་ལུ་ སློཊ་གྱི་ཆ་འཕྲིན་འདི་ བཏང་མི་དང་ མི་མཐུན།"

#: src/optima_air/device.py
#, python-brace-format
msgid "The backup {backup} holds no slot."
msgstr "རྒྱབ་ཉར་ {backup} ནང་ སློཊ་མེདཔ།"

#: src/optima_air/device.py
msgid "Comparing"
msgstr "ག་བསྡུར་འབད་དོ"

#: src/optima_air/device.py
#, python-brace-format
msgid "Slot {slot} of the backup {backup} differs from the pedal but cannot be rewritten as it is ({error}). Nothing was written."
msgstr "རྒྱབ་ཉར་ {backup} གི་སློཊ་ {slot} འདི་ པེ་ཌལ་ལས་ཁྱད་པར་ཨིན་རུང་ ད་ལྟོ་ཡོད་མི་བཟུམ་སྦེ་ ལོག་འབྲི་མ་ཚུགས ({error})། ཅི་ཡང་འབྲི་མ་སོངས།"

#: src/optima_air/device.py
msgid "Restoring"
msgstr "སླར་གསོ་འབད་དོ"

#: src/optima_air/device.py
#, python-brace-format
msgid "The pedal announces slot {announced} after slot {requested} was requested."
msgstr "སློཊ་ {requested} ལུ་ རེ་བ་བརྒྱབ་ཞིནམ་ལས་ པེ་ཌལ་གྱིས་ སློཊ་ {announced} གསལ་བསྒྲགས་འབདཝ་ཨིན།"

#: src/optima_air/device.py
#, python-brace-format
msgid "No echo from the pedal to the write of table {table}."
msgstr "ཐིག་ཤོག་ {table} འབྲི་ནི་ལུ་ པེ་ཌལ་ལས་ སྒྲ་ག་ཡོ་མ་འབྱུང་།"

#: src/optima_air/device.py
#, python-brace-format
msgid "The echo of table {table} differs from what was sent."
msgstr "ཐིག་ཤོག་ {table} གི་སྒྲ་ག་ཡོ་འདི་ བཏང་མི་ལས་ཁྱད་པར་ཨིན།"

#: src/optima_air/disque.py src/optima_air/transport.py
msgid "is a symbolic link"
msgstr "ཐུག་མཐུད་རྟགས་ཅན་ཨིན།"

