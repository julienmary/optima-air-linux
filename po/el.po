#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "Το μητρώο δοκιμών είναι κλειδωμένο από άλλη διεργασία ({file}): δοκιμάστε ξανά όταν τελειώσει η άλλη εντολή."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "Αδυναμία κλειδώματος του {file}: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "Το πεντάλ δεν βρέθηκε: καμία κάρτα ήχου «NAI5». Ελέγξτε το καλώδιο USB."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "Η XDG_RUNTIME_DIR δεν έχει οριστεί: δεν είναι δυνατή η λήψη του κλειδώματος."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "Αδυναμία λήψης του κλειδώματος {file}: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "Το πεντάλ χρησιμοποιείται ήδη από άλλο στιγμιότυπο του optima-air."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "Το κλείδωμα έχει ήδη απελευθερωθεί: δεν μπορεί πια να δοθεί σε θύρα."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Αυτό το κλείδωμα ανήκει ήδη σε θύρα: δεν μπορεί να δοθεί σε δεύτερη."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Αδυναμία απελευθέρωσης του κλειδώματος: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Το πεντάλ δεν απαντά πια: αποσυνδεδεμένο ή κολλημένο."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "Αδυναμία ρύθμισης της θύρας {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "Αδυναμία οπλισμού της εισόδου της θύρας {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Η θύρα {port} δεν υπάρχει."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Άρνηση πρόσβασης στο {port}. Ελέγξτε ότι ανήκετε στην ομάδα «audio» (εντολή: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Η θύρα {port} χρησιμοποιείται ήδη από άλλο πρόγραμμα."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Η θύρα {port} δεν είναι πια διαθέσιμη."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Αδυναμία ανοίγματος της θύρας {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Αδυναμία εγγραφής: η θύρα είναι κλειστή."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Η εγγραφή στη θύρα {port} απέτυχε: δεν έγινε δεκτό κανένα byte."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Η εγγραφή στη θύρα {port} απέτυχε: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Η εκκαθάριση της θύρας {port} διακόπηκε {count} φορές στη σειρά: το μήνυμα έχει παραδοθεί στον πυρήνα, αλλά δεν ήταν δυνατή η αναμονή της αναχώρησής του."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Αναμονή εκτός εύρους: {wait} s (το πολύ {max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Αδυναμία ανάγνωσης: η θύρα είναι κλειστή."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Η ανάγνωση από τη θύρα {port} απέτυχε: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Η θύρα {port} δεν αναφέρει την κατάσταση της εισόδου της ({error}): η απώλεια byte δεν μπορεί να ανιχνευθεί, διακοπή εδώ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Η ανάγνωση της κατάστασης της θύρας {port} απέτυχε: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Το κλείσιμο της θύρας {port} απέτυχε: {error}"
