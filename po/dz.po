msgid "The pedal is already used by another instance of optima-air."
msgstr "པེ་ཌལ་འདི་ optima-air གི་དཔེ་གཞན་ཅིག་གིས་ ཧེ་མ་ལས་ལག་ལེན་འཐབ་དོ།"

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "ཟྭ་འདི་ ཧེ་མ་ལས་བཏོན་ཚར་ཡི། ད་ཚུན་ ཕོརྟ་ལུ་སྤྲོད་མི་ཚུགས།"

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "ཟྭ་འདི་ ཧེ་མ་ལས་ཕོརྟ་ཅིག་གི་ཨིན། གཉིས་པ་ལུ་སྤྲོད་མི་ཚུགས།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "ཟྭ་བཏོན་མ་ཚུགས: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "པེ་ཌལ་གྱིས་ ད་ལས་ལན་མི་སྤྲོད། ཕྱིར་བཏོན་འབད་ཡོདཔ་ ཡང་ན་ བརྒྱབ་ཡོདཔ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "ཕོརྟ་ {port} རིམ་སྒྲིག་འབད་མ་ཚུགས: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "ཕོརྟ་ {port} གི་ནང་འཇུག་གྲ་སྒྲིག་འབད་མ་ཚུགས: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "ཕོརྟ་ {port} མེདཔ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port} ལུ་ འཛུལ་ཞུགས་བཀག་ཅི། “audio” ཚོགས་པའི་ནང་ཡོད་མེད་ལྟ་ཞིབ་འབད (བརྡ་བཀོད་: id)།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "ཕོརྟ་ {port} འདི་ གོ་རིམ་གཞན་ཅིག་གིས་ ཧེ་མ་ལས་ལག་ལེན་འཐབ་དོ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "ཕོརྟ་ {port} འདི་ ད་ལས་ཐོབ་མི་ཚུགས།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "ཕོརྟ་ {port} ཁ་ཕྱེ་མ་ཚུགས: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "འབྲི་མ་ཚུགས: ཕོརྟ་ཁ་བསྡམས་ཡོད།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "ཕོརྟ་ {port} ལུ་ འབྲི་ནི་འཐུས་ཤོར་ཅི: བཱའིཊ་གཅིག་ཡང་ངོས་མ་ལེན།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "ཕོརྟ་ {port} ལུ་ འབྲི་ནི་འཐུས་ཤོར་ཅི: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "ཕོརྟ་ {port} སྟོངམ་བཏང་ནི་ལུ་ རྒྱུན་མཐུད་ཐེངས་ {count} བར་ཆད་ཐོན་ཅི། འཕྲིན་དོན་འདི་ ཀར་ནཱལ་ལུ་སྤྲོད་ཡོད་རུང་ ཁོང་གི་ཕྱིར་འགྲོ་ནི་ལུ་ སྒུག་མི་ཚུགས་པས།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "སྒུག་ནི་ཁྱབ་ཚད་ཀྱི་ཕྱི་ཁར་: སྐར་ཆ་ {wait} (ཆེ་ཤོས་ སྐར་ཆ་ {max})།"

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "ཀློག་མ་ཚུགས: ཕོརྟ་ཁ་བསྡམས་ཡོད།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "ཕོརྟ་ {port} ལས་ ཀློག་ནི་འཐུས་ཤོར་ཅི: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "ཕོརྟ་ {port} གིས་ ཁོ་གི་ནང་འཇུག་གི་གནས་སྟངས་ སྙན་ཞུ་མི་འབད ({error}): བཱའིཊ་ཤོར་བ་ ཤེས་ཚུགས་མི་ཚུགས། འདི་ལུ་མཚམས་བཞག་དོ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "ཕོརྟ་ {port} གི་གནས་སྟངས་ཀློག་ནི་འཐུས་ཤོར་ཅི: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "ཕོརྟ་ {port} ཁ་བསྡམས་ནི་འཐུས་ཤོར་ཅི: {error}"
