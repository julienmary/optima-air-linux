#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "போர்ட் {port} ஐ வடிகட்டுவது தொடர்ந்து {count} முறை இடைமறிக்கப்பட்டது: செய்தி கர்னலிடம் ஒப்படைக்கப்பட்டது, ஆனால் அதன் புறப்பாட்டுக்காகக் காத்திருக்க இயலவில்லை."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "காத்திருப்பு வரம்புக்கு வெளியே: {wait} வி (அதிகபட்சம் {max} வி)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "படிக்க இயலவில்லை: போர்ட் மூடப்பட்டுள்ளது."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "போர்ட் {port} இலிருந்து படிப்பது தோல்வியடைந்தது: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "போர்ட் {port} அதன் உள்ளீட்டின் நிலையைத் தெரிவிக்கவில்லை ({error}): பைட் இழப்பைக் கண்டறிய இயலாது, இங்கே நிறுத்துகிறது."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "போர்ட் {port} இன் நிலையைப் படிப்பது தோல்வியடைந்தது: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "போர்ட் {port} ஐ மூடுவது தோல்வியடைந்தது: {error}"
