#: src/optima_air/messages_reception.py
msgid "footer: stray byte after the flag"
msgstr "кінцівка: зайвий байт після прапорця"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "{count} messages received instead of {expected}"
msgstr "отримано повідомлень: {count} замість {expected}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "message {number} foreign to an IR read: {error}"
msgstr "повідомлення {number} чуже для читання IR: {error}"

#: src/optima_air/preferences.py
msgid "colour {colour!r}: lowercase “#rrggbb” expected"
msgstr "колір {colour!r}: очікується запис у нижньому регістрі «#rrggbb»"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unknown function “{name}”. Known: {known}."
msgstr "Невідома функція «{name}». Відомі: {known}."

#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "очікується відсортований список відомих функцій без дублікатів"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "Нечитабельний реєстр пробних функцій: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "Реєстр пробних функцій заблоковано іншим процесом ({file}): спробуйте ще раз, коли інша команда завершиться."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "Не вдалося заблокувати {file}: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "Педаль не знайдено: немає звукової карти «NAI5». Перевірте кабель USB."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR не задано: неможливо взяти блокування."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "Не вдалося взяти блокування {file}: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "Педаль уже використовується іншим екземпляром optima-air."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "Блокування вже знято: його більше не можна передати порту."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Це блокування вже належить порту: його не можна передати другому."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Не вдалося зняти блокування: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Педаль більше не відповідає: відключена або зависла."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "Не вдалося налаштувати порт {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "Не вдалося активувати вхід порту {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Порту {port} не існує."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Доступ до {port} заборонено. Перевірте, чи ви входите до групи «audio» (команда: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Порт {port} уже використовується іншою програмою."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Порт {port} більше не доступний."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Не вдалося відкрити порт {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Не вдалося записати: порт закрито."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Запис у порт {port} не вдався: жодного байта не прийнято."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Запис у порт {port} не вдався: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Очікування спорожнення порту {port} переривалося {count} разів поспіль: повідомлення передано ядру, але дочекатися його відправлення не вдалося."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Очікування поза діапазоном: {wait} с (не більше {max} с)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Не вдалося прочитати: порт закрито."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Читання з порту {port} не вдалося: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Порт {port} не повідомляє стан свого входу ({error}): втрату байтів виявити неможливо, зупиняємося."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Читання стану порту {port} не вдалося: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Закриття порту {port} не вдалося: {error}"
