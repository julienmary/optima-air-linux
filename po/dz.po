#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "identifier {value} out of 0..{max}: bit 31 is reserved for factory IRs, a function not yet open"
msgstr "ངོས་འཛིན་ {value} འདི་ 0..{max} གི་ཁྱབ་ཚད་ཀྱི་ཕྱི་ཁར་ཨིན། བིཊ་ 31 འདི་ བཟོ་གྲྭའི་ IR གི་དོན་ལུ་ བཞག་ཡོད། ལས་འགན་འདི་ ད་ལྟོ་ཚུན་ མ་ཁ་ཕྱེ།"

#: src/optima_air/messages_emission.py
