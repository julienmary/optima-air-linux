#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "ਪੋਰਟ {port} ਖੋਲ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "ਲਿਖਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ: ਪੋਰਟ ਬੰਦ ਹੈ।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "ਪੋਰਟ {port} ’ਤੇ ਲਿਖਣਾ ਅਸਫ਼ਲ ਰਿਹਾ: ਕੋਈ ਬਾਈਟ ਸਵੀਕਾਰ ਨਹੀਂ ਹੋਇਆ।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "ਪੋਰਟ {port} ’ਤੇ ਲਿਖਣਾ ਅਸਫ਼ਲ ਰਿਹਾ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "ਪੋਰਟ {port} ਨੂੰ ਡਰੇਨ ਕਰਨਾ ਲਗਾਤਾਰ {count} ਵਾਰ ਰੁਕਿਆ: ਸੁਨੇਹਾ ਕਰਨਲ ਨੂੰ ਸੌਂਪ ਦਿੱਤਾ ਗਿਆ ਹੈ, ਪਰ ਉਸ ਦੇ ਰਵਾਨਾ ਹੋਣ ਦੀ ਉਡੀਕ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕੀ।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "ਉਡੀਕ ਹੱਦ ਤੋਂ ਬਾਹਰ: {wait} ਸਕਿੰਟ (ਵੱਧ ਤੋਂ ਵੱਧ {max} ਸਕਿੰਟ)।"

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "ਪੜ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ: ਪੋਰਟ ਬੰਦ ਹੈ।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "ਪੋਰਟ {port} ਤੋਂ ਪੜ੍ਹਨਾ ਅਸਫ਼ਲ ਰਿਹਾ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "ਪੋਰਟ {port} ਆਪਣੇ ਇਨਪੁੱਟ ਦੀ ਹਾਲਤ ਨਹੀਂ ਦੱਸਦਾ ({error}): ਬਾਈਟਾਂ ਦੇ ਗੁਆਚਣ ਦਾ ਪਤਾ ਨਹੀਂ ਲਗਾਇਆ ਜਾ ਸਕਦਾ, ਇੱਥੇ ਹੀ ਰੁਕ ਰਹੇ ਹਾਂ।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "ਪੋਰਟ {port} ਦੀ ਹਾਲਤ ਪੜ੍ਹਨਾ ਅਸਫ਼ਲ ਰਿਹਾ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "ਪੋਰਟ {port} ਬੰਦ ਕਰਨਾ ਅਸਫ਼ਲ ਰਿਹਾ: {error}"
