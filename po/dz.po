msgstr "{field}: རྒྱབ་ཉར་ཡིག་སྣོད་ཀྱི་མིང་དགོ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 64 hexadecimal digits expected"
msgstr "{field}: བཅུ་དྲུག་གྲངས་ཀྱི་ཨང་ 64 དགོ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 32 bytes in hexadecimal expected"
msgstr "{field}: བཅུ་དྲུག་གྲངས་ནང་ བཱའིཊ་ 32 དགོ"

#: src/optima_air/journal.py
msgid "identifier out of range"
msgstr "ངོས་འཛིན་ཁྱབ་ཚད་ཀྱི་ཕྱི་ཁར།"

#: src/optima_air/journal.py
#, python-brace-format
