msgstr "ការព្រមាន: លេខសម្គាល់ដែលបានប្រកាសសម្រាប់ទីតាំង {slot} មិនត្រូវនឹងទិន្នន័យដែលបានអាន ទោះបីបានអានម្តងទៀតក៏ដោយ ប៉ុន្តែនៅតែបម្រុងទុក"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "All 23 slots are backed up in {backup}"
msgstr "ទីតាំងទាំង 23 ត្រូវបានបម្រុងទុកក្នុង {backup}"

#: src/optima_air/cli.py
msgid "No backups."
msgstr "គ្មានការបម្រុងទុក"

