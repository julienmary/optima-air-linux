msgstr "ཐེངས་ཁྱབ་ཚད་ ཡང་ན་ ཚེག་གྲངས་ ནུས་མེད།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Unreadable audio file: {file} ({error})"
msgstr "ཀློག་མི་ཚུགས་པའི་སྒྲ་ཡིག་ཆ་: {file} ({error})"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file has {count} channels: only the first one is kept."
msgstr "ཡིག་ཆ་ནང་ ལམ་ཁ་ {count} ཡོད། དང་པ་རྐྱངམ་ཅིག་ བཞག་ཡོད།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Empty audio file: {file}"
msgstr "སྟོངམ་ཨིན་མི་སྒྲ་ཡིག་ཆ་: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file contains non-finite samples: {file}"
msgstr "ཡིག་ཆ་ནང་ མཐའ་མེད་པའི་ (non-finite) དཔེ་ཚུ་ཡོད: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Sample rate of {rate} Hz: the file was resampled to {target} kHz."
msgstr "དཔེ་ཚད་ {rate} Hz: ཡིག་ཆ་འདི་ {target} kHz ལུ་ ལོག་དཔེ་བཏོན་འབད་ཅི།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file lasts {duration} ms: only the first {count} samples ({limit} ms) are kept."
msgstr "ཡིག་ཆ་འདི་ ms {duration} ཡོད། དང་པ་དཔེ་ {count} ({limit} ms) རྐྱངམ་ཅིག་ བཞག་ཡོད།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The pedal only plays the first {count} samples ({limit} ms): the rest of this IR will be stored but not heard."
msgstr "པེ་ཌལ་གྱིས་ དང་པ་དཔེ་ {count} ({limit} ms) རྐྱངམ་ཅིག་ གཏོང་འོང་། IR འདི་གི་ལྷག་མ་འདི་ གསོག་འཇོག་འབད་འོང་རུང་ ཉན་མི་ཚུགས།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Cannot normalise {file}: no signal between 400 Hz and 3 kHz."
msgstr "{file} སྤྱིར་བཏང་བསྒྱུར་མ་ཚུགས: 400 Hz དང་ 3 kHz གི་ན་ལུ་ བརྡ་རྟགས་མེདཔ།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Normalising {file} exceeds the range of floating-point numbers."
msgstr "{file} སྤྱིར་བཏང་བསྒྱུར་འབད་བ་ཅིན་ ཕྱི་མཐའི་ཚེག་གྲངས་ཀྱི་ཁྱབ་ཚད་ལས་བརྒལཝ་ཨིན།"

#: src/optima_air/ir.py
#, python-brace-format
msgid "After normalisation, the IR peaks at {peak} (usual IRs stay below 10): the file has a very deep dip between 400 Hz and 3 kHz, and the output level may be very high."
msgstr "སྤྱིར་བཏང་བསྒྱུར་ཞིནམ་ལས་ IR གི་མཐོ་ཚད་འདི་ {peak} ཨིན (IR སྤྱིར་བཏང་ཚུ་ 10 ལས་མར་སྡོད་དོ): ཡིག་ཆ་ནང་ 400 Hz དང་ 3 kHz གི་ན་ལུ་ ཟབ་ཅན་གྱི་འོག་ཐལ་ཡོད། ཐོན་འཇུག་གི་ཚད་འདི་ ཅུང་ཟད་མཐོ་བའི་ཉེན་ཡོད།"

#: src/optima_air/journal.py
msgid "a journal date must carry a time zone"
msgstr "ཉིན་ཐོའི་ཚེས་གྲངས་ལུ་ དུས་ཚོད་ཁོངས་ཡོད་དགོ"

#: src/optima_air/journal.py
msgid "slot out of range"
msgstr "སློཊ་ཁྱབ་ཚད་ཀྱི་ཕྱི་ཁར།"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone expected"
msgstr "{field}: དུས་ཚོད་ཁོངས་དང་བཅས་པའི་ ISO ཚེས་གྲངས་དགོ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone, or null, expected"
msgstr "{field}: དུས་ཚོད་ཁོངས་དང་བཅས་པའི་ ISO ཚེས་གྲངས་ ཡང་ན་ null དགོ"

