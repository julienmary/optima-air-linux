msgstr "അറിയിപ്പ് അയച്ചു: മറുപടി ലഭിച്ചു"

#: src/optima_air/cli.py
msgid "Announcement sent: no answer"
msgstr "അറിയിപ്പ് അയച്ചു: മറുപടിയില്ല"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{name}: validated"
msgstr "{name}: സാധൂകരിച്ചു"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{name}: on trial"
msgstr "{name}: പരീക്ഷണത്തിലാണ്"

#: src/optima_air/cli.py
#, python-brace-format
msgid "“trials {action}” expects the name of a function."
msgstr "“trials {action}” ഒരു ഫംഗ്ഷന്റെ പേര് പ്രതീക്ഷിക്കുന്നു."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Name “{name}” refused ({error}). Give one with --name."
msgstr "പേര് “{name}” നിരസിച്ചു ({error}). --name ഉപയോഗിച്ച് ഒന്ന് നൽകുക."

#: src/optima_air/cli.py src/optima_air/gui/dialogues.py
#, python-brace-format
msgid "Warning: {warning}"
msgstr "മുന്നറിയിപ്പ്: {warning}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Overwrite slot {slot} “{current}” with “{name}” ({file})?"
msgstr "സ്ലോട്ട് {slot} “{current}” “{name}” ({file}) ഉപയോഗിച്ച് ഓവർറൈറ്റ് ചെയ്യണോ?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical."
msgstr "സ്ലോട്ട് {slot}: “{name}” എഴുതി, തിരികെ വായിച്ചപ്പോൾ സമാനമായിരുന്നു."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Previous content (“{name}”) backed up in {backup}"
msgstr "മുൻ ഉള്ളടക്കം (“{name}”) {backup} ൽ ബാക്കപ്പ് ചെയ്തു"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{file} already exists. Add --yes to overwrite it."
msgstr "{file} ഇതിനകം നിലവിലുണ്ട്. ഓവർറൈറ്റ് ചെയ്യാൻ --yes ചേർക്കുക."

#: src/optima_air/cli.py src/optima_air/disque.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Cannot write {file}: {error}"
msgstr "{file} എഴുതാൻ കഴിയില്ല: {error}"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot} “{name}” exported to {file}"
msgstr "സ്ലോട്ട് {slot} “{name}” {file} ലേക്ക് എക്സ്പോർട്ട് ചെയ്തു"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Reading: {done} of {total}…"
msgstr "വായിക്കുന്നു: {total} ൽ {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Warning: the identifier announced for slot {slot} does not match the data read, even after reading again. It is backed up anyway."
msgstr "മുന്നറിയിപ്പ്: സ്ലോട്ട് {slot} ന് പ്രഖ്യാപിച്ച ഐഡന്റിഫയർ വീണ്ടും വായിച്ചതിനു ശേഷവും വായിച്ച ഡാറ്റയുമായി പൊരുത്തപ്പെടുന്നില്ല. എന്നിരുന്നാലും ബാക്കപ്പ് എടുക്കുന്നു."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "All 23 slots are backed up in {backup}"
msgstr "23 സ്ലോട്ടുകളും {backup} ൽ ബാക്കപ്പ് ചെയ്തു"

#: src/optima_air/cli.py
msgid "No backups."
msgstr "ബാക്കപ്പുകളൊന്നുമില്ല."

#: src/optima_air/cli.py
#, python-brace-format
msgid "{count} slot"
msgid_plural "{count} slots"
msgstr[0] "{count} സ്ലോട്ട്"
msgstr[1] "{count} സ്ലോട്ടുകൾ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "DAMAGED ({error})"
msgstr "കേടായി ({error})"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
msgid "none"
msgstr "ഒന്നുമില്ല"

#: src/optima_air/cli.py
msgid "--name only applies to restoring a single slot."
msgstr "--name ഒരൊറ്റ സ്ലോട്ട് പുനഃസ്ഥാപിക്കുമ്പോൾ മാത്രമേ ബാധകമാകൂ."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Put the pedal back to the state of the backup {backup} ({count} slot)? Only the slots that differ will be rewritten, after their content is backed up."
msgid_plural "Put the pedal back to the state of the backup {backup} ({count} slots)? Only the slots that differ will be rewritten, after their content is backed up."
msgstr[0] "പെഡലിനെ ബാക്കപ്പ് {backup} ന്റെ അവസ്ഥയിലേക്ക് ({count} സ്ലോട്ട്) തിരികെ കൊണ്ടുവരണോ? വ്യത്യാസമുള്ള സ്ലോട്ടുകൾ മാത്രം, അവയുടെ ഉള്ളടക്കം ബാക്കപ്പ് ചെയ്തതിനു ശേഷം, വീണ്ടും എഴുതും."
msgstr[1] "പെഡലിനെ ബാക്കപ്പ് {backup} ന്റെ അവസ്ഥയിലേക്ക് ({count} സ്ലോട്ടുകൾ) തിരികെ കൊണ്ടുവരണോ? വ്യത്യാസമുള്ള സ്ലോട്ടുകൾ മാത്രം, അവയുടെ ഉള്ളടക്കം ബാക്കപ്പ് ചെയ്തതിനു ശേഷം, വീണ്ടും എഴുതും."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "{operation}: {done} of {total}…"
msgstr "{operation}: {total} ൽ {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots rewritten and read back identical: {slots}"
msgstr "വീണ്ടും എഴുതി, തിരികെ വായിച്ചപ്പോൾ സമാനമായ സ്ലോട്ടുകൾ: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots whose settings only were restored: {slots}"
msgstr "ക്രമീകരണങ്ങൾ മാത്രം പുനഃസ്ഥാപിച്ച സ്ലോട്ടുകൾ: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots already identical to the backup: {slots}"
msgstr "ബാക്കപ്പുമായി ഇതിനകം സമാനമായ സ്ലോട്ടുകൾ: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Rewrite slot {slot} “{current}” from the backup {backup} (“{name}”)?"
msgstr "സ്ലോട്ട് {slot} “{current}” ബാക്കപ്പ് {backup} ൽ നിന്ന് (“{name}”) വീണ്ടും എഴുതണോ?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot} restored from {backup}, then read back identical."
msgstr "സ്ലോട്ട് {slot} {backup} ൽ നിന്ന് പുനഃസ്ഥാപിച്ചു, തുടർന്ന് തിരികെ വായിച്ചപ്പോൾ സമാനമായിരുന്നു."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Replaced content (“{name}”) backed up in {backup}"
msgstr "മാറ്റിസ്ഥാപിച്ച ഉള്ളടക്കം (“{name}”) {backup} ൽ ബാക്കപ്പ് ചെയ്തു"

#: src/optima_air/cli.py
msgid "No interrupted write."
msgstr "തടസ്സപ്പെട്ട എഴുത്തൊന്നുമില്ല."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: the interrupted write had completed. Nothing to do."
msgstr "സ്ലോട്ട് {slot}: തടസ്സപ്പെട്ട എഴുത്ത് പൂർത്തിയായിരുന്നു. ചെയ്യാൻ ഒന്നുമില്ല."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: it still holds what it held before. Nothing to do."
msgstr "സ്ലോട്ട് {slot}: അത് ഇപ്പോഴും മുമ്പ് ഉണ്ടായിരുന്നത് തന്നെ ഉൾക്കൊള്ളുന്നു. ചെയ്യാൻ ഒന്നുമില്ല."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: its content is neither the old nor the new one. To put it back as it was: optima-air restore {backup} {slot}"
msgstr "സ്ലോട്ട് {slot}: അതിന്റെ ഉള്ളടക്കം പഴയതുമല്ല പുതിയതുമല്ല. മുമ്പത്തെ പോലെ തിരികെ വയ്ക്കാൻ: optima-air restore {backup} {slot}"

#: src/optima_air/cli.py
msgid "allow more than reads on a firmware that was not verified"
msgstr "പരിശോധിച്ചിട്ടില്ലാത്ത ഫേംവെയറിൽ വായന അല്ലാതെയുള്ളവയും അനുവദിക്കുക"

#: src/optima_air/cli.py
msgid "allow a trial function"
msgstr "ഒരു പരീക്ഷണ ഫംഗ്ഷൻ അനുവദിക്കുക"

#: src/optima_air/cli.py
msgid "do not ask for confirmation"
msgstr "സ്ഥിരീകരണം ചോദിക്കരുത്"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count}"
msgstr "സ്ലോട്ട് നമ്പർ, 1 മുതൽ {count} വരെ"

#: src/optima_air/cli.py
msgid "Linux editor for the NUX Optima Air pedal."
msgstr "NUX Optima Air പെഡലിനുള്ള Linux എഡിറ്റർ."

#: src/optima_air/cli.py
msgid "data folder (default: XDG data folder)"
msgstr "ഡാറ്റ ഫോൾഡർ (ഡിഫോൾട്ട്: XDG ഡാറ്റ ഫോൾഡർ)"

#: src/optima_air/cli.py
msgid "open the window"
msgstr "വിൻഡോ തുറക്കുക"

#: src/optima_air/cli.py
msgid "firmware version, preset and settings"
msgstr "ഫേംവെയർ പതിപ്പ്, പ്രീസെറ്റ്, ക്രമീകരണങ്ങൾ"

#: src/optima_air/cli.py
msgid "the 23 IR slots"
msgstr "23 IR സ്ലോട്ടുകൾ"

#: src/optima_air/cli.py
msgid "back up the IR of a slot"
msgstr "ഒരു സ്ലോട്ടിന്റെ IR ബാക്കപ്പ് ചെയ്യുക"

#: src/optima_air/cli.py
msgid "print what the pedal sends"
msgstr "പെഡൽ അയയ്ക്കുന്നത് പ്രിന്റ് ചെയ്യുക"

#: src/optima_air/cli.py
msgid "seconds of listening"
msgstr "ശ്രദ്ധിക്കുന്ന സെക്കൻഡുകൾ"

#: src/optima_air/cli.py
msgid "read the state first"
msgstr "ആദ്യം അവസ്ഥ വായിക്കുക"

#: src/optima_air/cli.py
msgid "send the announcement first (trial)"
msgstr "ആദ്യം അറിയിപ്പ് അയയ്ക്കുക (പരീക്ഷണം)"

#: src/optima_air/cli.py
msgid "write a WAV into a slot"
msgstr "ഒരു സ്ലോട്ടിലേക്ക് WAV എഴുതുക"

#: src/optima_air/cli.py
msgid "WAV file"
msgstr "WAV ഫയൽ"

#: src/optima_air/cli.py
msgid "name of the slot (default: the name of the file)"
msgstr "സ്ലോട്ടിന്റെ പേര് (ഡിഫോൾട്ട്: ഫയലിന്റെ പേര്)"

#: src/optima_air/cli.py
msgid "export a slot as WAV"
msgstr "ഒരു സ്ലോട്ട് WAV ആയി എക്സ്പോർട്ട് ചെയ്യുക"

#: src/optima_air/cli.py
msgid "WAV file to write"
msgstr "എഴുതേണ്ട WAV ഫയൽ"

#: src/optima_air/cli.py
msgid "rewrite a slot, or all of them, from a backup"
msgstr "ഒരു ബാക്കപ്പിൽ നിന്ന് ഒരു സ്ലോട്ട്, അല്ലെങ്കിൽ എല്ലാം, വീണ്ടും എഴുതുക"

#: src/optima_air/cli.py
msgid "backup folder"
msgstr "ബാക്കപ്പ് ഫോൾഡർ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count} (default: all)"
msgstr "സ്ലോട്ട് നമ്പർ, 1 മുതൽ {count} വരെ (ഡിഫോൾട്ട്: എല്ലാം)"

#: src/optima_air/cli.py
msgid "replace the backed up name"
msgstr "ബാക്കപ്പ് ചെയ്ത പേര് മാറ്റിസ്ഥാപിക്കുക"

#: src/optima_air/cli.py
msgid "back up the 23 slots"
msgstr "23 സ്ലോട്ടുകളും ബാക്കപ്പ് ചെയ്യുക"

#: src/optima_air/cli.py
msgid "list the backups"
msgstr "ബാക്കപ്പുകൾ പട്ടികപ്പെടുത്തുക"

#: src/optima_air/cli.py
msgid "check an interrupted write"
msgstr "തടസ്സപ്പെട്ട എഴുത്ത് പരിശോധിക്കുക"

#: src/optima_air/cli.py
msgid "register of the trial functions"
msgstr "പരീക്ഷണ ഫംഗ്ഷനുകളുടെ രജിസ്റ്റർ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "സ്ലോട്ട് {slot} ലേക്കുള്ള എഴുത്ത് അപൂർണ്ണമായി അവശേഷിച്ചു. പെഡൽ കുറച്ചുനേരം തനിച്ചു വിടും; തുടർന്ന് പ്രവർത്തിപ്പിക്കുക: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "പിശക്: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "തടസ്സപ്പെട്ടു."

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "ബൈറ്റ് {byte} 7 ബിറ്റുകൾക്ക് പുറത്താണ്"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "{count} 7-ബിറ്റ് ബൈറ്റുകൾ {bits} പാഡിംഗ് ബിറ്റുകൾ അവശേഷിപ്പിക്കുന്നു, enc7 ഒരിക്കലും 6 ൽ കൂടുതൽ ഉണ്ടാക്കുന്നില്ല"

#: src/optima_air/codec.py
msgid "non-zero padding bits at the end of a 7-bit stream"
msgstr "7-ബിറ്റ് സ്ട്രീമിന്റെ അവസാനം പൂജ്യമല്ലാത്ത പാഡിംഗ് ബിറ്റുകൾ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "ഒരു ബ്ലോക്ക് {expected} ബൈറ്റുകളാണ്, {got} ലഭിച്ചു"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "ബ്ലോക്ക് തുക {sum} ({hex}) കൈമാറുന്ന 14 ബിറ്റുകൾക്ക് അപ്പുറമാണ് (പരമാവധി {max}): പെഡലിൽ ഒരിക്കലും കണ്ടിട്ടില്ല, സാധൂകരിക്കുന്നതുവരെ നിരസിക്കുന്നു"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "എൻകോഡ് ചെയ്ത ബ്ലോക്ക് {expected} ബൈറ്റുകളാണ്, {got} ലഭിച്ചു"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "എൻകോഡ് ചെയ്ത ബ്ലോക്കിൽ 7 ബിറ്റുകൾക്ക് പുറത്തുള്ള ബൈറ്റ്"

#: src/optima_air/codec.py
msgid "wrong block checksum"
msgstr "തെറ്റായ ബ്ലോക്ക് ചെക്ക്സം"

#: src/optima_air/codec.py
msgid "the end-of-transfer sum covers at least one block"
msgstr "കൈമാറ്റത്തിന്റെ അവസാന തുക കുറഞ്ഞത് ഒരു ബ്ലോക്കെങ്കിലും ഉൾക്കൊള്ളുന്നു"

#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
