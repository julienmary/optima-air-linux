#: src/optima_air/gui/fenetre.py
msgid "Choose a WAV file"
msgstr "ជ្រើសរើសឯកសារ WAV"

#: src/optima_air/gui/fenetre.py
msgid "One file at a time: a slot holds a single IR."
msgstr "ម្តងមួយឯកសារ: ទីតាំងមួយផ្ទុក IR បានតែមួយប៉ុណ្ណោះ"

#: src/optima_air/gui/fenetre.py
msgid "Export as WAV"
msgstr "នាំចេញជា WAV"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Restore finished. Slots rewritten and read back identical: {rewritten}. Settings only: {settings}. Already identical to the backup: {unchanged}."
msgstr "ការស្ដារបានបញ្ចប់ ទីតាំងដែលបានសរសេរឡើងវិញ ហើយអានត្រឡប់មកវិញដូចគ្នា: {rewritten} តែការកំណត់: {settings} ដូចនឹងការបម្រុងទុករួចហើយ: {unchanged}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it still holds what it held before. Nothing to do."
msgstr "ទីតាំង {slot}: បន្ទាប់ពីការសរសេរដែលត្រូវបានរំខាន វានៅតែមានមាតិកាដដែលដូចមុន មិនចាំបាច់ធ្វើអ្វីទេ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it holds neither the old nor the new content. Until it is put right, it is the only slot that can be written."
msgstr "ទីតាំង {slot}: បន្ទាប់ពីការសរសេរដែលត្រូវបានរំខាន វាមិនមានមាតិកាចាស់ ឬថ្មីទេ រហូតដល់វាត្រូវបានកែតម្រូវ វាជាទីតាំងតែមួយគត់ដែលអាចសរសេរបាន"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: {name}"
msgstr "ទីតាំង {slot}: {name}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical. Previous content backed up in {backup}"
msgstr "ទីតាំង {slot}: បានសរសេរ “{name}” ហើយអានត្រឡប់មកវិញដូចគ្នា មាតិកាពីមុនត្រូវបានបម្រុងទុកក្នុង {backup}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot}…"
msgstr "កំពុងសរសេរទីតាំង {slot}…"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot} failed: {reason} The pedal is left alone for {seconds} s, then the state of the slot will be checked."
msgstr "ការសរសេរទីតាំង {slot} បរាជ័យ: {reason} នឹងមិនប៉ះពាល់ផេដាល់រយៈពេល {seconds} វិនាទី បន្ទាប់មកស្ថានភាពនៃទីតាំងនឹងត្រូវបានពិនិត្យ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The backup failed: {reason}"
msgstr "ការបម្រុងទុកបរាជ័យ: {reason}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The restore stopped: {reason} The slots already handled are in order; the state of the pedal will be read again."
msgstr "ការស្ដារបានឈប់: {reason} ទីតាំងដែលបានដោះស្រាយរួចគឺនៅក្នុងសណ្តាប់ធ្នាប់ ហើយស្ថានភាពនៃផេដាល់នឹងត្រូវអានម្តងទៀត"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Connected, firmware {version}"
msgstr "បានតភ្ជាប់ ហ្វឺមវែរ {version}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Disconnected: {reason}"
msgstr "បានផ្តាច់: {reason}"

#: src/optima_air/gui/fenetre.py
msgid "Warning: the identifier announced by the pedal does not match the data read."
msgstr "ការព្រមាន: លេខសម្គាល់ដែលផេដាល់ប្រកាសមិនត្រូវនឹងទិន្នន័យដែលបានអាន"

#: src/optima_air/gui/travail.py
msgid "Stop requested."
msgstr "បានស្នើឱ្យឈប់"

#: src/optima_air/gui/travail.py
msgid "Backup"
msgstr "ការបម្រុងទុក"

#: src/optima_air/ir.py
msgid "invalid frequency range or number of points"
msgstr "ជួរប្រេកង់ ឬចំនួនចំណុចមិនត្រឹមត្រូវ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Unreadable audio file: {file} ({error})"
msgstr "មិនអាចអានឯកសារសំឡេង: {file} ({error})"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file has {count} channels: only the first one is kept."
msgstr "ឯកសារមាន {count} ឆានែល: រក្សាទុកតែឆានែលទីមួយប៉ុណ្ណោះ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Empty audio file: {file}"
msgstr "ឯកសារសំឡេងទទេ: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file contains non-finite samples: {file}"
msgstr "ឯកសារមានគំរូដែលមិនមែនជាចំនួនកំណត់: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Sample rate of {rate} Hz: the file was resampled to {target} kHz."
msgstr "អត្រាគំរូ {rate} Hz: ឯកសារត្រូវបានយកគំរូឡើងវិញទៅ {target} kHz"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file lasts {duration} ms: only the first {count} samples ({limit} ms) are kept."
msgstr "ឯកសារមានរយៈពេល {duration} ms: រក្សាទុកតែ {count} គំរូដំបូង ({limit} ms)"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The pedal only plays the first {count} samples ({limit} ms): the rest of this IR will be stored but not heard."
msgstr "ផេដាល់ចាក់តែ {count} គំរូដំបូងប៉ុណ្ណោះ ({limit} ms): ផ្នែកដែលនៅសល់នៃ IR នេះនឹងត្រូវបានរក្សាទុកប៉ុន្តែនឹងមិនឮទេ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Cannot normalise {file}: no signal between 400 Hz and 3 kHz."
msgstr "មិនអាចធ្វើឱ្យ {file} ប្រក្រតី: គ្មានសញ្ញារវាង 400 Hz និង 3 kHz"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Normalising {file} exceeds the range of floating-point numbers."
msgstr "ការធ្វើឱ្យ {file} ប្រក្រតីលើសពីជួរនៃចំនួនទសភាគអណ្តែត"

#: src/optima_air/ir.py
#, python-brace-format
msgid "After normalisation, the IR peaks at {peak} (usual IRs stay below 10): the file has a very deep dip between 400 Hz and 3 kHz, and the output level may be very high."
msgstr "បន្ទាប់ពីការធ្វើឱ្យប្រក្រតី IR មានកំពូល {peak} (IR ធម្មតាមានតម្លៃក្រោម 10): ឯកសារមានរណ្តៅជ្រៅខ្លាំងរវាង 400 Hz និង 3 kHz ហើយកម្រិតទិន្នផលអាចខ្ពស់ខ្លាំង"

#: src/optima_air/journal.py
msgid "a journal date must carry a time zone"
msgstr "កាលបរិច្ឆេទនៃកំណត់ហេតុត្រូវមានល្វែងម៉ោង"

#: src/optima_air/journal.py
msgid "slot out of range"
msgstr "ទីតាំងនៅក្រៅចន្លោះ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone expected"
msgstr "{field}: ត្រូវការកាលបរិច្ឆេទ ISO ដែលមានល្វែងម៉ោង"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone, or null, expected"
msgstr "{field}: ត្រូវការកាលបរិច្ឆេទ ISO ដែលមានល្វែងម៉ោង ឬ null"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: backup folder name expected"
msgstr "{field}: ត្រូវការឈ្មោះថតបម្រុងទុក"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 64 hexadecimal digits expected"
msgstr "{field}: ត្រូវការខ្ទង់គោលដប់ប្រាំមួយ 64 ខ្ទង់"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 32 bytes in hexadecimal expected"
msgstr "{field}: ត្រូវការ 32 បៃជាគោលដប់ប្រាំមួយ"

#: src/optima_air/journal.py
msgid "identifier out of range"
msgstr "លេខសម្គាល់នៅក្រៅចន្លោះ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: boolean expected"
msgstr "{field}: ត្រូវការតម្លៃប៊ូលីន"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Unreadable write journal: {file} ({error})"
msgstr "មិនអាចអានកំណត់ហេតុសរសេរ: {file} ({error})"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Cannot remove the journal {file}: {error}"
msgstr "មិនអាចលុបកំណត់ហេតុ {file}: {error}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "MD5 of {size} bytes instead of {expected}"
msgstr "MD5 មាន {size} បៃ ជំនួសឱ្យ {expected}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "encoded block of {size} bytes instead of {expected}"
msgstr "ប្លុកដែលបានអ៊ិនកូដមាន {size} បៃ ជំនួសឱ្យ {expected}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: malformed Control Change"
msgstr "សារ “{message}”: Control Change មិនត្រឹមត្រូវ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: a Control Change is a setting"
msgstr "សារ “{message}”: Control Change ជាការកំណត់"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: Control Change not in the closed list"
msgstr "សារ “{message}”: Control Change មិនស្ថិតក្នុងបញ្ជីបិទ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: value {value} above {max}"
msgstr "សារ “{message}”: តម្លៃ {value} លើសពី {max}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}” badly framed"
msgstr "សារ “{message}” មានស៊ុមមិនត្រឹមត្រូវ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: byte outside 7 bits"
msgstr "សារ “{message}”: បៃនៅក្រៅ 7 ប៊ីត"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}” not in the closed list"
msgstr "សារ “{message}” មិនស្ថិតក្នុងបញ្ជីបិទ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: {size} bytes instead of {expected}"
msgstr "សារ “{message}”: {size} បៃ ជំនួសឱ្យ {expected}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: {error}"
msgstr "សារ “{message}”: {error}"

#: src/optima_air/messages_emission.py
msgid "unexpected version request"
msgstr "សំណើកំណែដែលមិននឹកស្មាន"

#: src/optima_air/messages_emission.py
msgid "only the announcement 70 05 01, on trial, is allowed"
msgstr "អនុញ្ញាតតែសារប្រកាស 70 05 01 ដែលកំពុងសាកល្បងប៉ុណ្ណោះ"

#: src/optima_air/messages_emission.py
msgid "only the read 70 26 7F is allowed"
msgstr "អនុញ្ញាតតែការអាន 70 26 7F ប៉ុណ្ណោះ"

#: src/optima_air/messages_emission.py
msgid "table request with a non-zero body"
msgstr "សំណើតារាងដែលមានខ្លឹមសារមិនសូន្យ"

#: src/optima_air/messages_emission.py
msgid "table write: setting expected, values from 0 to 100"
msgstr "ការសរសេរតារាង: ត្រូវការការកំណត់ តម្លៃពី 0 ដល់ 100"

#: src/optima_air/messages_emission.py
msgid "malformed read request"
msgstr "សំណើអានមិនត្រឹមត្រូវ"

#: src/optima_air/messages_emission.py
msgid "slot out of range or non-zero body"
msgstr "ទីតាំងនៅក្រៅចន្លោះ ឬខ្លឹមសារមិនសូន្យ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "command {command} without a content rule"
msgstr "ពាក្យបញ្ជា {command} គ្មានច្បាប់ខ្លឹមសារ"

#: src/optima_air/messages_emission.py
msgid "upload message outside the write category"
msgstr "សារផ្ទុកឡើងនៅក្រៅប្រភេទសរសេរ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "write command {command} without a content rule"
msgstr "ពាក្យបញ្ជាសរសេរ {command} គ្មានច្បាប់ខ្លឹមសារ"

#: src/optima_air/messages_emission.py
msgid "malformed slot name"
msgstr "ឈ្មោះទីតាំងមិនត្រឹមត្រូវ"

#: src/optima_air/messages_emission.py
msgid "identifier with bit 31 set (factory IR): function not yet open"
msgstr "លេខសម្គាល់ដែលកំណត់ប៊ីត 31 (IR ពីរោងចក្រ): មុខងារមិនទាន់បើក"

#: src/optima_air/messages_emission.py
msgid "upload header: slot out of range"
msgstr "ក្បាលនៃការផ្ទុកឡើង: ទីតាំងនៅក្រៅចន្លោះ"

#: src/optima_air/messages_emission.py
msgid "upload header: MD5 outside lowercase hexadecimal digits"
msgstr "ក្បាលនៃការផ្ទុកឡើង: MD5 មានតួអក្សរក្រៅពីខ្ទង់គោលដប់ប្រាំមួយអក្សរតូច"

#: src/optima_air/messages_emission.py
msgid "upload header outside the observed form"
msgstr "ក្បាលនៃការផ្ទុកឡើងនៅក្រៅទម្រង់ដែលបានសង្កេតឃើញ"

#: src/optima_air/messages_emission.py
msgid "upload footer: non-zero byte after the flag"
msgstr "ជើងនៃការផ្ទុកឡើង: មានបៃមិនសូន្យក្រោយទង់"

#: src/optima_air/messages_emission.py
msgid "end block: slot out of range"
msgstr "ប្លុកបញ្ចប់: ទីតាំងនៅក្រៅចន្លោះ"

#: src/optima_air/messages_emission.py
msgid "end block outside the observed form"
msgstr "ប្លុកបញ្ចប់នៅក្រៅទម្រង់ដែលបានសង្កេតឃើញ"

#: src/optima_air/messages_emission.py
msgid "data block: address or counter out of range"
msgstr "ប្លុកទិន្នន័យ: អាសយដ្ឋាន ឬអ្នករាប់នៅក្រៅចន្លោះ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "data block: {error}"
msgstr "ប្លុកទិន្នន័យ: {error}"

#: src/optima_air/messages_emission.py
msgid "data block: payload outside the form produced by enc_msb"
