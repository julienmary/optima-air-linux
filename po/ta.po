#: src/optima_air/gui/fenetre.py
msgid "One file at a time: a slot holds a single IR."
msgstr "ஒரு நேரத்தில் ஒரு கோப்பு: ஒரு ஸ்லாட் ஒரே ஒரு IR ஐக் கொண்டிருக்கும்."

#: src/optima_air/gui/fenetre.py
msgid "Export as WAV"
msgstr "WAV ஆக ஏற்றுமதி செய்"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Restore finished. Slots rewritten and read back identical: {rewritten}. Settings only: {settings}. Already identical to the backup: {unchanged}."
msgstr "மீட்டமைப்பு முடிந்தது. மீண்டும் எழுதப்பட்டு, மீண்டும் படித்தபோது ஒன்றாக இருந்த ஸ்லாட்டுகள்: {rewritten}. அமைப்புகள் மட்டும்: {settings}. காப்புப்பிரதியுடன் ஏற்கெனவே ஒன்றாக இருந்தவை: {unchanged}."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it still holds what it held before. Nothing to do."
msgstr "ஸ்லாட் {slot}: இடைமறிக்கப்பட்ட எழுதுதலுக்குப் பிறகு, அது இன்னும் முன்பு இருந்ததையே கொண்டுள்ளது. செய்ய ஒன்றுமில்லை."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it holds neither the old nor the new content. Until it is put right, it is the only slot that can be written."
msgstr "ஸ்லாட் {slot}: இடைமறிக்கப்பட்ட எழுதுதலுக்குப் பிறகு, அது பழைய உள்ளடக்கத்தையும் புதிய உள்ளடக்கத்தையும் கொண்டிருக்கவில்லை. அது சரிசெய்யப்படும் வரை, எழுதக்கூடிய ஒரே ஸ்லாட் அதுவே."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: {name}"
msgstr "ஸ்லாட் {slot}: {name}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical. Previous content backed up in {backup}"
msgstr "ஸ்லாட் {slot}: “{name}” எழுதப்பட்டு, மீண்டும் படித்தபோது ஒன்றாக இருந்தது. முந்தைய உள்ளடக்கம் {backup} இல் காப்புப் பிரதி எடுக்கப்பட்டது"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot}…"
msgstr "ஸ்லாட் {slot} ஐ எழுதுகிறது…"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot} failed: {reason} The pedal is left alone for {seconds} s, then the state of the slot will be checked."
msgstr "ஸ்லாட் {slot} ஐ எழுதுவது தோல்வியடைந்தது: {reason} பெடல் {seconds} வி தனியாக விடப்படும், பிறகு ஸ்லாட்டின் நிலை சரிபார்க்கப்படும்."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The backup failed: {reason}"
msgstr "காப்புப் பிரதி எடுத்தல் தோல்வியடைந்தது: {reason}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The restore stopped: {reason} The slots already handled are in order; the state of the pedal will be read again."
msgstr "மீட்டமைப்பு நிறுத்தப்பட்டது: {reason} ஏற்கெனவே கையாளப்பட்ட ஸ்லாட்டுகள் சரியாக உள்ளன; பெடலின் நிலை மீண்டும் படிக்கப்படும்."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Connected, firmware {version}"
msgstr "இணைக்கப்பட்டது, ஃபர்ம்வேர் {version}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Disconnected: {reason}"
msgstr "துண்டிக்கப்பட்டது: {reason}"

#: src/optima_air/gui/fenetre.py
msgid "Warning: the identifier announced by the pedal does not match the data read."
msgstr "எச்சரிக்கை: பெடல் அறிவித்த அடையாளம் படித்த தரவுடன் பொருந்தவில்லை."

#: src/optima_air/gui/travail.py
msgid "Stop requested."
msgstr "நிறுத்தக் கோரிக்கை."

#: src/optima_air/gui/travail.py
msgid "Backup"
msgstr "காப்புப்பிரதி"

#: src/optima_air/ir.py
msgid "invalid frequency range or number of points"
msgstr "தவறான அதிர்வெண் வரம்பு அல்லது புள்ளிகளின் எண்ணிக்கை"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Unreadable audio file: {file} ({error})"
msgstr "படிக்க இயலாத ஆடியோ கோப்பு: {file} ({error})"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file has {count} channels: only the first one is kept."
msgstr "கோப்பில் {count} சேனல்கள் உள்ளன: முதலாவது மட்டுமே வைக்கப்படுகிறது."

#: src/optima_air/ir.py
#, python-brace-format
msgid "Empty audio file: {file}"
msgstr "வெற்று ஆடியோ கோப்பு: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file contains non-finite samples: {file}"
msgstr "கோப்பில் முடிவுறாத மாதிரிகள் உள்ளன: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Sample rate of {rate} Hz: the file was resampled to {target} kHz."
msgstr "மாதிரி வீதம் {rate} Hz: கோப்பு {target} kHz க்கு மறுமாதிரியாக்கப்பட்டது."

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file lasts {duration} ms: only the first {count} samples ({limit} ms) are kept."
msgstr "கோப்பு {duration} ms நீடிக்கிறது: முதல் {count} மாதிரிகள் ({limit} ms) மட்டுமே வைக்கப்படுகின்றன."

#: src/optima_air/ir.py
#, python-brace-format
msgid "The pedal only plays the first {count} samples ({limit} ms): the rest of this IR will be stored but not heard."
msgstr "பெடல் முதல் {count} மாதிரிகளை ({limit} ms) மட்டுமே இயக்கும்: இந்த IR இன் மீதி சேமிக்கப்படும் ஆனால் கேட்கப்படாது."

#: src/optima_air/ir.py
#, python-brace-format
msgid "Cannot normalise {file}: no signal between 400 Hz and 3 kHz."
msgstr "{file} ஐ இயல்பாக்க இயலவில்லை: 400 Hz மற்றும் 3 kHz க்கு இடையில் சமிக்ஞை இல்லை."

#: src/optima_air/ir.py
#, python-brace-format
msgid "Normalising {file} exceeds the range of floating-point numbers."
msgstr "{file} ஐ இயல்பாக்குவது மிதவைப் புள்ளி எண்களின் வரம்பை மீறுகிறது."

#: src/optima_air/ir.py
#, python-brace-format
msgid "After normalisation, the IR peaks at {peak} (usual IRs stay below 10): the file has a very deep dip between 400 Hz and 3 kHz, and the output level may be very high."
msgstr "இயல்பாக்கத்திற்குப் பிறகு, IR உச்சம் {peak} (வழக்கமான IR கள் 10 க்குக் கீழே இருக்கும்): கோப்பில் 400 Hz மற்றும் 3 kHz க்கு இடையில் மிக ஆழமான பள்ளம் உள்ளது, வெளியீட்டு அளவு மிக அதிகமாக இருக்கலாம்."

#: src/optima_air/journal.py
msgid "a journal date must carry a time zone"
msgstr "பதிவேட்டுத் தேதி நேர மண்டலத்தைக் கொண்டிருக்க வேண்டும்"

#: src/optima_air/journal.py
msgid "slot out of range"
msgstr "ஸ்லாட் வரம்புக்கு வெளியே"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone expected"
msgstr "{field}: நேர மண்டலத்துடன் கூடிய ISO தேதி எதிர்பார்க்கப்பட்டது"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone, or null, expected"
msgstr "{field}: நேர மண்டலத்துடன் கூடிய ISO தேதி, அல்லது null, எதிர்பார்க்கப்பட்டது"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: backup folder name expected"
msgstr "{field}: காப்புப்பிரதி கோப்புறை பெயர் எதிர்பார்க்கப்பட்டது"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 64 hexadecimal digits expected"
msgstr "{field}: 64 ஹெக்ஸாடெசிமல் இலக்கங்கள் எதிர்பார்க்கப்பட்டன"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 32 bytes in hexadecimal expected"
msgstr "{field}: ஹெக்ஸாடெசிமல் வடிவில் 32 பைட்டுகள் எதிர்பார்க்கப்பட்டன"

#: src/optima_air/journal.py
msgid "identifier out of range"
msgstr "அடையாளம் வரம்புக்கு வெளியே"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: boolean expected"
msgstr "{field}: பூலியன் எதிர்பார்க்கப்பட்டது"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Unreadable write journal: {file} ({error})"
msgstr "படிக்க இயலாத எழுதுதல் பதிவேடு: {file} ({error})"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Cannot remove the journal {file}: {error}"
msgstr "பதிவேடு {file} ஐ நீக்க இயலவில்லை: {error}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "MD5 of {size} bytes instead of {expected}"
msgstr "{expected} க்குப் பதிலாக {size} பைட்டுகளின் MD5"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "encoded block of {size} bytes instead of {expected}"
msgstr "{expected} க்குப் பதிலாக {size} பைட்டுகளின் குறியாக்கப்பட்ட பிளாக்"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: malformed Control Change"
msgstr "செய்தி “{message}”: தவறான வடிவிலான Control Change"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: a Control Change is a setting"
msgstr "செய்தி “{message}”: ஒரு Control Change என்பது ஓர் அமைப்பு"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: Control Change not in the closed list"
msgstr "செய்தி “{message}”: Control Change மூடிய பட்டியலில் இல்லை"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: value {value} above {max}"
msgstr "செய்தி “{message}”: மதிப்பு {value}, {max} ஐ விட அதிகம்"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}” badly framed"
msgstr "செய்தி “{message}” தவறாக வடிவமைக்கப்பட்டுள்ளது"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: byte outside 7 bits"
msgstr "செய்தி “{message}”: 7 பிட்டுக்கு வெளியே உள்ள பைட்"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}” not in the closed list"
msgstr "செய்தி “{message}” மூடிய பட்டியலில் இல்லை"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: {size} bytes instead of {expected}"
msgstr "செய்தி “{message}”: {expected} க்குப் பதிலாக {size} பைட்டுகள்"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: {error}"
msgstr "செய்தி “{message}”: {error}"

#: src/optima_air/messages_emission.py
msgid "unexpected version request"
msgstr "எதிர்பாராத பதிப்புக் கோரிக்கை"

#: src/optima_air/messages_emission.py
msgid "only the announcement 70 05 01, on trial, is allowed"
msgstr "சோதனையில் உள்ள 70 05 01 அறிவிப்பு மட்டுமே அனுமதிக்கப்படுகிறது"

#: src/optima_air/messages_emission.py
msgid "only the read 70 26 7F is allowed"
msgstr "70 26 7F வாசிப்பு மட்டுமே அனுமதிக்கப்படுகிறது"

#: src/optima_air/messages_emission.py
msgid "table request with a non-zero body"
msgstr "பூஜ்யமற்ற உடலுடன் அட்டவணைக் கோரிக்கை"

#: src/optima_air/messages_emission.py
msgid "table write: setting expected, values from 0 to 100"
msgstr "அட்டவணை எழுதுதல்: அமைப்பு எதிர்பார்க்கப்பட்டது, மதிப்புகள் 0 முதல் 100 வரை"

#: src/optima_air/messages_emission.py
msgid "malformed read request"
msgstr "தவறான வடிவிலான வாசிப்புக் கோரிக்கை"

#: src/optima_air/messages_emission.py
msgid "slot out of range or non-zero body"
msgstr "ஸ்லாட் வரம்புக்கு வெளியே அல்லது பூஜ்யமற்ற உடல்"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "command {command} without a content rule"
msgstr "கட்டளை {command} க்கு உள்ளடக்க விதி இல்லை"

#: src/optima_air/messages_emission.py
msgid "upload message outside the write category"
msgstr "எழுதுதல் வகைக்கு வெளியே உள்ள பதிவேற்றச் செய்தி"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "write command {command} without a content rule"
msgstr "எழுதும் கட்டளை {command} க்கு உள்ளடக்க விதி இல்லை"

#: src/optima_air/messages_emission.py
msgid "malformed slot name"
msgstr "தவறான வடிவிலான ஸ்லாட் பெயர்"

#: src/optima_air/messages_emission.py
msgid "identifier with bit 31 set (factory IR): function not yet open"
msgstr "பிட் 31 அமைக்கப்பட்ட அடையாளம் (தொழிற்சாலை IR): செயல்பாடு இன்னும் திறக்கப்படவில்லை"

#: src/optima_air/messages_emission.py
msgid "upload header: slot out of range"
msgstr "பதிவேற்றத் தலைப்பு: ஸ்லாட் வரம்புக்கு வெளியே"

#: src/optima_air/messages_emission.py
msgid "upload header: MD5 outside lowercase hexadecimal digits"
msgstr "பதிவேற்றத் தலைப்பு: MD5 சிறிய எழுத்து ஹெக்ஸாடெசிமல் இலக்கங்களுக்கு வெளியே"

#: src/optima_air/messages_emission.py
msgid "upload header outside the observed form"
msgstr "பதிவேற்றத் தலைப்பு கவனிக்கப்பட்ட வடிவத்திற்கு வெளியே"

#: src/optima_air/messages_emission.py
msgid "upload footer: non-zero byte after the flag"
msgstr "பதிவேற்ற அடிக்குறிப்பு: கொடிக்குப் பிறகு பூஜ்யமற்ற பைட்"

#: src/optima_air/messages_emission.py
msgid "end block: slot out of range"
msgstr "முடிவு பிளாக்: ஸ்லாட் வரம்புக்கு வெளியே"

#: src/optima_air/messages_emission.py
msgid "end block outside the observed form"
msgstr "முடிவு பிளாக் கவனிக்கப்பட்ட வடிவத்திற்கு வெளியே"

#: src/optima_air/messages_emission.py
msgid "data block: address or counter out of range"
msgstr "தரவு பிளாக்: முகவரி அல்லது கவுண்டர் வரம்புக்கு வெளியே"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "data block: {error}"
msgstr "தரவு பிளாக்: {error}"

#: src/optima_air/messages_emission.py
msgid "data block: payload outside the form produced by enc_msb"
msgstr "தரவு பிளாக்: பேலோட் enc_msb உருவாக்கும் வடிவத்திற்கு வெளியே உள்ளது"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "data block: non-zero padding beyond the {size} bytes of the IR"
msgstr "தரவு பிளாக்: IR இன் {size} பைட்டுகளுக்கு அப்பால் பூஜ்யமற்ற நிரப்பு"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "identifier {value} out of 0..{max}: bit 31 is reserved for factory IRs, a function not yet open"
