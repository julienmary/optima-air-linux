msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "പരീക്ഷണ രജിസ്റ്റർ മറ്റൊരു പ്രോസസ് ലോക്ക് ചെയ്തിരിക്കുന്നു ({file}): മറ്റ് കമാൻഡ് പൂർത്തിയായ ശേഷം വീണ്ടും ശ്രമിക്കുക."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "{file} ലോക്ക് ചെയ്യാൻ കഴിയില്ല: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "പെഡൽ കണ്ടെത്താനായില്ല: “NAI5” സൗണ്ട് കാർഡ് ഇല്ല. USB കേബിൾ പരിശോധിക്കുക."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR സജ്ജമാക്കിയിട്ടില്ല: ലോക്ക് എടുക്കാൻ കഴിയില്ല."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "ലോക്ക് {file} എടുക്കാൻ കഴിയില്ല: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "പെഡൽ ഇതിനകം optima-air ന്റെ മറ്റൊരു ഇൻസ്റ്റൻസ് ഉപയോഗിക്കുന്നു."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "ലോക്ക് ഇതിനകം റിലീസ് ചെയ്തു: ഇനി അത് ഒരു പോർട്ടിന് നൽകാൻ കഴിയില്ല."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "ഈ ലോക്ക് ഇതിനകം ഒരു പോർട്ടിന്റേതാണ്: ഇത് രണ്ടാമതൊന്നിന് നൽകാൻ കഴിയില്ല."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "ലോക്ക് റിലീസ് ചെയ്യാൻ കഴിയില്ല: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "പെഡൽ ഇനി പ്രതികരിക്കുന്നില്ല: പ്ലഗ് ഊരിയിരിക്കുന്നു അല്ലെങ്കിൽ തടസ്സപ്പെട്ടിരിക്കുന്നു."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "പോർട്ട് {port} കോൺഫിഗർ ചെയ്യാൻ കഴിയില്ല: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "പോർട്ട് {port} ന്റെ ഇൻപുട്ട് സജ്ജമാക്കാൻ കഴിയില്ല: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "പോർട്ട് {port} നിലവിലില്ല."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port} ലേക്കുള്ള പ്രവേശനം നിഷേധിച്ചു. നിങ്ങൾ “audio” ഗ്രൂപ്പിലുണ്ടോ എന്ന് പരിശോധിക്കുക (കമാൻഡ്: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "പോർട്ട് {port} ഇതിനകം മറ്റൊരു പ്രോഗ്രാം ഉപയോഗിക്കുന്നു."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "പോർട്ട് {port} ഇനി ലഭ്യമല്ല."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "പോർട്ട് {port} തുറക്കാൻ കഴിയില്ല: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "എഴുതാൻ കഴിയില്ല: പോർട്ട് അടച്ചിരിക്കുന്നു."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "പോർട്ട് {port} ലേക്ക് എഴുതുന്നത് പരാജയപ്പെട്ടു: ഒരു ബൈറ്റും സ്വീകരിച്ചില്ല."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "പോർട്ട് {port} ലേക്ക് എഴുതുന്നത് പരാജയപ്പെട്ടു: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "പോർട്ട് {port} ഡ്രെയിൻ ചെയ്യുന്നത് തുടർച്ചയായി {count} തവണ തടസ്സപ്പെട്ടു: സന്ദേശം കെർണലിനെ ഏൽപ്പിച്ചിട്ടുണ്ട്, പക്ഷേ അതിന്റെ പുറപ്പാടിനായി കാത്തിരിക്കാൻ കഴിഞ്ഞില്ല."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "കാത്തിരിപ്പ് പരിധിക്ക് പുറത്താണ്: {wait} സെക്കൻഡ് (പരമാവധി {max} സെക്കൻഡ്)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "വായിക്കാൻ കഴിയില്ല: പോർട്ട് അടച്ചിരിക്കുന്നു."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "പോർട്ട് {port} ൽ നിന്ന് വായിക്കുന്നത് പരാജയപ്പെട്ടു: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "പോർട്ട് {port} അതിന്റെ ഇൻപുട്ടിന്റെ അവസ്ഥ റിപ്പോർട്ട് ചെയ്യുന്നില്ല ({error}): ബൈറ്റ് നഷ്ടം കണ്ടെത്താൻ കഴിയില്ല, ഇവിടെ നിർത്തുന്നു."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "പോർട്ട് {port} ന്റെ അവസ്ഥ വായിക്കുന്നത് പരാജയപ്പെട്ടു: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "പോർട്ട് {port} അടയ്ക്കുന്നത് പരാജയപ്പെട്ടു: {error}"
