#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "მოსალოდნელია ცნობილი ფუნქციების დალაგებული სია, დუბლიკატების გარეშე"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "წაუკითხავი საცდელი რეესტრი: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "საცდელი რეესტრი დაბლოკილია სხვა პროცესის მიერ ({file}): სცადეთ ხელახლა, როცა მეორე ბრძანება დასრულდება."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "{file}-ის დაბლოკვა შეუძლებელია: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "პედალი ვერ მოიძებნა: ხმის ბარათი „NAI5“ არ არის. შეამოწმეთ USB კაბელი."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR არ არის დაყენებული: საკეტის აღება შეუძლებელია."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "საკეტის {file} აღება შეუძლებელია: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "პედალს უკვე იყენებს optima-air-ის სხვა ეგზემპლარი."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "საკეტი უკვე გათავისუფლებულია: მისი პორტისთვის გადაცემა აღარ შეიძლება."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "ეს საკეტი უკვე ეკუთვნის პორტს: მეორე პორტისთვის გადაცემა შეუძლებელია."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "საკეტის გათავისუფლება შეუძლებელია: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "პედალი აღარ პასუხობს: გამორთულია ან გაჩერდა."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "პორტის {port} კონფიგურაცია შეუძლებელია: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "პორტის {port} შესასვლელის გააქტიურება შეუძლებელია: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "პორტი {port} არ არსებობს."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "წვდომა {port}-ზე უარყოფილია. შეამოწმეთ, რომ ხართ „audio“ ჯგუფში (ბრძანება: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "პორტს {port} უკვე იყენებს სხვა პროგრამა."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "პორტი {port} აღარ არის ხელმისაწვდომი."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "პორტის {port} გახსნა შეუძლებელია: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "ჩაწერა შეუძლებელია: პორტი დაკეტილია."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "პორტში {port} ჩაწერა ვერ მოხერხდა: არც ერთი ბაიტი არ მიიღეს."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "პორტში {port} ჩაწერა ვერ მოხერხდა: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "პორტის {port} დაცლა თანმიმდევრულად {count}-ჯერ შეწყდა: შეტყობინება გადაეცა ბირთვს, მაგრამ მისი გაგზავნის მოლოდინი ვერ მოხერხდა."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "მოლოდინი დიაპაზონს გარეთაა: {wait} წმ (მაქსიმუმ {max} წმ)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "წაკითხვა შეუძლებელია: პორტი დაკეტილია."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "პორტიდან {port} წაკითხვა ვერ მოხერხდა: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "პორტი {port} არ აცხადებს შესასვლელის მდგომარეობას ({error}): ბაიტების დაკარგვის აღმოჩენა შეუძლებელია, აქ ჩერდება."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "პორტის {port} მდგომარეობის წაკითხვა ვერ მოხერხდა: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "პორტის {port} დახურვა ვერ მოხერხდა: {error}"
