msgstr "Osi {port} gearggusmahttin gaskkalduhttojuvvui {count} geardde čuovvovaččat: reive lea addojuvvon ytimii, muhto dan vuolggaha ii sáhttán vuordit."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Vuordin lea olggobealde viidodaga: {wait} s (eanemus {max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Ii sáhte lohkat: ossi lea giddejuvvon."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Lohkan osis {port} ii lihkostuvvan: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Ossi {port} ii dieđit sisa dili ({error}): byte-massin ii sáhte gávdnot, bisána dás."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Osi {port} dili lohkan ii lihkostuvvan: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Osi {port} gidden ii lihkostuvvan: {error}"
