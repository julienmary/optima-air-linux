msgstr "NUX SysEx тақырыбы жоқ"

#: src/optima_air/messages_reception.py
msgid "no final F7"
msgstr "соңғы F7 жоқ"

#: src/optima_air/messages_reception.py
msgid "byte outside 7 bits"
msgstr "7 биттен тыс байт"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "type {found} instead of {expected}"
msgstr "{expected} орнына {found} түрі"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "command {found} instead of {expected}"
msgstr "{expected} орнына {found} пәрмені"

#: src/optima_air/messages_reception.py
msgid "unexpected upload acknowledgement"
msgstr "жүктеуді күтпеген растау"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unknown acknowledgement status: {status}"
msgstr "растаудың белгісіз күйі: {status}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected version answer: {error}"
msgstr "нұсқаның күтпеген жауабы: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "command {command}: only 0x5c (info read) and 0x5b (name echo) carry slot info"
msgstr "{command} пәрмені: слот туралы ақпаратты тек 0x5c (ақпаратты оқу) және 0x5b (атау жаңғырығы) тасымалдайды"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "encoded length {found} instead of {expected}"
msgstr "кодталған ұзындық {expected} орнына {found}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected slot info answer: {error}"
msgstr "слот туралы ақпараттың күтпеген жауабы: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unreadable slot info: {error}"
msgstr "оқылмайтын слот туралы ақпарат: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "the pedal announces slot {slot}"
msgstr "педаль {slot} слотын хабарлайды"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected answer for table {table}: {error}"
msgstr "{table} кестесі үшін күтпеген жауап: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "table {table}: value {value} above 100"
msgstr "кесте {table}: {value} мәні 100-ден жоғары"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected state answer: {error}"
msgstr "күйдің күтпеген жауабы: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "read header: command {found} instead of {expected}"
msgstr "оқу тақырыбы: {expected} орнына {found} пәрмені"

#: src/optima_air/messages_reception.py
msgid "read header carries the end flag"
msgstr "оқу тақырыбында аяқтау жалауы бар"

#: src/optima_air/messages_reception.py
msgid "non-zero read header, never seen in this form"
msgstr "нөлдік емес оқу тақырыбы, мұндай пішімде ешқашан көрілмеген"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: command {found} instead of {expected}"
msgstr "блок {block}: {expected} орнына {found} пәрмені"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: non-zero flag {flag}"
msgstr "блок {block}: нөлдік емес жалау {flag}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: address {found} instead of {expected}"
msgstr "блок {block}: {expected} орнына {found} мекенжайы"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: counter {found} instead of {expected}"
msgstr "блок {block}: {expected} орнына {found} санауышы"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block} unreadable: {error}"
msgstr "блок {block} оқылмайды: {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: command {found} instead of {expected}"
msgstr "аяқтау блогы: {expected} орнына {found} пәрмені"

#: src/optima_air/messages_reception.py
msgid "end block without flag"
msgstr "жалаусыз аяқтау блогы"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: counter {found} instead of {expected}"
msgstr "аяқтау блогы: {expected} орнына {found} санауышы"

#: src/optima_air/messages_reception.py
msgid "end block: stray byte outside the flag, the sum and the counter"
msgstr "аяқтау блогы: жалау, қосынды және санауыштан тыс бөтен байт"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unreadable end sum: {error}"
msgstr "оқылмайтын аяқтау қосындысы: {error}"

#: src/optima_air/messages_reception.py
msgid "wrong end-of-read sum"
msgstr "оқу соңының қосындысы қате"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "footer: command {found} instead of {expected}"
msgstr "төменгі деректеме: {expected} орнына {found} пәрмені"

#: src/optima_air/messages_reception.py
msgid "footer without flag"
msgstr "жалаусыз төменгі деректеме"

#: src/optima_air/messages_reception.py
msgid "footer: stray byte after the flag"
msgstr "төменгі деректеме: жалаудан кейін бөтен байт"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "{count} messages received instead of {expected}"
msgstr "{expected} орнына {count} хабар алынды"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "message {number} foreign to an IR read: {error}"
msgstr "{number} хабары IR оқуына жат: {error}"

#: src/optima_air/preferences.py
msgid "colour {colour!r}: lowercase “#rrggbb” expected"
msgstr "{colour!r} түсі: кіші әріпті “#rrggbb” күтілді"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unknown function “{name}”. Known: {known}."
msgstr "Белгісіз функция “{name}”. Белгілілері: {known}."

#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "қайталанбайтын, сұрыпталған белгілі функциялар тізімі күтілді"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "Оқылмайтын сынақ тізілімі: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "Сынақ тізілімін басқа процесс құлыптаған ({file}): басқа пәрмен аяқталғаннан кейін қайталап көріңіз."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "{file} құлыптау мүмкін емес: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "Педаль табылмады: “NAI5” дыбыс картасы жоқ. USB кабелін тексеріңіз."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR орнатылмаған: құлыпты алу мүмкін емес."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "{file} құлпын алу мүмкін емес: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "Педальді optima-air-дің басқа данасы пайдаланып жатыр."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "Құлып бұрын босатылған: енді оны портқа беру мүмкін емес."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Бұл құлып бұрыннан портқа тиесілі: оны екінші портқа беру мүмкін емес."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Құлыпты босату мүмкін емес: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Педаль енді жауап бермейді: ажыратылған немесе қатып қалған."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "{port} портын баптау мүмкін емес: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "{port} портының кірісін іске қосу мүмкін емес: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "{port} порты жоқ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port} портына кіруге тыйым салынды. “audio” тобында екеніңізді тексеріңіз (пәрмен: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "{port} портын басқа бағдарлама пайдаланып жатыр."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "{port} порты енді қолжетімсіз."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "{port} портын ашу мүмкін емес: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Жазу мүмкін емес: порт жабық."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "{port} портына жазу сәтсіз аяқталды: бірде-бір байт қабылданбады."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "{port} портына жазу сәтсіз аяқталды: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "{port} портын босату қатарынан {count} рет үзілді: хабар ядроға берілді, бірақ оның жөнелтілуін күтуге болмады."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Күту ауқымнан тыс: {wait} с (ең көбі {max} с)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Оқу мүмкін емес: порт жабық."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "{port} портынан оқу сәтсіз аяқталды: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "{port} порты кірісінің күйін хабарламайды ({error}): байттардың жоғалуын анықтау мүмкін емес, осы жерде тоқтатылады."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "{port} портының күйін оқу сәтсіз аяқталды: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "{port} портын жабу сәтсіз аяқталды: {error}"
