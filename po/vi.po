msgstr "Chức năng không xác định “{name}”. Đã biết: {known}."

#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "cần một danh sách các chức năng đã biết, đã sắp xếp và không trùng lặp"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "Không đọc được sổ đăng ký thử nghiệm: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "Sổ đăng ký thử nghiệm đang bị khóa bởi một tiến trình khác ({file}): hãy thử lại khi lệnh kia đã chạy xong."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "Không thể khóa {file}: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "Không tìm thấy pedal: không có card âm thanh “NAI5”. Hãy kiểm tra cáp USB."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR chưa được đặt: không thể lấy khóa."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "Không thể lấy khóa {file}: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "Pedal đang được một phiên bản optima-air khác sử dụng."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "Khóa đã được nhả: không thể giao cho một cổng nữa."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Khóa này đã thuộc về một cổng: không thể giao cho cổng thứ hai."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Không thể nhả khóa: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Pedal không còn phản hồi: bị rút ra hoặc bị treo."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "Không thể cấu hình cổng {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "Không thể chuẩn bị đầu vào của cổng {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Cổng {port} không tồn tại."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Truy cập {port} bị từ chối. Hãy kiểm tra bạn có thuộc nhóm “audio” không (lệnh: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Cổng {port} đang được chương trình khác sử dụng."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Cổng {port} không còn khả dụng."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Không thể mở cổng {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Không thể ghi: cổng đã đóng."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Ghi vào cổng {port} thất bại: không có byte nào được chấp nhận."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Ghi vào cổng {port} thất bại: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Việc xả cổng {port} bị gián đoạn {count} lần liên tiếp: thông điệp đã được giao cho nhân hệ điều hành, nhưng không thể chờ nó được gửi đi."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Thời gian chờ nằm ngoài phạm vi: {wait} giây (tối đa {max} giây)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Không thể đọc: cổng đã đóng."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Đọc từ cổng {port} thất bại: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Cổng {port} không báo cáo trạng thái đầu vào ({error}): không thể phát hiện mất byte, dừng tại đây."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Đọc trạng thái của cổng {port} thất bại: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Đóng cổng {port} thất bại: {error}"
