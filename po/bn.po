msgid "footer without flag"
msgstr "ফুটারে ফ্ল্যাগ নেই"

#: src/optima_air/messages_reception.py
msgid "footer: stray byte after the flag"
msgstr "ফুটার: ফ্ল্যাগের পরে বাড়তি বাইট"

#: src/optima_air/messages_reception.py
#, python-brace-format
