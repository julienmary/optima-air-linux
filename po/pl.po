msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Opróżnianie portu {port} zostało przerwane {count} razy z rzędu: komunikat został przekazany jądru, ale nie udało się poczekać na jego wysłanie."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Czas oczekiwania poza zakresem: {wait} s (maksymalnie {max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Nie można odczytać: port jest zamknięty."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Odczyt z portu {port} nie powiódł się: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Port {port} nie zgłasza stanu swojego wejścia ({error}): utraty bajtów nie można wykryć, zatrzymanie w tym miejscu."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Odczyt stanu portu {port} nie powiódł się: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Zamknięcie portu {port} nie powiodło się: {error}"
