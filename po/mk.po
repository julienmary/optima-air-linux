#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "Нечитлив регистар на проби: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "Регистарот на проби е заклучен од друг процес ({file}): обидете се повторно кога другата команда ќе заврши."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "Не може да се заклучи {file}: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "Педалата не е пронајдена: нема звучна картичка „NAI5“. Проверете го USB кабелот."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR не е поставена: не може да се земе заклучувањето."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "Не може да се земе заклучувањето {file}: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "Педалата веќе ја користи друга инстанца на optima-air."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "Заклучувањето е веќе ослободено: повеќе не може да се додели на порта."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Ова заклучување веќе припаѓа на порта: не може да се додели на втора."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Не може да се ослободи заклучувањето: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Педалата повеќе не одговара: исклучена или блокирана."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "Не може да се конфигурира портата {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "Не може да се активира влезот на портата {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Портата {port} не постои."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Пристапот до {port} е одбиен. Проверете дали сте во групата „audio“ (команда: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Портата {port} е веќе во употреба од друга програма."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Портата {port} повеќе не е достапна."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Не може да се отвори портата {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Не може да се запишува: портата е затворена."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Запишувањето на портата {port} не успеа: ниту еден бајт не е прифатен."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Запишувањето на портата {port} не успеа: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Испразнувањето на портата {port} беше прекинато {count} пати по ред: пораката е предадена на јадрото, но нејзиното заминување не можеше да се дочека."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Чекање надвор од опсегот: {wait} s (најмногу {max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Не може да се чита: портата е затворена."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Читањето од портата {port} не успеа: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Портата {port} не ја пријавува состојбата на својот влез ({error}): губењето бајти не може да се открие, се запира тука."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Читањето на состојбата на портата {port} не успеа: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Затворањето на портата {port} не успеа: {error}"
