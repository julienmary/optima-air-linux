#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "A(z) {port} portot már egy másik program használja."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "A(z) {port} port már nem érhető el."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "A(z) {port} port nem nyitható meg: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Nem lehet írni: a port le van zárva."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Írás a(z) {port} portra sikertelen: egyetlen bájtot sem fogadott el."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Írás a(z) {port} portra sikertelen: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "A(z) {port} port ürítése {count} egymást követő alkalommal megszakadt: az üzenet átkerült a kernelhez, de elküldését nem lehetett kivárni."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "A várakozás tartományon kívül: {wait} mp (legfeljebb {max} mp)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Nem lehet olvasni: a port le van zárva."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Olvasás a(z) {port} portról sikertelen: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "A(z) {port} port nem jelzi bemenetének állapotát ({error}): a bájtvesztés nem észlelhető, itt megállunk."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "A(z) {port} port állapotának olvasása sikertelen: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "A(z) {port} port lezárása sikertelen: {error}"
