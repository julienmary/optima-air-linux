#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
msgstr "ប្រវែង {length} មិនមែនជាពហុគុណនៃ {block}"

#: src/optima_air/codec.py
#, python-brace-format
msgid "value {value} outside 28 bits"
msgstr "តម្លៃ {value} នៅក្រៅ 28 ប៊ីត"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a 28-bit sum takes 4 bytes, got {got}"
msgstr "ផលបូក 28 ប៊ីតប្រើ 4 បៃ ប៉ុន្តែទទួលបាន {got}"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits in a 28-bit sum"
msgstr "បៃ {byte} នៅក្រៅ 7 ប៊ីតក្នុងផលបូក 28 ប៊ីត"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write was interrupted: the pedal is left alone for another {seconds} s."
msgstr "ការសរសេរត្រូវបានរំខាន: នឹងមិនប៉ះពាល់ផេដាល់ទៀតរយៈពេល {seconds} វិនាទី"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: a write message can only be sent by a complete slot write (backup, journal, read back)."
msgstr "“{message}”: សារសរសេរអាចផ្ញើបានតែដោយការសរសេរទីតាំងពេញលេញប៉ុណ្ណោះ (ការបម្រុងទុក កំណត់ហេតុ ការអានត្រឡប់មកវិញ)"

#: src/optima_air/device.py
msgid "The firmware version has not been read yet: only reads are allowed."
msgstr "មិនទាន់បានអានកំណែហ្វឺមវែរទេ: អនុញ្ញាតតែការអានប៉ុណ្ណោះ"

#: src/optima_air/device.py
#, python-brace-format
msgid "Unknown firmware {found} (protocol verified on {verified}): only reads are allowed."
msgstr "ហ្វឺមវែរមិនស្គាល់ {found} (ប្រូតូកូលត្រូវបានផ្ទៀងផ្ទាត់លើ {verified}): អនុញ្ញាតតែការអានប៉ុណ្ណោះ"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}” is a trial function (“{function}”), not yet validated on the pedal."
msgstr "“{message}” ជាមុខងារសាកល្បង (“{function}”) ដែលមិនទាន់ត្រូវបានផ្ទៀងផ្ទាត់លើផេដាល់"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: only a read can be sent again."
msgstr "“{message}”: មានតែការអានប៉ុណ្ណោះដែលអាចផ្ញើម្តងទៀតបាន"

#: src/optima_air/device.py
#, python-brace-format
msgid "No answer from the pedal to “{message}” after {count} attempts."
msgstr "ផេដាល់មិនឆ្លើយតបនឹង “{message}” ក្រោយពីព្យាយាម {count} ដង"

#: src/optima_air/device.py
msgid "The pedal keeps sending SysEx without a break."
msgstr "ផេដាល់ផ្ញើ SysEx ជាប់រហូតមិនឈប់"

#: src/optima_air/device.py
#, python-brace-format
msgid "Cannot read slot {slot}: {error}"
msgstr "មិនអាចអានទីតាំង {slot}: {error}"

#: src/optima_air/device.py
#, python-brace-format
msgid "Two reads of slot {slot} give different data."
msgstr "ការអានទីតាំង {slot} ពីរដងផ្តល់ទិន្នន័យខុសគ្នា"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: wait another {seconds} s before sending anything."
msgstr "ការសរសេរទៅទីតាំង {slot} ត្រូវបានរំខាន: រង់ចាំ {seconds} វិនាទីទៀតមុននឹងផ្ញើអ្វីទាំងអស់"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: until that slot is put right, it is the only one that can be written."
msgstr "ការសរសេរទៅទីតាំង {slot} ត្រូវបានរំខាន: រហូតដល់ទីតាំងនោះត្រូវបានកែតម្រូវ វាជាទីតាំងតែមួយគត់ដែលអាចសរសេរបាន"

#: src/optima_air/device.py
msgid "Write refused: the firmware has not been read, or is not the one the protocol was verified on."
msgstr "ការសរសេរត្រូវបានបដិសេធ: មិនទាន់បានអានហ្វឺមវែរ ឬមិនមែនជាហ្វឺមវែរដែលប្រូតូកូលត្រូវបានផ្ទៀងផ្ទាត់"

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, slot {slot} does not hold what was sent."
msgstr "បន្ទាប់ពីការសរសេរ ទីតាំង {slot} មិនមានមាតិកាដូចអ្វីដែលបានផ្ញើទេ"

#: src/optima_air/device.py
msgid "The pedal reports an error while writing the IR."
msgstr "ផេដាល់រាយការណ៍កំហុសពេលសរសេរ IR"

#: src/optima_air/device.py
#, python-brace-format
msgid "Unexpected block acknowledgement: {status}."
msgstr "ការទទួលស្គាល់ប្លុកដែលមិននឹកស្មាន: {status}"

#: src/optima_air/device.py
#, python-brace-format
msgid "{count} block acknowledgement received instead of {expected}."
msgid_plural "{count} block acknowledgements received instead of {expected}."
msgstr[0] "បានទទួលការទទួលស្គាល់ប្លុក {count} ជំនួសឱ្យ {expected}"

#: src/optima_air/device.py
msgid "Header and footer acknowledgements missing or unexpected."
msgstr "ការទទួលស្គាល់ក្បាល និងជើងបាត់ ឬមិននឹកស្មាន"

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, the name echo came {count} time instead of once."
msgid_plural "After the write, the name echo came {count} times instead of once."
msgstr[0] "បន្ទាប់ពីការសរសេរ ការបន្ទរឈ្មោះមក {count} ដង ជំនួសឱ្យម្តង"

#: src/optima_air/device.py
msgid "After the write, the name echo does not match what was sent."
msgstr "បន្ទាប់ពីការសរសេរ ការបន្ទរឈ្មោះមិនត្រូវនឹងអ្វីដែលបានផ្ញើទេ"

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, the slot info came {count} time instead of once."
msgid_plural "After the write, the slot info came {count} times instead of once."
msgstr[0] "បន្ទាប់ពីការសរសេរ ព័ត៌មានទីតាំងមក {count} ដង ជំនួសឱ្យម្តង"

#: src/optima_air/device.py
msgid "After the write, the slot info does not match what was sent."
