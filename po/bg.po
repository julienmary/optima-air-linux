msgstr "Заключването вече е освободено: то не може да бъде предадено на порт."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Това заключване вече принадлежи на порт: не може да бъде предадено на втори."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Не може да се освободи заключването: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Педалът вече не отговаря: изключен е или е блокирал."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "Не може да се конфигурира портът {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "Не може да се активира входът на порт {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Портът {port} не съществува."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Достъпът до {port} е отказан. Проверете дали сте в групата „audio“ (команда: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Портът {port} вече се използва от друга програма."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Портът {port} вече не е наличен."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Не може да се отвори портът {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Не може да се пише: портът е затворен."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Записът в порт {port} не успя: нито един байт не е приет."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Записът в порт {port} не успя: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Изпразването на порт {port} беше прекъснато {count} пъти поред: съобщението е предадено на ядрото, но заминаването му не можа да бъде изчакано."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Изчакване извън диапазона: {wait} s (най-много {max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Не може да се чете: портът е затворен."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Четенето от порт {port} не успя: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Портът {port} не съобщава състоянието на входа си ({error}): загубата на байтове не може да бъде открита, спиране тук."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Четенето на състоянието на порт {port} не успя: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Затварянето на порт {port} не успя: {error}"
