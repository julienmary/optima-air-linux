#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots already identical to the backup: {slots}"
msgstr "ទីតាំងដែលដូចនឹងការបម្រុងទុករួចហើយ: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Rewrite slot {slot} “{current}” from the backup {backup} (“{name}”)?"
msgstr "សរសេរទីតាំង {slot} “{current}” ឡើងវិញពីការបម្រុងទុក {backup} (“{name}”) ឬ?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot} restored from {backup}, then read back identical."
msgstr "បានស្ដារទីតាំង {slot} ពី {backup} ហើយអានត្រឡប់មកវិញដូចគ្នា"

#: src/optima_air/cli.py
#, python-brace-format
