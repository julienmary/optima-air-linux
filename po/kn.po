#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: wait another {seconds} s before sending anything."
msgstr "ಸ್ಲಾಟ್ {slot} ಗೆ ಬರವಣಿಗೆ ಅಡ್ಡಿಪಡಿಸಲ್ಪಟ್ಟಿದೆ: ಏನನ್ನಾದರೂ ಕಳುಹಿಸುವ ಮೊದಲು ಇನ್ನೂ {seconds} ಸೆ ಕಾಯಿರಿ."

