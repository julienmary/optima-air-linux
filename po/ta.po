#: src/optima_air/archives.py
#, python-brace-format
msgid "Unknown backup reason “{reason}”."
msgstr "தெரியாத காப்புப்பிரதி காரணம் “{reason}”."

#: src/optima_air/archives.py
#, python-brace-format
msgid "firmware missing: only the reason “{reason}” allows it"
msgstr "ஃபர்ம்வேர் இல்லை: “{reason}” என்ற காரணம் மட்டுமே இதை அனுமதிக்கிறது"

#: src/optima_air/archives.py
#, python-brace-format
msgid "malformed backup name “{name}”"
msgstr "தவறான வடிவிலான காப்புப்பிரதி பெயர் “{name}”"

#: src/optima_air/archives.py
#, python-brace-format
msgid "reason “{reason}” differs from the one of the backup {name}, reason “{expected}”"
msgstr "காரணம் “{reason}” காப்புப்பிரதி {name} இன் காரணமான “{expected}” இலிருந்து வேறுபடுகிறது"

#: src/optima_air/archives.py
msgid "unreadable date {date!r}"
msgstr "படிக்க இயலாத தேதி {date!r}"

#: src/optima_air/archives.py
msgid "date {date!r} without time zone"
msgstr "நேர மண்டலம் இல்லாத தேதி {date!r}"

#: src/optima_air/archives.py
msgid "non-canonical date {date!r}"
msgstr "நியமமற்ற தேதி {date!r}"

#: src/optima_air/archives.py
msgid "date {date!r} differs from the time of the backup {name}"
msgstr "தேதி {date!r} காப்புப்பிரதி {name} இன் நேரத்திலிருந்து வேறுபடுகிறது"

#: src/optima_air/archives.py
#, python-brace-format
msgid "{field}: date expected, got {type}"
msgstr "{field}: தேதி எதிர்பார்க்கப்பட்டது, {type} கிடைத்தது"

#: src/optima_air/archives.py
#, python-brace-format
msgid "{field} must carry a time zone (for example datetime.now().astimezone())"
msgstr "{field} நேர மண்டலத்தைக் கொண்டிருக்க வேண்டும் (எடுத்துக்காட்டாக datetime.now().astimezone())"

#: src/optima_air/archives.py
#, python-brace-format
msgid "Cannot write in the folder {file}: {error}"
msgstr "கோப்புறை {file} இல் எழுத இயலவில்லை: {error}"

#: src/optima_air/archives.py
msgid "not a folder"
msgstr "கோப்புறை அல்ல"

#: src/optima_air/archives.py
#, python-brace-format
msgid "Cannot check {file}: {error}"
msgstr "{file} ஐச் சரிபார்க்க இயலவில்லை: {error}"

#: src/optima_air/archives.py
#, python-brace-format
msgid "Cannot create the backup {backup}: {error}"
msgstr "காப்புப்பிரதி {backup} ஐ உருவாக்க இயலவில்லை: {error}"

#: src/optima_air/archives.py
#, python-brace-format
msgid "data: bytes expected, got {type}"
msgstr "தரவு: பைட்டுகள் எதிர்பார்க்கப்பட்டது, {type} கிடைத்தது"

#: src/optima_air/archives.py src/optima_air/codec.py src/optima_air/ir.py
#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "an IR is {expected} bytes, got {got}"
msgstr "ஒரு IR என்பது {expected} பைட்டுகள், {got} கிடைத்தது"

#: src/optima_air/archives.py
#, python-brace-format
msgid "slot {slot} already backed up in {backup}: a backup is written only once, make a new backup."
msgstr "ஸ்லாட் {slot} ஏற்கெனவே {backup} இல் காப்புப் பிரதி எடுக்கப்பட்டுள்ளது: காப்புப்பிரதி ஒருமுறை மட்டுமே எழுதப்படும், புதிய காப்புப்பிரதியை உருவாக்கவும்."

#: src/optima_air/archives.py
#, python-brace-format
msgid "Unreadable slot record: {file} ({error})"
msgstr "படிக்க இயலாத ஸ்லாட் பதிவு: {file} ({error})"

