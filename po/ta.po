#, python-brace-format
msgid "slot name of {size} bytes instead of {expected}"
msgstr "{expected} பைட்டுகளுக்குப் பதிலாக {size} பைட்டுகள் கொண்ட ஸ்லாட் பெயர்"

#: src/optima_air/archives.py
#, python-brace-format
msgid "identifier {value} out of 0..{max}"
msgstr "அடையாளம் {value} 0..{max} வரம்புக்கு வெளியே உள்ளது"

#: src/optima_air/archives.py
#, python-brace-format
msgid "{field} {value} out of 0..{max}"
