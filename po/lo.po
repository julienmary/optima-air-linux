msgstr "ສຳຮອງທັງໝົດ"

#: src/optima_air/gui/fenetre.py
msgid "Backups…"
msgstr "ຂໍ້ມູນສຳຮອງ…"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "{value} kHz"
msgstr "{value} kHz"

#: src/optima_air/gui/fenetre.py
msgid "Load a WAV…"
msgstr "ໂຫຼດໄຟລ໌ WAV…"

#: src/optima_air/gui/fenetre.py
msgid "Export as WAV…"
msgstr "ສົ່ງອອກເປັນ WAV…"

#: src/optima_air/gui/fenetre.py
msgid "WAV files"
msgstr "ໄຟລ໌ WAV"

#: src/optima_air/gui/fenetre.py
msgid "Choose a WAV file"
msgstr "ເລືອກໄຟລ໌ WAV"

#: src/optima_air/gui/fenetre.py
msgid "One file at a time: a slot holds a single IR."
msgstr "ເທື່ອລະໄຟລ໌: ໜຶ່ງຊ່ອງເກັບ IR ໄດ້ພຽງໜຶ່ງລາຍການ"

#: src/optima_air/gui/fenetre.py
msgid "Export as WAV"
msgstr "ສົ່ງອອກເປັນ WAV"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Restore finished. Slots rewritten and read back identical: {rewritten}. Settings only: {settings}. Already identical to the backup: {unchanged}."
msgstr "ກູ້ຄືນສຳເລັດ ຊ່ອງທີ່ຂຽນໃໝ່ແລະອ່ານກັບຄືນແລ້ວກົງກັນ: {rewritten} ສະເພາະການຕັ້ງຄ່າ: {settings} ກົງກັບຂໍ້ມູນສຳຮອງຢູ່ແລ້ວ: {unchanged}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it still holds what it held before. Nothing to do."
msgstr "ຊ່ອງ {slot}: ຫຼັງການຂຽນທີ່ຖືກຂັດຂວາງ ຍັງຄົງມີເນື້ອຫາເດີມກ່ອນໜ້ານີ້ ບໍ່ຕ້ອງເຮັດຫຍັງ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it holds neither the old nor the new content. Until it is put right, it is the only slot that can be written."
msgstr "ຊ່ອງ {slot}: ຫຼັງການຂຽນທີ່ຖືກຂັດຂວາງ ເນື້ອຫາບໍ່ແມ່ນທັງຂອງເກົ່າແລະຂອງໃໝ່ ຈົນກວ່າຈະແກ້ໄຂຊ່ອງນີ້ ຈະຂຽນໄດ້ສະເພາະຊ່ອງນີ້ຊ່ອງດຽວ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: {name}"
msgstr "ຊ່ອງ {slot}: {name}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical. Previous content backed up in {backup}"
msgstr "ຊ່ອງ {slot}: ຂຽນ “{name}” ແລ້ວ ແລະອ່ານກັບຄືນແລ້ວກົງກັນ ເນື້ອຫາເດີມຖືກສຳຮອງໄວ້ໃນ {backup}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot}…"
msgstr "ກຳລັງຂຽນຊ່ອງ {slot}…"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot} failed: {reason} The pedal is left alone for {seconds} s, then the state of the slot will be checked."
msgstr "ຂຽນຊ່ອງ {slot} ບໍ່ສຳເລັດ: {reason} ຈະບໍ່ແຕະຕ້ອງເພດັລ {seconds} ວິນາທີ ຈາກນັ້ນຈະກວດສອບສະຖານະຂອງຊ່ອງ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The backup failed: {reason}"
msgstr "ການສຳຮອງຂໍ້ມູນລົ້ມເຫຼວ: {reason}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The restore stopped: {reason} The slots already handled are in order; the state of the pedal will be read again."
msgstr "ການກູ້ຄືນຢຸດລົງ: {reason} ຊ່ອງທີ່ຈັດການໄປແລ້ວຢູ່ໃນສະພາບຮຽບຮ້ອຍ ແລະຈະອ່ານສະຖານະຂອງເພດັລອີກເທື່ອ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Connected, firmware {version}"
msgstr "ເຊື່ອມຕໍ່ແລ້ວ ເຟີມແວ {version}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Disconnected: {reason}"
msgstr "ຕັດການເຊື່ອມຕໍ່: {reason}"

#: src/optima_air/gui/fenetre.py
msgid "Warning: the identifier announced by the pedal does not match the data read."
msgstr "ຄຳເຕືອນ: ຕົວລະບຸທີ່ເພດັລປະກາດມາບໍ່ກົງກັບຂໍ້ມູນທີ່ອ່ານໄດ້"

#: src/optima_air/gui/travail.py
msgid "Stop requested."
msgstr "ຮ້ອງຂໍໃຫ້ຢຸດແລ້ວ"

#: src/optima_air/gui/travail.py
msgid "Backup"
msgstr "ສຳຮອງຂໍ້ມູນ"

#: src/optima_air/ir.py
msgid "invalid frequency range or number of points"
msgstr "ຊ່ວງຄວາມຖີ່ ຫຼື ຈຳນວນຈຸດບໍ່ຖືກຕ້ອງ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Unreadable audio file: {file} ({error})"
msgstr "ອ່ານໄຟລ໌ສຽງບໍ່ໄດ້: {file} ({error})"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file has {count} channels: only the first one is kept."
msgstr "ໄຟລ໌ມີ {count} ແຊນແນລ: ເກັບໄວ້ສະເພາະແຊນແນລທຳອິດ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Empty audio file: {file}"
msgstr "ໄຟລ໌ສຽງຫວ່າງເປົ່າ: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file contains non-finite samples: {file}"
msgstr "ໄຟລ໌ມີຕົວຢ່າງສຽງທີ່ບໍ່ແມ່ນຄ່າຈຳກັດ: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Sample rate of {rate} Hz: the file was resampled to {target} kHz."
msgstr "ອັດຕາສຸ່ມຕົວຢ່າງ {rate} Hz: ໄຟລ໌ຖືກສຸ່ມຕົວຢ່າງໃໝ່ເປັນ {target} kHz"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file lasts {duration} ms: only the first {count} samples ({limit} ms) are kept."
msgstr "ໄຟລ໌ຍາວ {duration} ms: ເກັບໄວ້ສະເພາະ {count} ຕົວຢ່າງທຳອິດ ({limit} ms)"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The pedal only plays the first {count} samples ({limit} ms): the rest of this IR will be stored but not heard."
msgstr "ເພດັລຫຼິ້ນສະເພາະ {count} ຕົວຢ່າງທຳອິດ ({limit} ms): ສ່ວນທີ່ເຫຼືອຂອງ IR ນີ້ຈະຖືກເກັບໄວ້ແຕ່ຈະບໍ່ໄດ້ຍິນ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Cannot normalise {file}: no signal between 400 Hz and 3 kHz."
msgstr "ນໍມັລໄລຊ໌ {file} ບໍ່ໄດ້: ບໍ່ມີສັນຍານລະຫວ່າງ 400 Hz ເຖິງ 3 kHz"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Normalising {file} exceeds the range of floating-point numbers."
msgstr "ການນໍມັລໄລຊ໌ {file} ເກີນຂອບເຂດຂອງຈຳນວນທົດສະນິຍົມແບບລອຍ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "After normalisation, the IR peaks at {peak} (usual IRs stay below 10): the file has a very deep dip between 400 Hz and 3 kHz, and the output level may be very high."
msgstr "ຫຼັງການນໍມັລໄລຊ໌ IR ມີຄ່າສູງສຸດ {peak} (IR ທົ່ວໄປຢູ່ຕ່ຳກວ່າ 10): ໄຟລ໌ມີຮ່ອງເລິກຫຼາຍລະຫວ່າງ 400 Hz ເຖິງ 3 kHz ແລະລະດັບສຽງອອກອາດສູງຫຼາຍ"

#: src/optima_air/journal.py
msgid "a journal date must carry a time zone"
msgstr "ວັນທີຂອງບັນທຶກການຂຽນຕ້ອງມີເຂດເວລາ"

#: src/optima_air/journal.py
msgid "slot out of range"
msgstr "ຊ່ອງຢູ່ນອກຂອບເຂດ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone expected"
msgstr "{field}: ຕ້ອງເປັນວັນທີ ISO ທີ່ມີເຂດເວລາ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: ISO date with time zone, or null, expected"
msgstr "{field}: ຕ້ອງເປັນວັນທີ ISO ທີ່ມີເຂດເວລາ ຫຼື null"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: backup folder name expected"
msgstr "{field}: ຕ້ອງເປັນຊື່ໂຟລເດີຂໍ້ມູນສຳຮອງ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 64 hexadecimal digits expected"
msgstr "{field}: ຕ້ອງເປັນເລກຖານສິບຫົກ 64 ຫຼັກ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: 32 bytes in hexadecimal expected"
msgstr "{field}: ຕ້ອງເປັນ 32 ໄບຕ໌ໃນຮູບເລກຖານສິບຫົກ"

#: src/optima_air/journal.py
msgid "identifier out of range"
msgstr "ຕົວລະບຸຢູ່ນອກຂອບເຂດ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "{field}: boolean expected"
msgstr "{field}: ຕ້ອງເປັນຄ່າບູລີນ"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Unreadable write journal: {file} ({error})"
msgstr "ອ່ານບັນທຶກການຂຽນບໍ່ໄດ້: {file} ({error})"

#: src/optima_air/journal.py
#, python-brace-format
msgid "Cannot remove the journal {file}: {error}"
msgstr "ລຶບບັນທຶກການຂຽນ {file} ບໍ່ໄດ້: {error}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "MD5 of {size} bytes instead of {expected}"
msgstr "MD5 ຂະໜາດ {size} ໄບຕ໌ ແທນທີ່ຈະເປັນ {expected}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "encoded block of {size} bytes instead of {expected}"
msgstr "ບລັອກທີ່ເຂົ້າລະຫັດຂະໜາດ {size} ໄບຕ໌ ແທນທີ່ຈະເປັນ {expected}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: malformed Control Change"
msgstr "ຂໍ້ຄວາມ “{message}”: Control Change ບໍ່ຖືກຕ້ອງ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: a Control Change is a setting"
msgstr "ຂໍ້ຄວາມ “{message}”: Control Change ຄືການຕັ້ງຄ່າ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: Control Change not in the closed list"
msgstr "ຂໍ້ຄວາມ “{message}”: Control Change ບໍ່ຢູ່ໃນລາຍການປິດ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: value {value} above {max}"
msgstr "ຂໍ້ຄວາມ “{message}”: ຄ່າ {value} ເກີນ {max}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}” badly framed"
msgstr "ຂໍ້ຄວາມ “{message}” ມີການຈັດເຟຣມບໍ່ຖືກຕ້ອງ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: byte outside 7 bits"
msgstr "ຂໍ້ຄວາມ “{message}”: ໄບຕ໌ຢູ່ນອກ 7 ບິດ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}” not in the closed list"
msgstr "ຂໍ້ຄວາມ “{message}” ບໍ່ຢູ່ໃນລາຍການປິດ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: {size} bytes instead of {expected}"
msgstr "ຂໍ້ຄວາມ “{message}”: {size} ໄບຕ໌ ແທນທີ່ຈະເປັນ {expected}"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "message “{message}”: {error}"
msgstr "ຂໍ້ຄວາມ “{message}”: {error}"

#: src/optima_air/messages_emission.py
msgid "unexpected version request"
msgstr "ຄຳຂໍເວີຊັນທີ່ບໍ່ຄາດຄິດ"

#: src/optima_air/messages_emission.py
msgid "only the announcement 70 05 01, on trial, is allowed"
msgstr "ອະນຸຍາດສະເພາະຂໍ້ຄວາມປະກາດ 70 05 01 ເຊິ່ງຢູ່ລະຫວ່າງການທົດລອງ"

#: src/optima_air/messages_emission.py
msgid "only the read 70 26 7F is allowed"
msgstr "ອະນຸຍາດສະເພາະການອ່ານ 70 26 7F"

#: src/optima_air/messages_emission.py
msgid "table request with a non-zero body"
msgstr "ຄຳຂໍຕາຕະລາງທີ່ມີເນື້ອຫາບໍ່ເປັນສູນ"

#: src/optima_air/messages_emission.py
msgid "table write: setting expected, values from 0 to 100"
msgstr "ການຂຽນຕາຕະລາງ: ຕ້ອງເປັນການຕັ້ງຄ່າ ຄ່າແຕ່ 0 ເຖິງ 100"

#: src/optima_air/messages_emission.py
msgid "malformed read request"
msgstr "ຄຳຂໍອ່ານບໍ່ຖືກຕ້ອງ"

#: src/optima_air/messages_emission.py
msgid "slot out of range or non-zero body"
msgstr "ຊ່ອງຢູ່ນອກຂອບເຂດ ຫຼື ເນື້ອຫາບໍ່ເປັນສູນ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "command {command} without a content rule"
msgstr "ຄຳສັ່ງ {command} ບໍ່ມີກົດຂອງເນື້ອຫາ"

#: src/optima_air/messages_emission.py
msgid "upload message outside the write category"
msgstr "ຂໍ້ຄວາມອັບໂຫຼດຢູ່ນອກໝວດການຂຽນ"

#: src/optima_air/messages_emission.py
#, python-brace-format
msgid "write command {command} without a content rule"
msgstr "ຄຳສັ່ງຂຽນ {command} ບໍ່ມີກົດຂອງເນື້ອຫາ"

#: src/optima_air/messages_emission.py
msgid "malformed slot name"
msgstr "ຊື່ຊ່ອງບໍ່ຖືກຕ້ອງ"

#: src/optima_air/messages_emission.py
msgid "identifier with bit 31 set (factory IR): function not yet open"
msgstr "ຕົວລະບຸທີ່ຕັ້ງບິດ 31 (IR ຈາກໂຮງງານ): ຟັງຊັນຍັງບໍ່ເປີດໃຫ້ໃຊ້"

#: src/optima_air/messages_emission.py
msgid "upload header: slot out of range"
msgstr "ສ່ວນຫົວຂອງການອັບໂຫຼດ: ຊ່ອງຢູ່ນອກຂອບເຂດ"

#: src/optima_air/messages_emission.py
msgid "upload header: MD5 outside lowercase hexadecimal digits"
msgstr "ສ່ວນຫົວຂອງການອັບໂຫຼດ: MD5 ມີຕົວອັກສອນນອກເລກຖານສິບຫົກຕົວພິມນ້ອຍ"

#: src/optima_air/messages_emission.py
msgid "upload header outside the observed form"
msgstr "ສ່ວນຫົວຂອງການອັບໂຫຼດຢູ່ນອກຮູບແບບທີ່ສັງເກດພົບ"

