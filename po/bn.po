msgid "Slot {slot} “{name}” exported to {file}"
msgstr "স্লট {slot} “{name}” {file}-এ এক্সপোর্ট করা হয়েছে"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Reading: {done} of {total}…"
msgstr "পড়া হচ্ছে: {total}-এর মধ্যে {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Warning: the identifier announced for slot {slot} does not match the data read, even after reading again. It is backed up anyway."
msgstr "সতর্কতা: স্লট {slot}-এর জন্য ঘোষিত শনাক্তকারী পড়া ডেটার সঙ্গে মেলে না, আবার পড়ার পরেও। তবুও ব্যাকআপ নেওয়া হয়েছে।"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "All 23 slots are backed up in {backup}"
msgstr "সব 23টি স্লট {backup}-এ ব্যাকআপ করা হয়েছে"

#: src/optima_air/cli.py
msgid "No backups."
msgstr "কোনো ব্যাকআপ নেই।"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{count} slot"
msgid_plural "{count} slots"
msgstr[0] "{count}টি স্লট"
msgstr[1] "{count}টি স্লট"

#: src/optima_air/cli.py
#, python-brace-format
msgid "DAMAGED ({error})"
msgstr "ক্ষতিগ্রস্ত ({error})"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
msgid "none"
msgstr "কোনোটি নয়"

#: src/optima_air/cli.py
msgid "--name only applies to restoring a single slot."
msgstr "--name শুধুমাত্র একটি একক স্লট পুনরুদ্ধারের ক্ষেত্রে প্রযোজ্য।"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Put the pedal back to the state of the backup {backup} ({count} slot)? Only the slots that differ will be rewritten, after their content is backed up."
msgid_plural "Put the pedal back to the state of the backup {backup} ({count} slots)? Only the slots that differ will be rewritten, after their content is backed up."
msgstr[0] "প্যাডেলকে ব্যাকআপ {backup}-এর অবস্থায় ফিরিয়ে আনবেন ({count}টি স্লট)? শুধুমাত্র যে স্লটগুলি ভিন্ন সেগুলিই আবার লেখা হবে, সেগুলির বিষয়বস্তু ব্যাকআপ করার পর।"
msgstr[1] "প্যাডেলকে ব্যাকআপ {backup}-এর অবস্থায় ফিরিয়ে আনবেন ({count}টি স্লট)? শুধুমাত্র যে স্লটগুলি ভিন্ন সেগুলিই আবার লেখা হবে, সেগুলির বিষয়বস্তু ব্যাকআপ করার পর।"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "{operation}: {done} of {total}…"
msgstr "{operation}: {total}-এর মধ্যে {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots rewritten and read back identical: {slots}"
msgstr "আবার লেখা এবং ফেরত পড়ে অভিন্ন পাওয়া স্লট: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots whose settings only were restored: {slots}"
msgstr "যেসব স্লটের শুধু সেটিংস পুনরুদ্ধার করা হয়েছে: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots already identical to the backup: {slots}"
msgstr "ব্যাকআপের সঙ্গে ইতিমধ্যে অভিন্ন স্লট: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Rewrite slot {slot} “{current}” from the backup {backup} (“{name}”)?"
msgstr "স্লট {slot} “{current}” কি ব্যাকআপ {backup} (“{name}”) থেকে আবার লিখবেন?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot} restored from {backup}, then read back identical."
msgstr "স্লট {slot} {backup} থেকে পুনরুদ্ধার করা হয়েছে, তারপর ফেরত পড়ে অভিন্ন পাওয়া গেছে।"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Replaced content (“{name}”) backed up in {backup}"
msgstr "প্রতিস্থাপিত বিষয়বস্তু (“{name}”) {backup}-এ ব্যাকআপ করা হয়েছে"

#: src/optima_air/cli.py
msgid "No interrupted write."
msgstr "কোনো বাধাপ্রাপ্ত লেখা নেই।"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: the interrupted write had completed. Nothing to do."
msgstr "স্লট {slot}: বাধাপ্রাপ্ত লেখা সম্পূর্ণ হয়েছিল। কিছু করার নেই।"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: it still holds what it held before. Nothing to do."
msgstr "স্লট {slot}: এতে এখনও আগের বিষয়বস্তুই আছে। কিছু করার নেই।"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: its content is neither the old nor the new one. To put it back as it was: optima-air restore {backup} {slot}"
msgstr "স্লট {slot}: এর বিষয়বস্তু না পুরনো, না নতুন। আগের অবস্থায় ফেরাতে: optima-air restore {backup} {slot}"

#: src/optima_air/cli.py
msgid "allow more than reads on a firmware that was not verified"
msgstr "যাচাই না করা ফার্মওয়্যারে শুধু পড়ার চেয়ে বেশি কিছুর অনুমতি দিন"

#: src/optima_air/cli.py
msgid "allow a trial function"
msgstr "পরীক্ষামূলক ফাংশনের অনুমতি দিন"

#: src/optima_air/cli.py
msgid "do not ask for confirmation"
msgstr "নিশ্চিতকরণ চাইবেন না"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count}"
msgstr "স্লট নম্বর, 1 থেকে {count}"

#: src/optima_air/cli.py
msgid "Linux editor for the NUX Optima Air pedal."
msgstr "NUX Optima Air প্যাডেলের জন্য Linux এডিটর।"

#: src/optima_air/cli.py
msgid "data folder (default: XDG data folder)"
msgstr "ডেটা ফোল্ডার (ডিফল্ট: XDG ডেটা ফোল্ডার)"

#: src/optima_air/cli.py
msgid "open the window"
msgstr "উইন্ডো খুলুন"

#: src/optima_air/cli.py
msgid "firmware version, preset and settings"
msgstr "ফার্মওয়্যার সংস্করণ, প্রিসেট ও সেটিংস"

#: src/optima_air/cli.py
msgid "the 23 IR slots"
msgstr "23টি IR স্লট"

#: src/optima_air/cli.py
msgid "back up the IR of a slot"
msgstr "একটি স্লটের IR ব্যাকআপ করুন"

#: src/optima_air/cli.py
msgid "print what the pedal sends"
msgstr "প্যাডেল যা পাঠায় তা প্রিন্ট করুন"

#: src/optima_air/cli.py
msgid "seconds of listening"
msgstr "শোনার সেকেন্ড"

#: src/optima_air/cli.py
msgid "read the state first"
msgstr "আগে অবস্থা পড়ুন"

#: src/optima_air/cli.py
msgid "send the announcement first (trial)"
msgstr "আগে ঘোষণা পাঠান (পরীক্ষামূলক)"

#: src/optima_air/cli.py
msgid "write a WAV into a slot"
msgstr "একটি স্লটে WAV লিখুন"

#: src/optima_air/cli.py
msgid "WAV file"
msgstr "WAV ফাইল"

#: src/optima_air/cli.py
msgid "name of the slot (default: the name of the file)"
msgstr "স্লটের নাম (ডিফল্ট: ফাইলের নাম)"

#: src/optima_air/cli.py
msgid "export a slot as WAV"
msgstr "একটি স্লট WAV হিসেবে এক্সপোর্ট করুন"

#: src/optima_air/cli.py
msgid "WAV file to write"
msgstr "লেখার জন্য WAV ফাইল"

#: src/optima_air/cli.py
msgid "rewrite a slot, or all of them, from a backup"
msgstr "ব্যাকআপ থেকে একটি স্লট, বা সবকটি, আবার লিখুন"

#: src/optima_air/cli.py
msgid "backup folder"
msgstr "ব্যাকআপ ফোল্ডার"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count} (default: all)"
msgstr "স্লট নম্বর, 1 থেকে {count} (ডিফল্ট: সব)"

#: src/optima_air/cli.py
msgid "replace the backed up name"
msgstr "ব্যাকআপ করা নামটি প্রতিস্থাপন করুন"

#: src/optima_air/cli.py
msgid "back up the 23 slots"
msgstr "23টি স্লট ব্যাকআপ করুন"

#: src/optima_air/cli.py
msgid "list the backups"
msgstr "ব্যাকআপগুলির তালিকা দেখান"

#: src/optima_air/cli.py
msgid "check an interrupted write"
msgstr "বাধাপ্রাপ্ত লেখা পরীক্ষা করুন"

#: src/optima_air/cli.py
msgid "register of the trial functions"
msgstr "পরীক্ষামূলক ফাংশনগুলির রেজিস্টার"

#: src/optima_air/cli.py
#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "স্লট {slot}-এ লেখা অসম্পূর্ণ থেকে গিয়েছিল। প্যাডেলটি কিছুক্ষণ একা ছেড়ে রাখা হয়েছে; তারপর চালান: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "ত্রুটি: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "বাধাপ্রাপ্ত।"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "বাইট {byte} 7 বিটের বাইরে"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "{count}টি 7-বিট বাইট {bits}টি প্যাডিং বিট রাখে, enc7 কখনও 6-এর বেশি তৈরি করে না"

#: src/optima_air/codec.py
msgid "non-zero padding bits at the end of a 7-bit stream"
msgstr "7-বিট স্ট্রিমের শেষে অশূন্য প্যাডিং বিট"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "একটি ব্লক {expected} বাইটের হয়, {got} পাওয়া গেছে"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "ব্লক যোগফল {sum} ({hex}) প্রেরিত 14 বিটের চেয়ে বড় (সর্বোচ্চ {max}): প্যাডেলে কখনও দেখা যায়নি, যাচাই না হওয়া পর্যন্ত প্রত্যাখ্যাত"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "একটি এনকোড করা ব্লক {expected} বাইটের হয়, {got} পাওয়া গেছে"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "এনকোড করা ব্লকে বাইট 7 বিটের বাইরে"

#: src/optima_air/codec.py
msgid "wrong block checksum"
msgstr "ব্লক চেকসাম ভুল"

#: src/optima_air/codec.py
msgid "the end-of-transfer sum covers at least one block"
msgstr "স্থানান্তর-সমাপ্তির যোগফল অন্তত একটি ব্লক কভার করে"

#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
msgstr "দৈর্ঘ্য {length} {block}-এর গুণিতক নয়"

#: src/optima_air/codec.py
#, python-brace-format
msgid "value {value} outside 28 bits"
msgstr "মান {value} 28 বিটের বাইরে"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a 28-bit sum takes 4 bytes, got {got}"
msgstr "একটি 28-বিট যোগফল 4 বাইট নেয়, {got} পাওয়া গেছে"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits in a 28-bit sum"
msgstr "28-বিট যোগফলে বাইট {byte} 7 বিটের বাইরে"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write was interrupted: the pedal is left alone for another {seconds} s."
msgstr "লেখা বাধাপ্রাপ্ত হয়েছে: প্যাডেলটি আরও {seconds} সেকেন্ড একা ছেড়ে রাখা হয়েছে।"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: a write message can only be sent by a complete slot write (backup, journal, read back)."
msgstr "“{message}”: লেখার বার্তা শুধুমাত্র একটি সম্পূর্ণ স্লট লেখার (ব্যাকআপ, জার্নাল, ফেরত পড়া) মাধ্যমেই পাঠানো যায়।"

#: src/optima_air/device.py
msgid "The firmware version has not been read yet: only reads are allowed."
msgstr "ফার্মওয়্যার সংস্করণ এখনও পড়া হয়নি: শুধু পড়ার অনুমতি আছে।"

#: src/optima_air/device.py
#, python-brace-format
msgid "Unknown firmware {found} (protocol verified on {verified}): only reads are allowed."
msgstr "অজানা ফার্মওয়্যার {found} (প্রোটোকল {verified}-এ যাচাই করা): শুধু পড়ার অনুমতি আছে।"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}” is a trial function (“{function}”), not yet validated on the pedal."
msgstr "“{message}” একটি পরীক্ষামূলক ফাংশন (“{function}”), প্যাডেলে এখনও যাচাই করা হয়নি।"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: only a read can be sent again."
msgstr "“{message}”: শুধু পড়ার বার্তাই আবার পাঠানো যায়।"

#: src/optima_air/device.py
#, python-brace-format
msgid "No answer from the pedal to “{message}” after {count} attempts."
msgstr "“{message}”-এর জন্য {count}বার চেষ্টার পরও প্যাডেল থেকে কোনো উত্তর আসেনি।"

#: src/optima_air/device.py
msgid "The pedal keeps sending SysEx without a break."
msgstr "প্যাডেল বিরতি ছাড়াই SysEx পাঠিয়ে যাচ্ছে।"

#: src/optima_air/device.py
#, python-brace-format
msgid "Cannot read slot {slot}: {error}"
msgstr "স্লট {slot} পড়া যাচ্ছে না: {error}"

#: src/optima_air/device.py
#, python-brace-format
msgid "Two reads of slot {slot} give different data."
msgstr "স্লট {slot}-এর দুটি পাঠ ভিন্ন ডেটা দেয়।"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: wait another {seconds} s before sending anything."
msgstr "স্লট {slot}-এ লেখা বাধাপ্রাপ্ত হয়েছে: কিছু পাঠানোর আগে আরও {seconds} সেকেন্ড অপেক্ষা করুন।"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write to slot {slot} was interrupted: until that slot is put right, it is the only one that can be written."
msgstr "স্লট {slot}-এ লেখা বাধাপ্রাপ্ত হয়েছে: সেই স্লট ঠিক না করা পর্যন্ত কেবল সেটিতেই লেখা যায়।"

#: src/optima_air/device.py
msgid "Write refused: the firmware has not been read, or is not the one the protocol was verified on."
msgstr "লেখা প্রত্যাখ্যাত: ফার্মওয়্যার পড়া হয়নি, অথবা প্রোটোকল যে ফার্মওয়্যারে যাচাই করা হয়েছিল এটি সেটি নয়।"

#: src/optima_air/device.py
#, python-brace-format
msgid "After the write, slot {slot} does not hold what was sent."
msgstr "লেখার পরে, স্লট {slot}-এ যা পাঠানো হয়েছিল তা নেই।"

#: src/optima_air/device.py
msgid "The pedal reports an error while writing the IR."
msgstr "IR লেখার সময় প্যাডেল একটি ত্রুটি জানাচ্ছে।"

#: src/optima_air/device.py
#, python-brace-format
msgid "Unexpected block acknowledgement: {status}."
msgstr "ব্লকের অপ্রত্যাশিত স্বীকৃতি: {status}।"

#: src/optima_air/device.py
#, python-brace-format
msgid "{count} block acknowledgement received instead of {expected}."
msgid_plural "{count} block acknowledgements received instead of {expected}."
msgstr[0] "{expected}টির পরিবর্তে {count}টি ব্লক স্বীকৃতি পাওয়া গেছে।"
