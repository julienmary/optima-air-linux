#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "ట్రయల్ రిజిస్టర్ మరొక ప్రాసెస్ ద్వారా లాక్ చేయబడింది ({file}): ఆ కమాండ్ పూర్తయిన తర్వాత మళ్లీ ప్రయత్నించండి."

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "{file}ను లాక్ చేయడం సాధ్యం కాదు: {error}"

