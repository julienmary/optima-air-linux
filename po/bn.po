msgstr "{expected}-এর পরিবর্তে {count}টি বার্তা পাওয়া গেছে"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "message {number} foreign to an IR read: {error}"
msgstr "বার্তা {number} IR পড়ার সঙ্গে সম্পর্কহীন: {error}"

#: src/optima_air/preferences.py
msgid "colour {colour!r}: lowercase “#rrggbb” expected"
msgstr "রং {colour!r}: ছোট হাতের “#rrggbb” প্রত্যাশিত"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unknown function “{name}”. Known: {known}."
msgstr "অজানা ফাংশন “{name}”। জানা ফাংশন: {known}।"

#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "জানা ফাংশনের সাজানো তালিকা, পুনরাবৃত্তি ছাড়া, প্রত্যাশিত"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "পরীক্ষামূলক রেজিস্টার পড়া যাচ্ছে না: {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "পরীক্ষামূলক রেজিস্টার অন্য একটি প্রক্রিয়া দ্বারা লক করা ({file}): অন্য কমান্ড শেষ হলে আবার চেষ্টা করুন।"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "{file} লক করা যাচ্ছে না: {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "প্যাডেল পাওয়া যায়নি: কোনো “NAI5” সাউন্ড কার্ড নেই। USB কেবল পরীক্ষা করুন।"

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR সেট করা নেই: লক নেওয়া যাচ্ছে না।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "লক {file} নেওয়া যাচ্ছে না: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "প্যাডেলটি ইতিমধ্যে optima-air-এর অন্য একটি ইনস্ট্যান্স ব্যবহার করছে।"

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "লক ইতিমধ্যে ছেড়ে দেওয়া হয়েছে: এটি আর কোনো পোর্টকে দেওয়া যাবে না।"

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "এই লক ইতিমধ্যে একটি পোর্টের: এটি দ্বিতীয় একটি পোর্টকে দেওয়া যাবে না।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "লক ছাড়া যাচ্ছে না: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "প্যাডেল আর সাড়া দিচ্ছে না: খুলে গেছে বা আটকে গেছে।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "পোর্ট {port} কনফিগার করা যাচ্ছে না: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "পোর্ট {port}-এর ইনপুট সক্রিয় করা যাচ্ছে না: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "পোর্ট {port} নেই।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port}-এ প্রবেশাধিকার প্রত্যাখ্যাত। আপনি “audio” গ্রুপে আছেন কিনা পরীক্ষা করুন (কমান্ড: id)।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "পোর্ট {port} ইতিমধ্যে অন্য একটি প্রোগ্রাম ব্যবহার করছে।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "পোর্ট {port} আর উপলব্ধ নেই।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "পোর্ট {port} খোলা যাচ্ছে না: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "লেখা যাচ্ছে না: পোর্ট বন্ধ।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "পোর্ট {port}-এ লেখা ব্যর্থ হয়েছে: কোনো বাইট গৃহীত হয়নি।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "পোর্ট {port}-এ লেখা ব্যর্থ হয়েছে: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "পোর্ট {port} ড্রেন করা পরপর {count}বার বাধাপ্রাপ্ত হয়েছে: বার্তাটি কার্নেলের হাতে তুলে দেওয়া হয়েছে, কিন্তু তার প্রস্থানের জন্য অপেক্ষা করা যায়নি।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "অপেক্ষা সীমার বাইরে: {wait} সেকেন্ড (সর্বোচ্চ {max} সেকেন্ড)।"

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "পড়া যাচ্ছে না: পোর্ট বন্ধ।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "পোর্ট {port} থেকে পড়া ব্যর্থ হয়েছে: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "পোর্ট {port} তার ইনপুটের অবস্থা জানায় না ({error}): বাইট হারানো শনাক্ত করা যায় না, এখানেই থামা হচ্ছে।"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "পোর্ট {port}-এর অবস্থা পড়া ব্যর্থ হয়েছে: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "পোর্ট {port} বন্ধ করা ব্যর্থ হয়েছে: {error}"
