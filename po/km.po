#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "ច្រក {port} លែងមានទៀតហើយ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "មិនអាចបើកច្រក {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "មិនអាចសរសេរ: ច្រកត្រូវបានបិទ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "ការសរសេរទៅច្រក {port} បរាជ័យ: គ្មានបៃណាត្រូវបានទទួល"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "ការសរសេរទៅច្រក {port} បរាជ័យ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "ការបង្ហូរច្រក {port} ត្រូវបានរំខាន {count} ដងជាប់ៗគ្នា: សារត្រូវបានប្រគល់ឱ្យខឺណែល ប៉ុន្តែមិនអាចរង់ចាំការចេញដំណើររបស់វាបានទេ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "ពេលរង់ចាំនៅក្រៅចន្លោះ: {wait} វិនាទី (អតិបរមា {max} វិនាទី)"

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "មិនអាចអាន: ច្រកត្រូវបានបិទ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "ការអានពីច្រក {port} បរាជ័យ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "ច្រក {port} មិនរាយការណ៍ស្ថានភាពនៃការបញ្ចូលរបស់វា ({error}): មិនអាចរកឃើញការបាត់បង់បៃបានទេ ដូច្នេះឈប់នៅទីនេះ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "ការអានស្ថានភាពនៃច្រក {port} បរាជ័យ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "ការបិទច្រក {port} បរាជ័យ: {error}"
