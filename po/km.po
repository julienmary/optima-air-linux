#, python-brace-format
msgid "reason “{reason}” differs from the one of the backup {name}, reason “{expected}”"
msgstr "មូលហេតុ “{reason}” មិនដូចមូលហេតុនៃការបម្រុងទុក {name} ដែលជា “{expected}”"

