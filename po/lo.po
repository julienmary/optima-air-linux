msgstr "ສົ່ງຂໍ້ຄວາມປະກາດແລ້ວ: ບໍ່ມີຄຳຕອບ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{name}: validated"
msgstr "{name}: ຜ່ານການກວດສອບແລ້ວ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{name}: on trial"
msgstr "{name}: ຢູ່ລະຫວ່າງການທົດລອງ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "“trials {action}” expects the name of a function."
msgstr "“trials {action}” ຕ້ອງລະບຸຊື່ຂອງຟັງຊັນ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Name “{name}” refused ({error}). Give one with --name."
msgstr "ຊື່ “{name}” ຖືກປະຕິເສດ ({error}) ໃຫ້ລະບຸຊື່ດ້ວຍ --name"

#: src/optima_air/cli.py src/optima_air/gui/dialogues.py
#, python-brace-format
msgid "Warning: {warning}"
msgstr "ຄຳເຕືອນ: {warning}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Overwrite slot {slot} “{current}” with “{name}” ({file})?"
msgstr "ຂຽນທັບຊ່ອງ {slot} “{current}” ດ້ວຍ “{name}” ({file}) ຫຼືບໍ່?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical."
msgstr "ຊ່ອງ {slot}: ຂຽນ “{name}” ແລ້ວ ແລະອ່ານກັບຄືນແລ້ວກົງກັນ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Previous content (“{name}”) backed up in {backup}"
msgstr "ເນື້ອຫາເດີມ (“{name}”) ຖືກສຳຮອງໄວ້ໃນ {backup}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{file} already exists. Add --yes to overwrite it."
msgstr "{file} ມີຢູ່ແລ້ວ ໃຫ້ເພີ່ມ --yes ເພື່ອຂຽນທັບ"

#: src/optima_air/cli.py src/optima_air/disque.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Cannot write {file}: {error}"
msgstr "ຂຽນ {file} ບໍ່ໄດ້: {error}"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot} “{name}” exported to {file}"
msgstr "ສົ່ງອອກຊ່ອງ {slot} “{name}” ໄປຍັງ {file} ແລ້ວ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Reading: {done} of {total}…"
msgstr "ກຳລັງອ່ານ: {done} ຈາກ {total}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Warning: the identifier announced for slot {slot} does not match the data read, even after reading again. It is backed up anyway."
msgstr "ຄຳເຕືອນ: ຕົວລະບຸທີ່ປະກາດໄວ້ສຳລັບຊ່ອງ {slot} ບໍ່ກົງກັບຂໍ້ມູນທີ່ອ່ານໄດ້ ເຖິງແມ່ນອ່ານຊ້ຳແລ້ວ ແຕ່ຍັງຄົງສຳຮອງຂໍ້ມູນໄວ້"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "All 23 slots are backed up in {backup}"
msgstr "ສຳຮອງທັງ 23 ຊ່ອງໄວ້ໃນ {backup} ແລ້ວ"

#: src/optima_air/cli.py
msgid "No backups."
msgstr "ບໍ່ມີຂໍ້ມູນສຳຮອງ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{count} slot"
msgid_plural "{count} slots"
msgstr[0] "{count} ຊ່ອງ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "DAMAGED ({error})"
msgstr "ເສຍຫາຍ ({error})"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
msgid "none"
msgstr "ບໍ່ມີ"

#: src/optima_air/cli.py
msgid "--name only applies to restoring a single slot."
msgstr "--name ໃຊ້ໄດ້ສະເພາະເມື່ອກູ້ຄືນຊ່ອງດຽວ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Put the pedal back to the state of the backup {backup} ({count} slot)? Only the slots that differ will be rewritten, after their content is backed up."
msgid_plural "Put the pedal back to the state of the backup {backup} ({count} slots)? Only the slots that differ will be rewritten, after their content is backed up."
msgstr[0] "ຄືນເພດັລສູ່ສະຖານະຂອງຂໍ້ມູນສຳຮອງ {backup} ({count} ຊ່ອງ) ຫຼືບໍ່? ຈະຂຽນໃໝ່ສະເພາະຊ່ອງທີ່ແຕກຕ່າງ ຫຼັງຈາກສຳຮອງເນື້ອຫາຂອງຊ່ອງນັ້ນໄວ້ແລ້ວ"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "{operation}: {done} of {total}…"
msgstr "{operation}: {done} ຈາກ {total}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots rewritten and read back identical: {slots}"
msgstr "ຊ່ອງທີ່ຂຽນໃໝ່ແລະອ່ານກັບຄືນແລ້ວກົງກັນ: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots whose settings only were restored: {slots}"
msgstr "ຊ່ອງທີ່ກູ້ຄືນສະເພາະການຕັ້ງຄ່າ: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots already identical to the backup: {slots}"
msgstr "ຊ່ອງທີ່ກົງກັບຂໍ້ມູນສຳຮອງຢູ່ແລ້ວ: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Rewrite slot {slot} “{current}” from the backup {backup} (“{name}”)?"
msgstr "ຂຽນຊ່ອງ {slot} “{current}” ໃໝ່ຈາກຂໍ້ມູນສຳຮອງ {backup} (“{name}”) ຫຼືບໍ່?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot} restored from {backup}, then read back identical."
msgstr "ກູ້ຄືນຊ່ອງ {slot} ຈາກ {backup} ແລ້ວ ແລະອ່ານກັບຄືນແລ້ວກົງກັນ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Replaced content (“{name}”) backed up in {backup}"
msgstr "ເນື້ອຫາທີ່ຖືກແທນທີ່ (“{name}”) ຖືກສຳຮອງໄວ້ໃນ {backup}"

#: src/optima_air/cli.py
msgid "No interrupted write."
msgstr "ບໍ່ມີການຂຽນທີ່ຖືກຂັດຂວາງ"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: the interrupted write had completed. Nothing to do."
msgstr "ຊ່ອງ {slot}: ການຂຽນທີ່ຖືກຂັດຂວາງໄດ້ສຳເລັດແລ້ວ ບໍ່ຕ້ອງເຮັດຫຍັງ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: it still holds what it held before. Nothing to do."
msgstr "ຊ່ອງ {slot}: ຍັງຄົງມີເນື້ອຫາເດີມກ່ອນໜ້ານີ້ ບໍ່ຕ້ອງເຮັດຫຍັງ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: its content is neither the old nor the new one. To put it back as it was: optima-air restore {backup} {slot}"
msgstr "ຊ່ອງ {slot}: ເນື້ອຫາບໍ່ແມ່ນທັງຂອງເກົ່າແລະຂອງໃໝ່ ຖ້າຕ້ອງການຄືນເປັນຄືເກົ່າ: optima-air restore {backup} {slot}"

#: src/optima_air/cli.py
msgid "allow more than reads on a firmware that was not verified"
msgstr "ອະນຸຍາດໃຫ້ເຮັດຫຼາຍກວ່າການອ່ານເທິງເຟີມແວທີ່ຍັງບໍ່ໄດ້ກວດສອບ"

#: src/optima_air/cli.py
msgid "allow a trial function"
msgstr "ອະນຸຍາດຟັງຊັນທົດລອງ"

#: src/optima_air/cli.py
msgid "do not ask for confirmation"
msgstr "ບໍ່ຕ້ອງຂໍການຢືນຢັນ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count}"
msgstr "ໝາຍເລກຊ່ອງ ແຕ່ 1 ເຖິງ {count}"

#: src/optima_air/cli.py
msgid "Linux editor for the NUX Optima Air pedal."
msgstr "ໂປຣແກຣມແກ້ໄຂເທິງ Linux ສຳລັບເພດັລ NUX Optima Air"

#: src/optima_air/cli.py
msgid "data folder (default: XDG data folder)"
msgstr "ໂຟລເດີຂໍ້ມູນ (ຄ່າເລີ່ມຕົ້ນ: ໂຟລເດີຂໍ້ມູນ XDG)"

#: src/optima_air/cli.py
msgid "open the window"
msgstr "ເປີດໜ້າຕ່າງ"

#: src/optima_air/cli.py
msgid "firmware version, preset and settings"
msgstr "ເວີຊັນເຟີມແວ ພຣີເຊັດ ແລະການຕັ້ງຄ່າ"

#: src/optima_air/cli.py
msgid "the 23 IR slots"
msgstr "ຊ່ອງ IR ທັງ 23 ຊ່ອງ"

#: src/optima_air/cli.py
msgid "back up the IR of a slot"
msgstr "ສຳຮອງ IR ຂອງຊ່ອງ"

#: src/optima_air/cli.py
msgid "print what the pedal sends"
msgstr "ສະແດງສິ່ງທີ່ເພດັລສົ່ງມາ"

#: src/optima_air/cli.py
msgid "seconds of listening"
msgstr "ວິນາທີທີ່ຮັບຟັງ"

#: src/optima_air/cli.py
msgid "read the state first"
msgstr "ອ່ານສະຖານະກ່ອນ"

#: src/optima_air/cli.py
msgid "send the announcement first (trial)"
msgstr "ສົ່ງຂໍ້ຄວາມປະກາດກ່ອນ (ທົດລອງ)"

