msgstr "ಪ್ರಕಟಣೆ ಕಳುಹಿಸಲಾಗಿದೆ: ಉತ್ತರ ಬಂದಿದೆ"

#: src/optima_air/cli.py
msgid "Announcement sent: no answer"
msgstr "ಪ್ರಕಟಣೆ ಕಳುಹಿಸಲಾಗಿದೆ: ಉತ್ತರವಿಲ್ಲ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{name}: validated"
msgstr "{name}: ಮಾನ್ಯೀಕರಿಸಲಾಗಿದೆ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{name}: on trial"
msgstr "{name}: ಪ್ರಾಯೋಗಿಕ ಹಂತದಲ್ಲಿದೆ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "“trials {action}” expects the name of a function."
msgstr "“trials {action}” ಗೆ ಒಂದು ಕಾರ್ಯದ ಹೆಸರು ಬೇಕು."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Name “{name}” refused ({error}). Give one with --name."
msgstr "ಹೆಸರು “{name}” ತಿರಸ್ಕರಿಸಲಾಗಿದೆ ({error}). --name ಮೂಲಕ ಒಂದನ್ನು ನೀಡಿ."

#: src/optima_air/cli.py src/optima_air/gui/dialogues.py
#, python-brace-format
msgid "Warning: {warning}"
msgstr "ಎಚ್ಚರಿಕೆ: {warning}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Overwrite slot {slot} “{current}” with “{name}” ({file})?"
msgstr "ಸ್ಲಾಟ್ {slot} “{current}” ಅನ್ನು “{name}” ({file}) ನಿಂದ ಮೇಲ್ಬರಹ ಮಾಡಬೇಕೇ?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical."
msgstr "ಸ್ಲಾಟ್ {slot}: “{name}” ಬರೆಯಲಾಗಿದೆ ಮತ್ತು ಮತ್ತೆ ಓದಿದಾಗ ಒಂದೇ ಆಗಿದೆ."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Previous content (“{name}”) backed up in {backup}"
msgstr "ಹಿಂದಿನ ವಿಷಯ (“{name}”) {backup} ನಲ್ಲಿ ಬ್ಯಾಕಪ್ ಆಗಿದೆ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{file} already exists. Add --yes to overwrite it."
msgstr "{file} ಈಗಾಗಲೇ ಇದೆ. ಅದನ್ನು ಮೇಲ್ಬರಹ ಮಾಡಲು --yes ಸೇರಿಸಿ."

#: src/optima_air/cli.py src/optima_air/disque.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Cannot write {file}: {error}"
msgstr "{file} ಅನ್ನು ಬರೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ: {error}"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot} “{name}” exported to {file}"
msgstr "ಸ್ಲಾಟ್ {slot} “{name}” ಅನ್ನು {file} ಗೆ ರಫ್ತು ಮಾಡಲಾಗಿದೆ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Reading: {done} of {total}…"
msgstr "ಓದುತ್ತಿದೆ: {total} ರಲ್ಲಿ {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Warning: the identifier announced for slot {slot} does not match the data read, even after reading again. It is backed up anyway."
msgstr "ಎಚ್ಚರಿಕೆ: ಸ್ಲಾಟ್ {slot} ಗಾಗಿ ಘೋಷಿಸಿದ ಗುರುತು ಮತ್ತೆ ಓದಿದ ನಂತರವೂ ಓದಿದ ಡೇಟಾದೊಂದಿಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ. ಹೇಗಿದ್ದರೂ ಬ್ಯಾಕಪ್ ಮಾಡಲಾಗುತ್ತದೆ."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "All 23 slots are backed up in {backup}"
msgstr "ಎಲ್ಲಾ 23 ಸ್ಲಾಟ್‌ಗಳು {backup} ನಲ್ಲಿ ಬ್ಯಾಕಪ್ ಆಗಿವೆ"

#: src/optima_air/cli.py
msgid "No backups."
msgstr "ಬ್ಯಾಕಪ್‌ಗಳಿಲ್ಲ."

#: src/optima_air/cli.py
#, python-brace-format
msgid "{count} slot"
msgid_plural "{count} slots"
msgstr[0] "{count} ಸ್ಲಾಟ್"
msgstr[1] "{count} ಸ್ಲಾಟ್‌ಗಳು"

#: src/optima_air/cli.py
#, python-brace-format
msgid "DAMAGED ({error})"
msgstr "ಹಾನಿಯಾಗಿದೆ ({error})"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
msgid "none"
msgstr "ಯಾವುದೂ ಇಲ್ಲ"

#: src/optima_air/cli.py
msgid "--name only applies to restoring a single slot."
msgstr "--name ಒಂದೇ ಸ್ಲಾಟ್ ಅನ್ನು ಮರುಸ್ಥಾಪಿಸುವಾಗ ಮಾತ್ರ ಅನ್ವಯಿಸುತ್ತದೆ."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Put the pedal back to the state of the backup {backup} ({count} slot)? Only the slots that differ will be rewritten, after their content is backed up."
msgid_plural "Put the pedal back to the state of the backup {backup} ({count} slots)? Only the slots that differ will be rewritten, after their content is backed up."
msgstr[0] "ಪೆಡಲ್ ಅನ್ನು ಬ್ಯಾಕಪ್ {backup} ನ ಸ್ಥಿತಿಗೆ ({count} ಸ್ಲಾಟ್) ಮರಳಿಸಬೇಕೇ? ಭಿನ್ನವಾಗಿರುವ ಸ್ಲಾಟ್‌ಗಳನ್ನು ಮಾತ್ರ, ಅವುಗಳ ವಿಷಯವನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡಿದ ನಂತರ, ಮತ್ತೆ ಬರೆಯಲಾಗುತ್ತದೆ."
msgstr[1] "ಪೆಡಲ್ ಅನ್ನು ಬ್ಯಾಕಪ್ {backup} ನ ಸ್ಥಿತಿಗೆ ({count} ಸ್ಲಾಟ್‌ಗಳು) ಮರಳಿಸಬೇಕೇ? ಭಿನ್ನವಾಗಿರುವ ಸ್ಲಾಟ್‌ಗಳನ್ನು ಮಾತ್ರ, ಅವುಗಳ ವಿಷಯವನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡಿದ ನಂತರ, ಮತ್ತೆ ಬರೆಯಲಾಗುತ್ತದೆ."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "{operation}: {done} of {total}…"
msgstr "{operation}: {total} ರಲ್ಲಿ {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots rewritten and read back identical: {slots}"
msgstr "ಮತ್ತೆ ಬರೆಯಲಾಗಿ, ಮತ್ತೆ ಓದಿದಾಗ ಒಂದೇ ಆಗಿರುವ ಸ್ಲಾಟ್‌ಗಳು: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots whose settings only were restored: {slots}"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮಾತ್ರ ಮರುಸ್ಥಾಪಿಸಿದ ಸ್ಲಾಟ್‌ಗಳು: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots already identical to the backup: {slots}"
msgstr "ಬ್ಯಾಕಪ್‌ನೊಂದಿಗೆ ಈಗಾಗಲೇ ಒಂದೇ ಆಗಿರುವ ಸ್ಲಾಟ್‌ಗಳು: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Rewrite slot {slot} “{current}” from the backup {backup} (“{name}”)?"
msgstr "ಸ್ಲಾಟ್ {slot} “{current}” ಅನ್ನು ಬ್ಯಾಕಪ್ {backup} (“{name}”) ನಿಂದ ಮತ್ತೆ ಬರೆಯಬೇಕೇ?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot} restored from {backup}, then read back identical."
msgstr "ಸ್ಲಾಟ್ {slot} ಅನ್ನು {backup} ನಿಂದ ಮರುಸ್ಥಾಪಿಸಲಾಗಿದೆ, ನಂತರ ಮತ್ತೆ ಓದಿದಾಗ ಒಂದೇ ಆಗಿದೆ."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Replaced content (“{name}”) backed up in {backup}"
msgstr "ಬದಲಾಯಿಸಲಾದ ವಿಷಯ (“{name}”) {backup} ನಲ್ಲಿ ಬ್ಯಾಕಪ್ ಆಗಿದೆ"

#: src/optima_air/cli.py
msgid "No interrupted write."
msgstr "ಅಡ್ಡಿಪಡಿಸಲ್ಪಟ್ಟ ಬರವಣಿಗೆ ಇಲ್ಲ."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: the interrupted write had completed. Nothing to do."
msgstr "ಸ್ಲಾಟ್ {slot}: ಅಡ್ಡಿಪಡಿಸಲ್ಪಟ್ಟ ಬರವಣಿಗೆ ಪೂರ್ಣಗೊಂಡಿತ್ತು. ಮಾಡಲು ಏನೂ ಇಲ್ಲ."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: it still holds what it held before. Nothing to do."
msgstr "ಸ್ಲಾಟ್ {slot}: ಅದು ಈಗಲೂ ಮೊದಲು ಇದ್ದದ್ದನ್ನೇ ಹೊಂದಿದೆ. ಮಾಡಲು ಏನೂ ಇಲ್ಲ."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: its content is neither the old nor the new one. To put it back as it was: optima-air restore {backup} {slot}"
msgstr "ಸ್ಲಾಟ್ {slot}: ಅದರ ವಿಷಯ ಹಳೆಯದೂ ಅಲ್ಲ, ಹೊಸದೂ ಅಲ್ಲ. ಅದನ್ನು ಮೊದಲಿನಂತೆ ಮರಳಿಸಲು: optima-air restore {backup} {slot}"

#: src/optima_air/cli.py
msgid "allow more than reads on a firmware that was not verified"
msgstr "ಪರಿಶೀಲಿಸದ ಫರ್ಮ್‌ವೇರ್‌ನಲ್ಲಿ ಓದುವುದಕ್ಕಿಂತ ಹೆಚ್ಚಿನದನ್ನು ಅನುಮತಿಸು"

#: src/optima_air/cli.py
msgid "allow a trial function"
msgstr "ಪ್ರಾಯೋಗಿಕ ಕಾರ್ಯವನ್ನು ಅನುಮತಿಸು"

#: src/optima_air/cli.py
msgid "do not ask for confirmation"
msgstr "ದೃಢೀಕರಣವನ್ನು ಕೇಳಬೇಡ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count}"
msgstr "ಸ್ಲಾಟ್ ಸಂಖ್ಯೆ, 1 ರಿಂದ {count} ರವರೆಗೆ"

#: src/optima_air/cli.py
msgid "Linux editor for the NUX Optima Air pedal."
msgstr "NUX Optima Air ಪೆಡಲ್‌ಗಾಗಿ Linux ಎಡಿಟರ್."

#: src/optima_air/cli.py
msgid "data folder (default: XDG data folder)"
msgstr "ಡೇಟಾ ಫೋಲ್ಡರ್ (ಡೀಫಾಲ್ಟ್: XDG ಡೇಟಾ ಫೋಲ್ಡರ್)"

#: src/optima_air/cli.py
msgid "open the window"
msgstr "ವಿಂಡೋ ತೆರೆಯಿರಿ"

#: src/optima_air/cli.py
msgid "firmware version, preset and settings"
msgstr "ಫರ್ಮ್‌ವೇರ್ ಆವೃತ್ತಿ, ಪ್ರಿಸೆಟ್ ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

#: src/optima_air/cli.py
msgid "the 23 IR slots"
msgstr "23 IR ಸ್ಲಾಟ್‌ಗಳು"

#: src/optima_air/cli.py
msgid "back up the IR of a slot"
msgstr "ಒಂದು ಸ್ಲಾಟ್‌ನ IR ಅನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡು"

#: src/optima_air/cli.py
msgid "print what the pedal sends"
msgstr "ಪೆಡಲ್ ಕಳುಹಿಸುವುದನ್ನು ಮುದ್ರಿಸು"

#: src/optima_air/cli.py
msgid "seconds of listening"
msgstr "ಆಲಿಸುವ ಸೆಕೆಂಡುಗಳು"

#: src/optima_air/cli.py
msgid "read the state first"
msgstr "ಮೊದಲು ಸ್ಥಿತಿಯನ್ನು ಓದು"

#: src/optima_air/cli.py
msgid "send the announcement first (trial)"
msgstr "ಮೊದಲು ಪ್ರಕಟಣೆಯನ್ನು ಕಳುಹಿಸು (ಪ್ರಾಯೋಗಿಕ)"

#: src/optima_air/cli.py
msgid "write a WAV into a slot"
msgstr "ಒಂದು ಸ್ಲಾಟ್‌ನಲ್ಲಿ WAV ಅನ್ನು ಬರೆ"

#: src/optima_air/cli.py
msgid "WAV file"
msgstr "WAV ಫೈಲ್"

#: src/optima_air/cli.py
msgid "name of the slot (default: the name of the file)"
msgstr "ಸ್ಲಾಟ್‌ನ ಹೆಸರು (ಡೀಫಾಲ್ಟ್: ಫೈಲ್‌ನ ಹೆಸರು)"

#: src/optima_air/cli.py
msgid "export a slot as WAV"
msgstr "ಒಂದು ಸ್ಲಾಟ್ ಅನ್ನು WAV ಆಗಿ ರಫ್ತು ಮಾಡು"

#: src/optima_air/cli.py
msgid "WAV file to write"
msgstr "ಬರೆಯಬೇಕಾದ WAV ಫೈಲ್"

#: src/optima_air/cli.py
msgid "rewrite a slot, or all of them, from a backup"
msgstr "ಬ್ಯಾಕಪ್‌ನಿಂದ ಒಂದು ಸ್ಲಾಟ್ ಅನ್ನು ಅಥವಾ ಎಲ್ಲವನ್ನೂ ಮತ್ತೆ ಬರೆ"

#: src/optima_air/cli.py
msgid "backup folder"
msgstr "ಬ್ಯಾಕಪ್ ಫೋಲ್ಡರ್"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count} (default: all)"
msgstr "ಸ್ಲಾಟ್ ಸಂಖ್ಯೆ, 1 ರಿಂದ {count} ರವರೆಗೆ (ಡೀಫಾಲ್ಟ್: ಎಲ್ಲವೂ)"

#: src/optima_air/cli.py
msgid "replace the backed up name"
msgstr "ಬ್ಯಾಕಪ್ ಮಾಡಿದ ಹೆಸರನ್ನು ಬದಲಾಯಿಸು"

#: src/optima_air/cli.py
msgid "back up the 23 slots"
msgstr "23 ಸ್ಲಾಟ್‌ಗಳನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡು"

#: src/optima_air/cli.py
msgid "list the backups"
msgstr "ಬ್ಯಾಕಪ್‌ಗಳನ್ನು ಪಟ್ಟಿಮಾಡು"

#: src/optima_air/cli.py
msgid "check an interrupted write"
msgstr "ಅಡ್ಡಿಪಡಿಸಲ್ಪಟ್ಟ ಬರವಣಿಗೆಯನ್ನು ಪರಿಶೀಲಿಸು"

#: src/optima_air/cli.py
msgid "register of the trial functions"
msgstr "ಪ್ರಾಯೋಗಿಕ ಕಾರ್ಯಗಳ ರಿಜಿಸ್ಟರ್"

#: src/optima_air/cli.py
#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "ಸ್ಲಾಟ್ {slot} ಗೆ ಬರವಣಿಗೆ ಅಪೂರ್ಣವಾಗಿ ಉಳಿದಿದೆ. ಪೆಡಲ್ ಅನ್ನು ಸ್ವಲ್ಪ ಕಾಲ ಒಂಟಿಯಾಗಿ ಬಿಡಲಾಗುತ್ತದೆ; ನಂತರ ಚಲಾಯಿಸಿ: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "ದೋಷ: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "ಅಡ್ಡಿಪಡಿಸಲಾಗಿದೆ."

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "ಬೈಟ್ {byte} 7 ಬಿಟ್‌ಗಳ ಹೊರಗಿದೆ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "{count} 7-ಬಿಟ್ ಬೈಟ್‌ಗಳು {bits} ಪ್ಯಾಡಿಂಗ್ ಬಿಟ್‌ಗಳನ್ನು ಬಿಡುತ್ತವೆ, enc7 ಎಂದಿಗೂ 6 ಕ್ಕಿಂತ ಹೆಚ್ಚು ಉತ್ಪಾದಿಸುವುದಿಲ್ಲ"

#: src/optima_air/codec.py
msgid "non-zero padding bits at the end of a 7-bit stream"
msgstr "7-ಬಿಟ್ ಸ್ಟ್ರೀಮ್‌ನ ಕೊನೆಯಲ್ಲಿ ಸೊನ್ನೆಯಲ್ಲದ ಪ್ಯಾಡಿಂಗ್ ಬಿಟ್‌ಗಳು"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "ಒಂದು ಬ್ಲಾಕ್ {expected} ಬೈಟ್‌ಗಳು, {got} ಬಂದಿವೆ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "ಬ್ಲಾಕ್ ಮೊತ್ತ {sum} ({hex}) ರವಾನೆಯಾಗುವ 14 ಬಿಟ್‌ಗಳನ್ನು ಮೀರಿದೆ (ಗರಿಷ್ಠ {max}): ಪೆಡಲ್‌ನಲ್ಲಿ ಎಂದಿಗೂ ಕಂಡುಬಂದಿಲ್ಲ, ಪರಿಶೀಲಿಸುವವರೆಗೆ ತಿರಸ್ಕರಿಸಲಾಗಿದೆ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "ಎನ್‌ಕೋಡ್ ಮಾಡಿದ ಬ್ಲಾಕ್ {expected} ಬೈಟ್‌ಗಳು, {got} ಬಂದಿವೆ"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "ಎನ್‌ಕೋಡ್ ಮಾಡಿದ ಬ್ಲಾಕ್‌ನಲ್ಲಿ 7 ಬಿಟ್‌ಗಳ ಹೊರಗಿನ ಬೈಟ್"

#: src/optima_air/codec.py
msgid "wrong block checksum"
msgstr "ತಪ್ಪಾದ ಬ್ಲಾಕ್ ಚೆಕ್‌ಸಮ್"

#: src/optima_air/codec.py
msgid "the end-of-transfer sum covers at least one block"
msgstr "ವರ್ಗಾವಣೆ ಮುಕ್ತಾಯದ ಮೊತ್ತವು ಕನಿಷ್ಠ ಒಂದು ಬ್ಲಾಕ್ ಅನ್ನು ಒಳಗೊಂಡಿರುತ್ತದೆ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
msgstr "ಉದ್ದ {length} ಎಂಬುದು {block} ರ ಗುಣಕವಲ್ಲ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "value {value} outside 28 bits"
