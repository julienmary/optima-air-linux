#, python-brace-format
msgid "“trials {action}” expects the name of a function."
msgstr "“trials {action}” ஒரு செயல்பாட்டின் பெயரை எதிர்பார்க்கிறது."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Name “{name}” refused ({error}). Give one with --name."
msgstr "பெயர் “{name}” நிராகரிக்கப்பட்டது ({error}). --name மூலம் ஒன்றைக் கொடுக்கவும்."

#: src/optima_air/cli.py src/optima_air/gui/dialogues.py
#, python-brace-format
msgid "Warning: {warning}"
msgstr "எச்சரிக்கை: {warning}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Overwrite slot {slot} “{current}” with “{name}” ({file})?"
msgstr "ஸ்லாட் {slot} “{current}” ஐ “{name}” ({file}) கொண்டு மேலெழுதவா?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical."
msgstr "ஸ்லாட் {slot}: “{name}” எழுதப்பட்டு, மீண்டும் படித்தபோது ஒன்றாக இருந்தது."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Previous content (“{name}”) backed up in {backup}"
msgstr "முந்தைய உள்ளடக்கம் (“{name}”) {backup} இல் காப்புப் பிரதி எடுக்கப்பட்டது"

#: src/optima_air/cli.py
#, python-brace-format
msgid "{file} already exists. Add --yes to overwrite it."
msgstr "{file} ஏற்கெனவே உள்ளது. அதை மேலெழுத --yes ஐச் சேர்க்கவும்."

#: src/optima_air/cli.py src/optima_air/disque.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Cannot write {file}: {error}"
msgstr "{file} ஐ எழுத இயலவில்லை: {error}"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot} “{name}” exported to {file}"
msgstr "ஸ்லாட் {slot} “{name}” {file} க்கு ஏற்றுமதி செய்யப்பட்டது"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Reading: {done} of {total}…"
msgstr "படிக்கிறது: {total} இல் {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Warning: the identifier announced for slot {slot} does not match the data read, even after reading again. It is backed up anyway."
msgstr "எச்சரிக்கை: ஸ்லாட் {slot} க்கு அறிவிக்கப்பட்ட அடையாளம் மீண்டும் படித்த பிறகும் படித்த தரவுடன் பொருந்தவில்லை. எப்படியிருப்பினும் காப்புப் பிரதி எடுக்கப்படுகிறது."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "All 23 slots are backed up in {backup}"
msgstr "23 ஸ்லாட்டுகளும் {backup} இல் காப்புப் பிரதி எடுக்கப்பட்டுள்ளன"

#: src/optima_air/cli.py
msgid "No backups."
msgstr "காப்புப்பிரதிகள் இல்லை."

#: src/optima_air/cli.py
#, python-brace-format
msgid "{count} slot"
msgid_plural "{count} slots"
msgstr[0] "{count} ஸ்லாட்"
msgstr[1] "{count} ஸ்லாட்டுகள்"

#: src/optima_air/cli.py
#, python-brace-format
msgid "DAMAGED ({error})"
msgstr "சேதமடைந்தது ({error})"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
msgid "none"
msgstr "எதுவுமில்லை"

#: src/optima_air/cli.py
msgid "--name only applies to restoring a single slot."
msgstr "--name ஒரே ஒரு ஸ்லாட்டை மீட்டமைக்கும்போது மட்டுமே பொருந்தும்."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Put the pedal back to the state of the backup {backup} ({count} slot)? Only the slots that differ will be rewritten, after their content is backed up."
msgid_plural "Put the pedal back to the state of the backup {backup} ({count} slots)? Only the slots that differ will be rewritten, after their content is backed up."
msgstr[0] "பெடலை காப்புப்பிரதி {backup} இன் நிலைக்கு ({count} ஸ்லாட்) திருப்பவா? வேறுபடும் ஸ்லாட்டுகள் மட்டுமே, அவற்றின் உள்ளடக்கம் காப்புப் பிரதி எடுக்கப்பட்ட பிறகு, மீண்டும் எழுதப்படும்."
msgstr[1] "பெடலை காப்புப்பிரதி {backup} இன் நிலைக்கு ({count} ஸ்லாட்டுகள்) திருப்பவா? வேறுபடும் ஸ்லாட்டுகள் மட்டுமே, அவற்றின் உள்ளடக்கம் காப்புப் பிரதி எடுக்கப்பட்ட பிறகு, மீண்டும் எழுதப்படும்."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "{operation}: {done} of {total}…"
msgstr "{operation}: {total} இல் {done}…"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots rewritten and read back identical: {slots}"
msgstr "மீண்டும் எழுதப்பட்டு, மீண்டும் படித்தபோது ஒன்றாக இருந்த ஸ்லாட்டுகள்: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots whose settings only were restored: {slots}"
msgstr "அமைப்புகள் மட்டும் மீட்டமைக்கப்பட்ட ஸ்லாட்டுகள்: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slots already identical to the backup: {slots}"
msgstr "காப்புப்பிரதியுடன் ஏற்கெனவே ஒன்றாக இருந்த ஸ்லாட்டுகள்: {slots}"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Rewrite slot {slot} “{current}” from the backup {backup} (“{name}”)?"
msgstr "ஸ்லாட் {slot} “{current}” ஐ காப்புப்பிரதி {backup} இலிருந்து (“{name}”) மீண்டும் எழுதவா?"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot} restored from {backup}, then read back identical."
msgstr "ஸ்லாட் {slot} {backup} இலிருந்து மீட்டமைக்கப்பட்டது, பிறகு மீண்டும் படித்தபோது ஒன்றாக இருந்தது."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Replaced content (“{name}”) backed up in {backup}"
msgstr "மாற்றப்பட்ட உள்ளடக்கம் (“{name}”) {backup} இல் காப்புப் பிரதி எடுக்கப்பட்டது"

#: src/optima_air/cli.py
msgid "No interrupted write."
msgstr "இடைமறிக்கப்பட்ட எழுதுதல் இல்லை."

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: the interrupted write had completed. Nothing to do."
msgstr "ஸ்லாட் {slot}: இடைமறிக்கப்பட்ட எழுதுதல் முடிந்திருந்தது. செய்ய ஒன்றுமில்லை."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: it still holds what it held before. Nothing to do."
msgstr "ஸ்லாட் {slot}: அது இன்னும் முன்பு இருந்ததையே கொண்டுள்ளது. செய்ய ஒன்றுமில்லை."

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: its content is neither the old nor the new one. To put it back as it was: optima-air restore {backup} {slot}"
msgstr "ஸ்லாட் {slot}: அதன் உள்ளடக்கம் பழையதும் அல்ல, புதியதும் அல்ல. முன்பு இருந்தபடி மீட்டமைக்க: optima-air restore {backup} {slot}"

#: src/optima_air/cli.py
msgid "allow more than reads on a firmware that was not verified"
msgstr "சரிபார்க்கப்படாத ஃபர்ம்வேரில் படிப்பதைத் தவிர மற்றவற்றையும் அனுமதி"

#: src/optima_air/cli.py
msgid "allow a trial function"
msgstr "ஒரு சோதனை செயல்பாட்டை அனுமதி"

#: src/optima_air/cli.py
msgid "do not ask for confirmation"
msgstr "உறுதிப்படுத்தலைக் கேட்காதே"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count}"
msgstr "ஸ்லாட் எண், 1 முதல் {count} வரை"

#: src/optima_air/cli.py
msgid "Linux editor for the NUX Optima Air pedal."
msgstr "NUX Optima Air பெடலுக்கான Linux எடிட்டர்."

#: src/optima_air/cli.py
msgid "data folder (default: XDG data folder)"
msgstr "தரவு கோப்புறை (இயல்புநிலை: XDG தரவு கோப்புறை)"

#: src/optima_air/cli.py
msgid "open the window"
msgstr "சாளரத்தைத் திற"

#: src/optima_air/cli.py
msgid "firmware version, preset and settings"
msgstr "ஃபர்ம்வேர் பதிப்பு, முன்னமைவு மற்றும் அமைப்புகள்"

#: src/optima_air/cli.py
msgid "the 23 IR slots"
msgstr "23 IR ஸ்லாட்டுகள்"

#: src/optima_air/cli.py
msgid "back up the IR of a slot"
msgstr "ஒரு ஸ்லாட்டின் IR ஐ காப்புப் பிரதி எடு"

#: src/optima_air/cli.py
msgid "print what the pedal sends"
msgstr "பெடல் அனுப்புவதை அச்சிடு"

#: src/optima_air/cli.py
msgid "seconds of listening"
msgstr "கேட்கும் வினாடிகள்"

#: src/optima_air/cli.py
msgid "read the state first"
msgstr "முதலில் நிலையைப் படி"

#: src/optima_air/cli.py
msgid "send the announcement first (trial)"
msgstr "முதலில் அறிவிப்பை அனுப்பு (சோதனை)"

#: src/optima_air/cli.py
msgid "write a WAV into a slot"
msgstr "ஒரு ஸ்லாட்டில் WAV ஐ எழுது"

#: src/optima_air/cli.py
msgid "WAV file"
msgstr "WAV கோப்பு"

#: src/optima_air/cli.py
msgid "name of the slot (default: the name of the file)"
msgstr "ஸ்லாட்டின் பெயர் (இயல்புநிலை: கோப்பின் பெயர்)"

#: src/optima_air/cli.py
msgid "export a slot as WAV"
msgstr "ஒரு ஸ்லாட்டை WAV ஆக ஏற்றுமதி செய்"

#: src/optima_air/cli.py
msgid "WAV file to write"
msgstr "எழுத வேண்டிய WAV கோப்பு"

#: src/optima_air/cli.py
msgid "rewrite a slot, or all of them, from a backup"
msgstr "ஒரு ஸ்லாட்டை அல்லது அனைத்தையும் காப்புப்பிரதியிலிருந்து மீண்டும் எழுது"

#: src/optima_air/cli.py
msgid "backup folder"
msgstr "காப்புப்பிரதி கோப்புறை"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count} (default: all)"
msgstr "ஸ்லாட் எண், 1 முதல் {count} வரை (இயல்புநிலை: அனைத்தும்)"

#: src/optima_air/cli.py
msgid "replace the backed up name"
msgstr "காப்புப் பிரதி எடுக்கப்பட்ட பெயரை மாற்று"

#: src/optima_air/cli.py
msgid "back up the 23 slots"
msgstr "23 ஸ்லாட்டுகளையும் காப்புப் பிரதி எடு"

#: src/optima_air/cli.py
msgid "list the backups"
msgstr "காப்புப்பிரதிகளைப் பட்டியலிடு"

#: src/optima_air/cli.py
msgid "check an interrupted write"
msgstr "இடைமறிக்கப்பட்ட எழுதுதலைச் சரிபார்"

#: src/optima_air/cli.py
msgid "register of the trial functions"
msgstr "சோதனை செயல்பாடுகளின் பதிவேடு"

#: src/optima_air/cli.py
#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "ஸ்லாட் {slot} க்கான எழுதுதல் முடிக்கப்படாமல் விடப்பட்டது. பெடல் சிறிது நேரம் தனியாக விடப்படும்; பிறகு இயக்கவும்: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "பிழை: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "இடைமறிக்கப்பட்டது."

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "பைட் {byte} 7 பிட்டுக்கு வெளியே உள்ளது"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "{count} 7-பிட் பைட்டுகள் {bits} நிரப்பு பிட்களை விடுகின்றன, enc7 ஒருபோதும் 6 க்கு மேல் உருவாக்குவதில்லை"

#: src/optima_air/codec.py
msgid "non-zero padding bits at the end of a 7-bit stream"
msgstr "7-பிட் ஓடையின் இறுதியில் பூஜ்யமற்ற நிரப்பு பிட்கள்"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "ஒரு பிளாக் {expected} பைட்டுகள், {got} கிடைத்தது"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "பிளாக் தொகை {sum} ({hex}) அனுப்பப்படும் 14 பிட்களைத் தாண்டியது (அதிகபட்சம் {max}): பெடலில் ஒருபோதும் காணப்படவில்லை, சரிபார்க்கப்படும் வரை நிராகரிக்கப்படுகிறது"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "குறியாக்கம் செய்யப்பட்ட பிளாக் {expected} பைட்டுகள், {got} கிடைத்தது"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "குறியாக்கம் செய்யப்பட்ட பிளாக்கில் 7 பிட்டுக்கு வெளியே உள்ள பைட்"

#: src/optima_air/codec.py
msgid "wrong block checksum"
msgstr "தவறான பிளாக் சரிபார்ப்புத் தொகை"

#: src/optima_air/codec.py
msgid "the end-of-transfer sum covers at least one block"
msgstr "பரிமாற்ற முடிவுத் தொகை குறைந்தது ஒரு பிளாக்கை உள்ளடக்குகிறது"

#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
msgstr "நீளம் {length} என்பது {block} இன் மடங்கு அல்ல"

#: src/optima_air/codec.py
#, python-brace-format
msgid "value {value} outside 28 bits"
msgstr "மதிப்பு {value} 28 பிட்டுக்கு வெளியே உள்ளது"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a 28-bit sum takes 4 bytes, got {got}"
msgstr "ஒரு 28-பிட் தொகை 4 பைட்டுகளை எடுக்கும், {got} கிடைத்தது"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits in a 28-bit sum"
msgstr "28-பிட் தொகையில் 7 பிட்டுக்கு வெளியே உள்ள பைட் {byte}"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write was interrupted: the pedal is left alone for another {seconds} s."
msgstr "ஒரு எழுதுதல் இடைமறிக்கப்பட்டது: பெடல் இன்னும் {seconds} வி தனியாக விடப்படும்."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: a write message can only be sent by a complete slot write (backup, journal, read back)."
msgstr "“{message}”: எழுதும் செய்தியை முழுமையான ஸ்லாட் எழுதுதலால் (காப்புப்பிரதி, பதிவேடு, மீண்டும் படித்தல்) மட்டுமே அனுப்ப முடியும்."

#: src/optima_air/device.py
msgid "The firmware version has not been read yet: only reads are allowed."
msgstr "ஃபர்ம்வேர் பதிப்பு இன்னும் படிக்கப்படவில்லை: படிப்பது மட்டுமே அனுமதிக்கப்படுகிறது."

#: src/optima_air/device.py
#, python-brace-format
msgid "Unknown firmware {found} (protocol verified on {verified}): only reads are allowed."
msgstr "தெரியாத ஃபர்ம்வேர் {found} (நெறிமுறை {verified} இல் சரிபார்க்கப்பட்டது): படிப்பது மட்டுமே அனுமதிக்கப்படுகிறது."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}” is a trial function (“{function}”), not yet validated on the pedal."
msgstr "“{message}” ஒரு சோதனை செயல்பாடு (“{function}”), பெடலில் இன்னும் சரிபார்க்கப்படவில்லை."

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: only a read can be sent again."
msgstr "“{message}”: படிப்பதை மட்டுமே மீண்டும் அனுப்ப முடியும்."

