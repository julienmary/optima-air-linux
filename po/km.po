msgid "date {date!r} differs from the time of the backup {name}"
msgstr "កាលបរិច្ឆេទ {date!r} មិនត្រូវនឹងម៉ោងនៃការបម្រុងទុក {name}"

#: src/optima_air/archives.py
#, python-brace-format
msgid "{field}: date expected, got {type}"
msgstr "{field}: ត្រូវការកាលបរិច្ឆេទ ប៉ុន្តែទទួលបាន {type}"

#: src/optima_air/archives.py
#, python-brace-format
msgid "{field} must carry a time zone (for example datetime.now().astimezone())"
msgstr "{field} ត្រូវមានល្វែងម៉ោង (ឧទាហរណ៍ datetime.now().astimezone())"

#: src/optima_air/archives.py
#, python-brace-format
