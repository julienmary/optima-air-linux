#: src/optima_air/cli.py
msgid "No interrupted write."
msgstr "គ្មានការសរសេរដែលត្រូវបានរំខាន"

#: src/optima_air/cli.py src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: the interrupted write had completed. Nothing to do."
msgstr "ទីតាំង {slot}: ការសរសេរដែលត្រូវបានរំខានបានបញ្ចប់រួចហើយ មិនចាំបាច់ធ្វើអ្វីទេ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Slot {slot}: it still holds what it held before. Nothing to do."
msgstr "ទីតាំង {slot}: វានៅតែមានមាតិកាដដែលដូចមុន មិនចាំបាច់ធ្វើអ្វីទេ"

#: src/optima_air/cli.py
#, python-brace-format
