msgid "write a WAV into a slot"
msgstr "ຂຽນໄຟລ໌ WAV ລົງໃນຊ່ອງ"

#: src/optima_air/cli.py
msgid "WAV file"
msgstr "ໄຟລ໌ WAV"

#: src/optima_air/cli.py
msgid "name of the slot (default: the name of the file)"
msgstr "ຊື່ຂອງຊ່ອງ (ຄ່າເລີ່ມຕົ້ນ: ຊື່ຂອງໄຟລ໌)"

#: src/optima_air/cli.py
msgid "export a slot as WAV"
msgstr "ສົ່ງອອກຊ່ອງເປັນ WAV"

#: src/optima_air/cli.py
msgid "WAV file to write"
msgstr "ໄຟລ໌ WAV ທີ່ຈະຂຽນ"

#: src/optima_air/cli.py
msgid "rewrite a slot, or all of them, from a backup"
msgstr "ຂຽນຊ່ອງໜຶ່ງຊ່ອງ ຫຼື ທຸກຊ່ອງໃໝ່ຈາກຂໍ້ມູນສຳຮອງ"

#: src/optima_air/cli.py
msgid "backup folder"
msgstr "ໂຟລເດີຂໍ້ມູນສຳຮອງ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "slot number, from 1 to {count} (default: all)"
msgstr "ໝາຍເລກຊ່ອງ ແຕ່ 1 ເຖິງ {count} (ຄ່າເລີ່ມຕົ້ນ: ທັງໝົດ)"

#: src/optima_air/cli.py
msgid "replace the backed up name"
msgstr "ແທນທີ່ຊື່ທີ່ສຳຮອງໄວ້"

#: src/optima_air/cli.py
msgid "back up the 23 slots"
msgstr "ສຳຮອງຂໍ້ມູນທັງ 23 ຊ່ອງ"

#: src/optima_air/cli.py
msgid "list the backups"
msgstr "ສະແດງລາຍການຂໍ້ມູນສຳຮອງ"

#: src/optima_air/cli.py
msgid "check an interrupted write"
msgstr "ກວດສອບການຂຽນທີ່ຖືກຂັດຂວາງ"

#: src/optima_air/cli.py
msgid "register of the trial functions"
msgstr "ທະບຽນຟັງຊັນທົດລອງ"

#: src/optima_air/cli.py
#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "ການຂຽນໃສ່ຊ່ອງ {slot} ຍັງບໍ່ສຳເລັດ ຈະບໍ່ແຕະຕ້ອງເພດັລໄລຍະໜຶ່ງ ຈາກນັ້ນໃຫ້ແລ່ນຄຳສັ່ງ: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "ຂໍ້ຜິດພາດ: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "ຖືກຂັດຂວາງ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "ໄບຕ໌ {byte} ຢູ່ນອກ 7 ບິດ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "ໄບຕ໌ 7 ບິດຈຳນວນ {count} ໄບຕ໌ເຮັດໃຫ້ເຫຼືອບິດເຕີມ {bits} ບິດ enc7 ບໍ່ເຄີຍສ້າງເກີນ 6"

#: src/optima_air/codec.py
msgid "non-zero padding bits at the end of a 7-bit stream"
msgstr "ພົບບິດເຕີມທີ່ບໍ່ເປັນສູນຢູ່ທ້າຍສະຕຣີມ 7 ບິດ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "ບລັອກມີຂະໜາດ {expected} ໄບຕ໌ ແຕ່ໄດ້ຮັບ {got}"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "ຜົນລວມຂອງບລັອກ {sum} ({hex}) ເກີນ 14 ບິດທີ່ສົ່ງໄດ້ (ສູງສຸດ {max}): ບໍ່ເຄີຍພົບເທິງເພດັລ ປະຕິເສດຈົນກວ່າຈະກວດສອບແລ້ວ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "ບລັອກທີ່ເຂົ້າລະຫັດມີຂະໜາດ {expected} ໄບຕ໌ ແຕ່ໄດ້ຮັບ {got}"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "ພົບໄບຕ໌ທີ່ຢູ່ນອກ 7 ບິດໃນບລັອກທີ່ເຂົ້າລະຫັດ"

#: src/optima_air/codec.py
msgid "wrong block checksum"
msgstr "ເຊັກຊຳຂອງບລັອກບໍ່ຖືກຕ້ອງ"

#: src/optima_air/codec.py
msgid "the end-of-transfer sum covers at least one block"
msgstr "ຜົນລວມທ້າຍການຖ່າຍໂອນຕ້ອງຄອບຄຸມຢ່າງໜ້ອຍໜຶ່ງບລັອກ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "length {length} not a multiple of {block}"
msgstr "ຄວາມຍາວ {length} ບໍ່ແມ່ນຜົນຄູນຂອງ {block}"

#: src/optima_air/codec.py
#, python-brace-format
msgid "value {value} outside 28 bits"
msgstr "ຄ່າ {value} ຢູ່ນອກ 28 ບິດ"

#: src/optima_air/codec.py
#, python-brace-format
msgid "a 28-bit sum takes 4 bytes, got {got}"
msgstr "ຜົນລວມ 28 ບິດໃຊ້ 4 ໄບຕ໌ ແຕ່ໄດ້ຮັບ {got}"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits in a 28-bit sum"
msgstr "ໄບຕ໌ {byte} ຢູ່ນອກ 7 ບິດໃນຜົນລວມ 28 ບິດ"

#: src/optima_air/device.py
#, python-brace-format
msgid "A write was interrupted: the pedal is left alone for another {seconds} s."
msgstr "ການຂຽນຖືກຂັດຂວາງ: ຈະບໍ່ແຕະຕ້ອງເພດັລອີກ {seconds} ວິນາທີ"

#: src/optima_air/device.py
#, python-brace-format
msgid "“{message}”: a write message can only be sent by a complete slot write (backup, journal, read back)."
