msgid "unreadable slot info: {error}"
msgstr "slot ཆ་འཕྲིན་ཀློག་མི་ཐུབ། {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "the pedal announces slot {slot}"
msgstr "རྐང་མནན་གྱིས་ slot {slot} གསལ་བསྒྲགས་བྱེད་བཞིན་འདུག"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected answer for table {table}: {error}"
msgstr "རེའུ་མིག་ {table} ལ་རེ་བ་མིན་པའི་ལན། {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "table {table}: value {value} above 100"
msgstr "རེའུ་མིག་ {table}: གྲངས་ {value} ནི་ 100 ལས་མང་།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unexpected state answer: {error}"
msgstr "རེ་བ་མིན་པའི་གནས་སྟངས་ཀྱི་ལན། {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "read header: command {found} instead of {expected}"
msgstr "ཀློག་པའི་མགོ། བཀའ་ཕབ་ {expected} ལས་ {found} ཡིན།"

#: src/optima_air/messages_reception.py
msgid "read header carries the end flag"
msgstr "ཀློག་པའི་མགོ་ལ་མཇུག་གི་དར་རྟགས་ཡོད།"

#: src/optima_air/messages_reception.py
msgid "non-zero read header, never seen in this form"
msgstr "ཀློག་པའི་མགོ་གཤིས་ཀ་མིན། རྣམ་པ་འདི་འདྲ་ནམ་ཡང་མ་མཐོང་།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: command {found} instead of {expected}"
msgstr "ཚན་ཆ་ {block}: བཀའ་ཕབ་ {expected} ལས་ {found} ཡིན།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: non-zero flag {flag}"
msgstr "ཚན་ཆ་ {block}: དར་རྟགས་ {flag} གཤིས་ཀ་མིན།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: address {found} instead of {expected}"
msgstr "ཚན་ཆ་ {block}: ཁ་བྱང་ {expected} ལས་ {found} ཡིན།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block}: counter {found} instead of {expected}"
msgstr "ཚན་ཆ་ {block}: གྲངས་འཛིན་ {expected} ལས་ {found} ཡིན།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "block {block} unreadable: {error}"
msgstr "ཚན་ཆ་ {block} ཀློག་མི་ཐུབ། {error}"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: command {found} instead of {expected}"
msgstr "མཇུག་གི་ཚན་ཆ། བཀའ་ཕབ་ {expected} ལས་ {found} ཡིན།"

#: src/optima_air/messages_reception.py
msgid "end block without flag"
msgstr "དར་རྟགས་མེད་པའི་མཇུག་གི་ཚན་ཆ།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "end block: counter {found} instead of {expected}"
msgstr "མཇུག་གི་ཚན་ཆ། གྲངས་འཛིན་ {expected} ལས་ {found} ཡིན།"

#: src/optima_air/messages_reception.py
msgid "end block: stray byte outside the flag, the sum and the counter"
msgstr "མཇུག་གི་ཚན་ཆ། དར་རྟགས་དང་སྤྱིའི་ཁྱོན། གྲངས་འཛིན་མ་གཏོགས་པའི་ byte ལྷག་མ་ཡོད།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "unreadable end sum: {error}"
msgstr "མཇུག་གི་སྤྱིའི་ཁྱོན་ཀློག་མི་ཐུབ། {error}"

#: src/optima_air/messages_reception.py
msgid "wrong end-of-read sum"
msgstr "ཀློག་པ་མཇུག་འགྲིལ་གྱི་སྤྱིའི་ཁྱོན་ནོར་བ།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "footer: command {found} instead of {expected}"
msgstr "མཇུག་ཐོ། བཀའ་ཕབ་ {expected} ལས་ {found} ཡིན།"

#: src/optima_air/messages_reception.py
msgid "footer without flag"
msgstr "དར་རྟགས་མེད་པའི་མཇུག་ཐོ།"

#: src/optima_air/messages_reception.py
msgid "footer: stray byte after the flag"
msgstr "མཇུག་ཐོ། དར་རྟགས་ཀྱི་རྗེས་ལ་ byte ལྷག་མ་ཡོད།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "{count} messages received instead of {expected}"
msgstr "ཆ་འཕྲིན་ {expected} ལས་ {count} ཐོབ་སོང་།"

#: src/optima_air/messages_reception.py
#, python-brace-format
msgid "message {number} foreign to an IR read: {error}"
msgstr "ཆ་འཕྲིན་ {number} ནི་ IR ཀློག་པ་དང་འབྲེལ་བ་མེད། {error}"

#: src/optima_air/preferences.py
msgid "colour {colour!r}: lowercase “#rrggbb” expected"
msgstr "ཚོན་ {colour!r}: ཡིག་ཆུང་གི་ “#rrggbb” དགོས།"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unknown function “{name}”. Known: {known}."
msgstr "ནུས་པ་ “{name}” མ་ཤེས་པ། ཤེས་པ་རྣམས། {known}།"

#: src/optima_air/registre.py
msgid "sorted list of known functions, without duplicates, expected"
msgstr "བསྐྱར་ཟློས་མེད་པའི་ཤེས་པའི་ནུས་པའི་ཐོ་གཞུང་རིམ་སྒྲིག་བྱས་པ་དགོས།"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Unreadable trial register: {file} ({error})"
msgstr "ཚོད་ལྟའི་དེབ་ཐོ་ཀློག་མི་ཐུབ། {file} ({error})"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Trial register locked by another process ({file}): try again once the other command has finished."
msgstr "ཚོད་ལྟའི་དེབ་ཐོ་ལ་ལས་རིམ་གཞན་གྱིས་ཟྭ་བརྒྱབ་ཡོད། ({file}) བཀའ་ཕབ་གཞན་མཇུག་འགྲིལ་རྗེས་ཡང་བསྐྱར་ཚོད་ལྟ་བྱོས།"

#: src/optima_air/registre.py
#, python-brace-format
msgid "Cannot lock {file}: {error}"
msgstr "{file} ལ་ཟྭ་བརྒྱབ་མི་ཐུབ། {error}"

#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "རྐང་མནན་མ་རྙེད། སྒྲ་ཁྱབ་བྱང་བུ་ “NAI5” མེད། USB ཐག་པ་ཞིབ་བཤེར་བྱོས།"

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR མ་བཀོད་པས་ཟྭ་ལེན་མི་ཐུབ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "ཟྭ་ {file} ལེན་མི་ཐུབ། {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "optima-air ཡི་རིགས་གཞན་གྱིས་རྐང་མནན་བེད་སྤྱོད་བྱེད་ཟིན།"

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "ཟྭ་འདི་གློད་ཟིན། port ལ་སྤྲོད་མི་ཐུབ་པར་གྱུར།"

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "ཟྭ་འདི་ port གཅིག་གི་ཡིན་ཟིན། གཉིས་པ་ལ་སྤྲོད་མི་ཐུབ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "ཟྭ་གློད་མི་ཐུབ། {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "རྐང་མནན་གྱིས་ལན་མི་འདེབས་པར་གྱུར། ཐག་པ་བཏོན་ཡོད་པའམ་འགགས་ཡོད།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "port {port} སྒྲིག་འགོད་བྱེད་མི་ཐུབ། {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "port {port} ཡི་ནང་འཇུག་གྲ་སྒྲིག་བྱེད་མི་ཐུབ། {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "port {port} མི་འདུག"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port} ལ་འཛུལ་སྤྱོད་ཁས་མ་བླངས། “audio” ཚོགས་ཆུང་ནང་ཡོད་མེད་ཞིབ་བཤེར་བྱོས། (བཀའ་ཕབ། id)"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "port {port} ནི་གོ་རིམ་གཞན་གྱིས་བེད་སྤྱོད་བྱེད་ཟིན།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "port {port} ད་ནས་བེད་སྤྱོད་བྱེད་མི་ཐུབ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "port {port} ཁ་ཕྱེ་མི་ཐུབ། {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "འབྲི་མི་ཐུབ། port སྒོ་བརྒྱབ་ཡོད།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "port {port} ལ་འབྲི་བ་ཕམ་སོང་། byte གང་ཡང་མ་བླངས།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "port {port} ལ་འབྲི་བ་ཕམ་སོང་། {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "port {port} སྣོད་སྟོང་བྱེད་པ་ཐེངས་ {count} རྒྱུན་མཐུད་དུ་བར་ཆད་ཆགས་སོང་། ཆ་འཕྲིན་ kernel ལ་སྤྲད་ཟིན་ཀྱང་དེ་འགྲོ་བར་སྒུག་མི་ཐུབ།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "སྒུག་ཚད་ཁྱབ་ཁོངས་ལས་ཐལ་འདས། {wait} སྐར་ཆ། (མང་ཤོས་ {max} སྐར་ཆ།)"

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "ཀློག་མི་ཐུབ། port སྒོ་བརྒྱབ་ཡོད།"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "port {port} ནས་ཀློག་པ་ཕམ་སོང་། {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "port {port} གིས་ནང་འཇུག་གི་གནས་སྟངས་མི་སྟོན། ({error}) byte བརླགས་པ་ཟིན་བྲིས་བྱེད་མི་ཐུབ་པས་འདིར་མཚམས་འཇོག"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "port {port} གི་གནས་སྟངས་ཀློག་པ་ཕམ་སོང་། {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "port {port} སྒོ་རྒྱོབ་པ་ཕམ་སོང་། {error}"
