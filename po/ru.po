#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "Эта блокировка уже принадлежит порту: её нельзя передать второму."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "Не удаётся снять блокировку: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "Педаль больше не отвечает: отключена или зависла."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "Не удаётся настроить порт {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "Не удаётся активировать вход порта {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "Порт {port} не существует."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "Доступ к {port} запрещён. Проверьте, что вы входите в группу «audio» (команда: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Порт {port} уже используется другой программой."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Порт {port} больше не доступен."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Не удаётся открыть порт {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Запись невозможна: порт закрыт."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Не удалось записать в порт {port}: ни один байт не принят."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Не удалось записать в порт {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Опорожнение порта {port} было прервано {count} раз подряд: сообщение передано ядру, но дождаться его отправки не удалось."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Ожидание вне допустимых пределов: {wait} с (не более {max} с)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Чтение невозможно: порт закрыт."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Не удалось прочитать из порта {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Порт {port} не сообщает состояние своего входа ({error}): потерю байтов обнаружить невозможно, остановка."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Не удалось прочитать состояние порта {port}: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Не удалось закрыть порт {port}: {error}"
