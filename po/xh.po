#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "Iphothi {port} sele isetyenziswa yenye inkqubo."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "Iphothi {port} ayisafumaneki."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "Ayikwazi ukuvula iphothi {port}: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "Ayikwazi ukubhala: iphothi ivaliwe."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "Ukubhala kwiphothi {port} akuphumelelanga: akukho byte yamkelweyo."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "Ukubhala kwiphothi {port} akuphumelelanga: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "Ukuthulula iphothi {port} kuphazanyisiwe amaxesha angama-{count} ilandelelana: umyalezo unikwe i-kernel, kodwa ukumka kwawo akunakulindwa."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "Ukulinda kuphandle koluhlu: {wait} s (ubuninzi be-{max} s)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "Ayikwazi ukufunda: iphothi ivaliwe."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "Ukufunda kwiphothi {port} akuphumelelanga: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "Iphothi {port} ayixeli imeko yokungena kwayo ({error}): ukulahleka kwee-byte akunakubonwa, kuyema apha."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "Ukufunda imeko yephothi {port} akuphumelelanga: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "Ukuvala iphothi {port} akuphumelelanga: {error}"
