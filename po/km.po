#: src/optima_air/codec.py
#, python-brace-format
msgid "a block is {expected} bytes, got {got}"
msgstr "ប្លុកមាន {expected} បៃ ប៉ុន្តែទទួលបាន {got}"

#: src/optima_air/codec.py
#, python-brace-format
msgid "block sum {sum} ({hex}) beyond the 14 transmitted bits (max {max}): never seen on the pedal, refused until verified"
msgstr "ផលបូកប្លុក {sum} ({hex}) លើសពី 14 ប៊ីតដែលបានបញ្ជូន (អតិបរមា {max}): មិនដែលឃើញលើផេដាល់ ត្រូវបានបដិសេធរហូតដល់ផ្ទៀងផ្ទាត់"

#: src/optima_air/codec.py
#, python-brace-format
msgid "an encoded block is {expected} bytes, got {got}"
msgstr "ប្លុកដែលបានអ៊ិនកូដមាន {expected} បៃ ប៉ុន្តែទទួលបាន {got}"

#: src/optima_air/codec.py
msgid "byte outside 7 bits in an encoded block"
msgstr "បៃនៅក្រៅ 7 ប៊ីតក្នុងប្លុកដែលបានអ៊ិនកូដ"

