#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "ລັອກນີ້ເປັນຂອງພອດໜຶ່ງຢູ່ແລ້ວ: ບໍ່ສາມາດມອບໃຫ້ພອດທີສອງໄດ້"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "ປົດລັອກບໍ່ໄດ້: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "ເພດັລບໍ່ຕອບສະໜອງອີກຕໍ່ໄປ: ຖືກຖອດສາຍ ຫຼື ຄ້າງ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "ກຳນົດຄ່າພອດ {port} ບໍ່ໄດ້: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "ກະກຽມອິນພຸດຂອງພອດ {port} ບໍ່ໄດ້: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "ບໍ່ມີພອດ {port}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "ບໍ່ມີສິດເຂົ້າເຖິງ {port} ກວດສອບວ່າທ່ານຢູ່ໃນກຸ່ມ “audio” (ຄຳສັ່ງ: id)"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "ພອດ {port} ຖືກໂປຣແກຣມອື່ນໃຊ້ງານຢູ່ແລ້ວ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "ພອດ {port} ບໍ່ພ້ອມໃຊ້ງານອີກຕໍ່ໄປ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "ເປີດພອດ {port} ບໍ່ໄດ້: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "ຂຽນບໍ່ໄດ້: ພອດຖືກປິດຢູ່"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "ການຂຽນໄປຍັງພອດ {port} ລົ້ມເຫຼວ: ບໍ່ມີໄບຕ໌ໃດຖືກຮັບ"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "ການຂຽນໄປຍັງພອດ {port} ລົ້ມເຫຼວ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "ການລະບາຍພອດ {port} ຖືກຂັດຂວາງຕິດຕໍ່ກັນ {count} ເທື່ອ: ຂໍ້ຄວາມຖືກສົ່ງໃຫ້ເຄີເນລແລ້ວ ແຕ່ລໍໃຫ້ສົ່ງອອກໄປຈິງບໍ່ໄດ້"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "ເວລາລໍຖ້າຢູ່ນອກຂອບເຂດ: {wait} ວິນາທີ (ສູງສຸດ {max} ວິນາທີ)"

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "ອ່ານບໍ່ໄດ້: ພອດຖືກປິດຢູ່"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "ການອ່ານຈາກພອດ {port} ລົ້ມເຫຼວ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "ພອດ {port} ບໍ່ລາຍງານສະຖານະຂອງອິນພຸດ ({error}): ກວດຈັບການສູນເສຍໄບຕ໌ບໍ່ໄດ້ ຈຶ່ງຢຸດຢູ່ບ່ອນນີ້"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "ການອ່ານສະຖານະຂອງພອດ {port} ລົ້ມເຫຼວ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "ການປິດພອດ {port} ລົ້ມເຫຼວ: {error}"
