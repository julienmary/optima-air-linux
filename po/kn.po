#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: “{name}” written and read back identical. Previous content backed up in {backup}"
msgstr "ಸ್ಲಾಟ್ {slot}: “{name}” ಬರೆಯಲಾಗಿದೆ ಮತ್ತು ಮತ್ತೆ ಓದಿದಾಗ ಒಂದೇ ಆಗಿದೆ. ಹಿಂದಿನ ವಿಷಯ {backup} ನಲ್ಲಿ ಬ್ಯಾಕಪ್ ಆಗಿದೆ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot}…"
msgstr "ಸ್ಲಾಟ್ {slot} ಅನ್ನು ಬರೆಯುತ್ತಿದೆ…"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Writing slot {slot} failed: {reason} The pedal is left alone for {seconds} s, then the state of the slot will be checked."
msgstr "ಸ್ಲಾಟ್ {slot} ಅನ್ನು ಬರೆಯುವುದು ವಿಫಲವಾಗಿದೆ: {reason} ಪೆಡಲ್ ಅನ್ನು {seconds} ಸೆ ಒಂಟಿಯಾಗಿ ಬಿಡಲಾಗುತ್ತದೆ, ನಂತರ ಸ್ಲಾಟ್‌ನ ಸ್ಥಿತಿಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The backup failed: {reason}"
msgstr "ಬ್ಯಾಕಪ್ ವಿಫಲವಾಗಿದೆ: {reason}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "The restore stopped: {reason} The slots already handled are in order; the state of the pedal will be read again."
msgstr "ಮರುಸ್ಥಾಪನೆ ನಿಂತಿದೆ: {reason} ಈಗಾಗಲೇ ನಿರ್ವಹಿಸಿದ ಸ್ಲಾಟ್‌ಗಳು ಸರಿಯಾಗಿವೆ; ಪೆಡಲ್‌ನ ಸ್ಥಿತಿಯನ್ನು ಮತ್ತೆ ಓದಲಾಗುತ್ತದೆ."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Connected, firmware {version}"
msgstr "ಸಂಪರ್ಕಗೊಂಡಿದೆ, ಫರ್ಮ್‌ವೇರ್ {version}"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Disconnected: {reason}"
msgstr "ಸಂಪರ್ಕ ಕಡಿತಗೊಂಡಿದೆ: {reason}"

#: src/optima_air/gui/fenetre.py
msgid "Warning: the identifier announced by the pedal does not match the data read."
msgstr "ಎಚ್ಚರಿಕೆ: ಪೆಡಲ್ ಘೋಷಿಸಿದ ಗುರುತು ಓದಿದ ಡೇಟಾದೊಂದಿಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ."

#: src/optima_air/gui/travail.py
msgid "Stop requested."
msgstr "ನಿಲ್ಲಿಸಲು ವಿನಂತಿಸಲಾಗಿದೆ."

#: src/optima_air/gui/travail.py
msgid "Backup"
msgstr "ಬ್ಯಾಕಪ್"

#: src/optima_air/ir.py
msgid "invalid frequency range or number of points"
msgstr "ಅಮಾನ್ಯ ಆವರ್ತನ ವ್ಯಾಪ್ತಿ ಅಥವಾ ಬಿಂದುಗಳ ಸಂಖ್ಯೆ"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Unreadable audio file: {file} ({error})"
msgstr "ಓದಲಾಗದ ಆಡಿಯೊ ಫೈಲ್: {file} ({error})"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file has {count} channels: only the first one is kept."
msgstr "ಫೈಲ್‌ನಲ್ಲಿ {count} ಚಾನಲ್‌ಗಳಿವೆ: ಮೊದಲನೆಯದನ್ನು ಮಾತ್ರ ಉಳಿಸಿಕೊಳ್ಳಲಾಗಿದೆ."

#: src/optima_air/ir.py
#, python-brace-format
msgid "Empty audio file: {file}"
msgstr "ಖಾಲಿ ಆಡಿಯೊ ಫೈಲ್: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file contains non-finite samples: {file}"
msgstr "ಫೈಲ್ ಅನಂತವಲ್ಲದ (non-finite) ಮಾದರಿಗಳನ್ನು ಹೊಂದಿದೆ: {file}"

#: src/optima_air/ir.py
#, python-brace-format
msgid "Sample rate of {rate} Hz: the file was resampled to {target} kHz."
msgstr "{rate} Hz ಮಾದರಿ ದರ: ಫೈಲ್ ಅನ್ನು {target} kHz ಗೆ ಮರುಮಾದರಿ ಮಾಡಲಾಗಿದೆ."

#: src/optima_air/ir.py
#, python-brace-format
msgid "The file lasts {duration} ms: only the first {count} samples ({limit} ms) are kept."
msgstr "ಫೈಲ್ {duration} ms ಇದೆ: ಮೊದಲ {count} ಮಾದರಿಗಳನ್ನು ({limit} ms) ಮಾತ್ರ ಉಳಿಸಿಕೊಳ್ಳಲಾಗಿದೆ."

#: src/optima_air/ir.py
#, python-brace-format
msgid "The pedal only plays the first {count} samples ({limit} ms): the rest of this IR will be stored but not heard."
msgstr "ಪೆಡಲ್ ಮೊದಲ {count} ಮಾದರಿಗಳನ್ನು ({limit} ms) ಮಾತ್ರ ಪ್ಲೇ ಮಾಡುತ್ತದೆ: ಈ IR ನ ಉಳಿದ ಭಾಗವನ್ನು ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ ಆದರೆ ಕೇಳಿಸುವುದಿಲ್ಲ."

#: src/optima_air/ir.py
#, python-brace-format
msgid "Cannot normalise {file}: no signal between 400 Hz and 3 kHz."
msgstr "{file} ಅನ್ನು ನಾರ್ಮಲೈಸ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: 400 Hz ಮತ್ತು 3 kHz ನಡುವೆ ಸಿಗ್ನಲ್ ಇಲ್ಲ."

#: src/optima_air/ir.py
#, python-brace-format
msgid "Normalising {file} exceeds the range of floating-point numbers."
msgstr "{file} ಅನ್ನು ನಾರ್ಮಲೈಸ್ ಮಾಡುವುದು ಫ್ಲೋಟಿಂಗ್-ಪಾಯಿಂಟ್ ಸಂಖ್ಯೆಗಳ ವ್ಯಾಪ್ತಿಯನ್ನು ಮೀರುತ್ತದೆ."

#: src/optima_air/ir.py
#, python-brace-format
msgid "After normalisation, the IR peaks at {peak} (usual IRs stay below 10): the file has a very deep dip between 400 Hz and 3 kHz, and the output level may be very high."
msgstr "ನಾರ್ಮಲೈಸೇಶನ್ ನಂತರ, IR ಗರಿಷ್ಠ {peak} ಆಗಿದೆ (ಸಾಮಾನ್ಯ IR ಗಳು 10 ಕ್ಕಿಂತ ಕೆಳಗಿರುತ್ತವೆ): ಫೈಲ್‌ನಲ್ಲಿ 400 Hz ಮತ್ತು 3 kHz ನಡುವೆ ಬಹಳ ಆಳವಾದ ತಗ್ಗು ಇದೆ, ಔಟ್‌ಪುಟ್ ಮಟ್ಟ ಬಹಳ ಹೆಚ್ಚಿರಬಹುದು."

#: src/optima_air/journal.py
msgid "a journal date must carry a time zone"
msgstr "ಜರ್ನಲ್ ದಿನಾಂಕ ಸಮಯ ವಲಯವನ್ನು ಹೊಂದಿರಬೇಕು"

#: src/optima_air/journal.py
