#, python-brace-format
msgid "A write to slot {slot} was left unfinished. The pedal is left alone for a while; then run: optima-air resume"
msgstr "ការសរសេរទៅទីតាំង {slot} មិនទាន់បានបញ្ចប់ នឹងមិនប៉ះពាល់ផេដាល់មួយរយៈ បន្ទាប់មកសូមដំណើរការពាក្យបញ្ជា: optima-air resume"

#: src/optima_air/cli.py
#, python-brace-format
msgid "Error: {error}"
msgstr "កំហុស: {error}"

#: src/optima_air/cli.py
msgid "Interrupted."
msgstr "ត្រូវបានរំខាន"

#: src/optima_air/codec.py
#, python-brace-format
msgid "byte {byte} outside 7 bits"
msgstr "បៃ {byte} នៅក្រៅ 7 ប៊ីត"

#: src/optima_air/codec.py
#, python-brace-format
msgid "{count} 7-bit bytes leave {bits} padding bits, enc7 never produces more than 6"
msgstr "បៃ 7 ប៊ីតចំនួន {count} ទុកប៊ីតបំពេញ {bits} ប៊ីត enc7 មិនដែលបង្កើតលើសពី 6 ទេ"

