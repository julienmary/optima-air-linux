#: src/optima_air/transport.py
msgid "Pedal not found: no “NAI5” sound card. Check the USB cable."
msgstr "ಪೆಡಲ್ ಕಂಡುಬಂದಿಲ್ಲ: “NAI5” ಸೌಂಡ್ ಕಾರ್ಡ್ ಇಲ್ಲ. USB ಕೇಬಲ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/optima_air/transport.py
msgid "XDG_RUNTIME_DIR is not set: cannot take the lock."
msgstr "XDG_RUNTIME_DIR ಹೊಂದಿಸಿಲ್ಲ: ಲಾಕ್ ತೆಗೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot take the lock {file}: {error}"
msgstr "ಲಾಕ್ {file} ಅನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ: {error}"

#: src/optima_air/transport.py
msgid "The pedal is already used by another instance of optima-air."
msgstr "ಪೆಡಲ್ ಅನ್ನು optima-air ನ ಮತ್ತೊಂದು ಇನ್‌ಸ್ಟೆನ್ಸ್ ಈಗಾಗಲೇ ಬಳಸುತ್ತಿದೆ."

#: src/optima_air/transport.py
msgid "The lock has already been released: it can no longer be given to a port."
msgstr "ಲಾಕ್ ಅನ್ನು ಈಗಾಗಲೇ ಬಿಡುಗಡೆ ಮಾಡಲಾಗಿದೆ: ಅದನ್ನು ಇನ್ನು ಪೋರ್ಟ್‌ಗೆ ನೀಡಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: src/optima_air/transport.py
msgid "This lock already belongs to a port: it cannot be given to a second one."
msgstr "ಈ ಲಾಕ್ ಈಗಾಗಲೇ ಒಂದು ಪೋರ್ಟ್‌ಗೆ ಸೇರಿದೆ: ಅದನ್ನು ಎರಡನೆಯದಕ್ಕೆ ನೀಡಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot release the lock: {error}"
msgstr "ಲಾಕ್ ಅನ್ನು ಬಿಡುಗಡೆ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: {error}"

#: src/optima_air/transport.py
msgid "The pedal no longer answers: unplugged or stuck."
msgstr "ಪೆಡಲ್ ಇನ್ನು ಉತ್ತರಿಸುತ್ತಿಲ್ಲ: ಪ್ಲಗ್ ತೆಗೆಯಲಾಗಿದೆ ಅಥವಾ ಸ್ಥಗಿತಗೊಂಡಿದೆ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot configure the port {port}: {error}"
msgstr "ಪೋರ್ಟ್ {port} ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot arm the input of port {port}: {error}"
msgstr "ಪೋರ್ಟ್ {port} ನ ಇನ್‌ಪುಟ್ ಅನ್ನು ಸಜ್ಜುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not exist."
msgstr "ಪೋರ್ಟ್ {port} ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Access denied to {port}. Check that you are in the “audio” group (command: id)."
msgstr "{port} ಗೆ ಪ್ರವೇಶ ನಿರಾಕರಿಸಲಾಗಿದೆ. ನೀವು “audio” ಗುಂಪಿನಲ್ಲಿದ್ದೀರಾ ಎಂದು ಪರಿಶೀಲಿಸಿ (ಆಜ್ಞೆ: id)."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is already used by another program."
msgstr "ಪೋರ್ಟ್ {port} ಅನ್ನು ಈಗಾಗಲೇ ಮತ್ತೊಂದು ಪ್ರೋಗ್ರಾಂ ಬಳಸುತ್ತಿದೆ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} is no longer available."
msgstr "ಪೋರ್ಟ್ {port} ಇನ್ನು ಲಭ್ಯವಿಲ್ಲ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Cannot open the port {port}: {error}"
msgstr "ಪೋರ್ಟ್ {port} ಅನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ: {error}"

#: src/optima_air/transport.py
msgid "Cannot write: the port is closed."
msgstr "ಬರೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ: ಪೋರ್ಟ್ ಮುಚ್ಚಲಾಗಿದೆ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: no byte accepted."
msgstr "ಪೋರ್ಟ್ {port} ಗೆ ಬರೆಯುವುದು ವಿಫಲವಾಗಿದೆ: ಯಾವುದೇ ಬೈಟ್ ಸ್ವೀಕರಿಸಲಿಲ್ಲ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Writing to port {port} failed: {error}"
msgstr "ಪೋರ್ಟ್ {port} ಗೆ ಬರೆಯುವುದು ವಿಫಲವಾಗಿದೆ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Draining the port {port} was interrupted {count} times in a row: the message is handed to the kernel, but its departure could not be awaited."
msgstr "ಪೋರ್ಟ್ {port} ಅನ್ನು ಡ್ರೈನ್ ಮಾಡುವುದು ಸತತವಾಗಿ {count} ಬಾರಿ ಅಡ್ಡಿಪಡಿಸಲ್ಪಟ್ಟಿದೆ: ಸಂದೇಶವನ್ನು ಕರ್ನಲ್‌ಗೆ ಒಪ್ಪಿಸಲಾಗಿದೆ, ಆದರೆ ಅದರ ನಿರ್ಗಮನಕ್ಕಾಗಿ ಕಾಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Wait out of range: {wait} s (at most {max} s)."
msgstr "ಕಾಯುವ ಸಮಯ ವ್ಯಾಪ್ತಿಯ ಹೊರಗಿದೆ: {wait} ಸೆ (ಗರಿಷ್ಠ {max} ಸೆ)."

#: src/optima_air/transport.py
msgid "Cannot read: the port is closed."
msgstr "ಓದಲು ಸಾಧ್ಯವಿಲ್ಲ: ಪೋರ್ಟ್ ಮುಚ್ಚಲಾಗಿದೆ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading from port {port} failed: {error}"
msgstr "ಪೋರ್ಟ್ {port} ನಿಂದ ಓದುವುದು ವಿಫಲವಾಗಿದೆ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "The port {port} does not report the state of its input ({error}): byte loss cannot be detected, stopping here."
msgstr "ಪೋರ್ಟ್ {port} ತನ್ನ ಇನ್‌ಪುಟ್‌ನ ಸ್ಥಿತಿಯನ್ನು ವರದಿ ಮಾಡುತ್ತಿಲ್ಲ ({error}): ಬೈಟ್ ನಷ್ಟವನ್ನು ಪತ್ತೆಹಚ್ಚಲು ಸಾಧ್ಯವಿಲ್ಲ, ಇಲ್ಲಿ ನಿಲ್ಲಿಸಲಾಗುತ್ತಿದೆ."

#: src/optima_air/transport.py
#, python-brace-format
msgid "Reading the state of port {port} failed: {error}"
msgstr "ಪೋರ್ಟ್ {port} ನ ಸ್ಥಿತಿಯನ್ನು ಓದುವುದು ವಿಫಲವಾಗಿದೆ: {error}"

#: src/optima_air/transport.py
#, python-brace-format
msgid "Closing the port {port} failed: {error}"
msgstr "ಪೋರ್ಟ್ {port} ಅನ್ನು ಮುಚ್ಚುವುದು ವಿಫಲವಾಗಿದೆ: {error}"
