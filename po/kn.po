msgstr "WAV ಆಗಿ ರಫ್ತು ಮಾಡಿ"

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Restore finished. Slots rewritten and read back identical: {rewritten}. Settings only: {settings}. Already identical to the backup: {unchanged}."
msgstr "ಮರುಸ್ಥಾಪನೆ ಪೂರ್ಣಗೊಂಡಿದೆ. ಮತ್ತೆ ಬರೆಯಲಾಗಿ, ಮತ್ತೆ ಓದಿದಾಗ ಒಂದೇ ಆಗಿರುವ ಸ್ಲಾಟ್‌ಗಳು: {rewritten}. ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮಾತ್ರ: {settings}. ಬ್ಯಾಕಪ್‌ನೊಂದಿಗೆ ಈಗಾಗಲೇ ಒಂದೇ ಆಗಿರುವವು: {unchanged}."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it still holds what it held before. Nothing to do."
msgstr "ಸ್ಲಾಟ್ {slot}: ಅಡ್ಡಿಪಡಿಸಲ್ಪಟ್ಟ ಬರವಣಿಗೆಯ ನಂತರ, ಅದು ಈಗಲೂ ಮೊದಲು ಇದ್ದದ್ದನ್ನೇ ಹೊಂದಿದೆ. ಮಾಡಲು ಏನೂ ಇಲ್ಲ."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: after the interrupted write, it holds neither the old nor the new content. Until it is put right, it is the only slot that can be written."
msgstr "ಸ್ಲಾಟ್ {slot}: ಅಡ್ಡಿಪಡಿಸಲ್ಪಟ್ಟ ಬರವಣಿಗೆಯ ನಂತರ, ಅದು ಹಳೆಯ ವಿಷಯವನ್ನೂ ಹೊಸ ವಿಷಯವನ್ನೂ ಹೊಂದಿಲ್ಲ. ಅದನ್ನು ಸರಿಪಡಿಸುವವರೆಗೆ, ಬರೆಯಬಹುದಾದ ಏಕೈಕ ಸ್ಲಾಟ್ ಅದೇ."

#: src/optima_air/gui/fenetre.py
#, python-brace-format
msgid "Slot {slot}: {name}"
